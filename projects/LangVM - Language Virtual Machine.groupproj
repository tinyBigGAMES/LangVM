<Project xmlns="http://schemas.microsoft.com/developer/msbuild/2003">
    <PropertyGroup>
        <ProjectGuid>{2874169C-85B0-4B41-A77C-1985D85A1BE0}</ProjectGuid>
    </PropertyGroup>
    <ItemGroup>
        <Projects Include="ZigBuild\LVMZigBuild.dproj">
            <Dependencies/>
        </Projects>
        <Projects Include="LVM\LVM.dproj">
            <Dependencies>ZigBuild\LVMZigBuild.dproj</Dependencies>
        </Projects>
    </ItemGroup>
    <ProjectExtensions>
        <Borland.Personality>Default.Personality.12</Borland.Personality>
        <Borland.ProjectType/>
        <BorlandProject>
            <Default.Personality/>
        </BorlandProject>
    </ProjectExtensions>
    <Target Name="LVMZigBuild">
        <MSBuild Projects="ZigBuild\LVMZigBuild.dproj"/>
    </Target>
    <Target Name="LVMZigBuild:Clean">
        <MSBuild Projects="ZigBuild\LVMZigBuild.dproj" Targets="Clean"/>
    </Target>
    <Target Name="LVMZigBuild:Make">
        <MSBuild Projects="ZigBuild\LVMZigBuild.dproj" Targets="Make"/>
    </Target>
    <Target Name="LVM" DependsOnTargets="LVMZigBuild">
        <MSBuild Projects="LVM\LVM.dproj"/>
    </Target>
    <Target Name="LVM:Clean" DependsOnTargets="LVMZigBuild:Clean">
        <MSBuild Projects="LVM\LVM.dproj" Targets="Clean"/>
    </Target>
    <Target Name="LVM:Make" DependsOnTargets="LVMZigBuild:Make">
        <MSBuild Projects="LVM\LVM.dproj" Targets="Make"/>
    </Target>
    <Target Name="Build">
        <CallTarget Targets="LVMZigBuild;LVM"/>
    </Target>
    <Target Name="Clean">
        <CallTarget Targets="LVMZigBuild:Clean;LVM:Clean"/>
    </Target>
    <Target Name="Make">
        <CallTarget Targets="LVMZigBuild:Make;LVM:Make"/>
    </Target>
    <Import Project="$(BDS)\Bin\CodeGear.Group.Targets" Condition="Exists('$(BDS)\Bin\CodeGear.Group.Targets')"/>
</Project>
