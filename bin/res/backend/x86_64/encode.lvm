 ------------------------------------------------------------------------------
 encode.lvm -- x64 instruction encoding routines

 Layer 1 of the LVM backend. Writes raw x86-64 instruction bytes into
 executable buffers. All routines take (buf, offset, ...) and return
 the new offset after the encoded bytes.
*******************************************************************************/

// -------------------------------------------------------------------------
//  Register constants
// -------------------------------------------------------------------------
const {
  REG_RAX = 0;
  REG_RCX = 1;
  REG_RDX = 2;
  REG_RBX = 3;
  REG_RSP = 4;
  REG_RBP = 5;
  REG_RSI = 6;
  REG_RDI = 7;
  REG_R8  = 8;
  REG_R9  = 9;
  REG_R10 = 10;
  REG_R11 = 11;
  REG_R12 = 12;
  REG_R13 = 13;
  REG_R14 = 14;
  REG_R15 = 15;

  // XMM registers (SSE2, used for float64 ops)
  REG_XMM0 = 0;
  REG_XMM1 = 1;
  REG_XMM2 = 2;
  REG_XMM3 = 3;
  REG_XMM4 = 4;
  REG_XMM5 = 5;
  REG_XMM6 = 6;
  REG_XMM7 = 7;
}

// -------------------------------------------------------------------------
//  Condition codes for emit_jcc_rel32
// -------------------------------------------------------------------------
const {
  CC_JE  = 0x84;
  CC_JNE = 0x85;
  CC_JL  = 0x8C;
  CC_JGE = 0x8D;
  CC_JLE = 0x8E;
  CC_JG  = 0x8F;
}

// -------------------------------------------------------------------------
//  Data movement
// -------------------------------------------------------------------------

// mov r64, imm64 -- load 64-bit immediate into register
routine emit_mov_r64_imm64(buf: any, offset: int, reg: int, value: int) -> int {
  let rex: int = 0x48;
  let regField: any = reg;
  if reg >= 8 {
    rex = 0x49;
    regField = reg - 8;
  }
  bufWriteU8(buf, offset, rex);
  bufWriteU8(buf, offset + 1, bor(0xB8, regField));
  bufWriteU8(buf, offset + 2, band(value, 0xFF));
  bufWriteU8(buf, offset + 3, band(shr(value, 8), 0xFF));
  bufWriteU8(buf, offset + 4, band(shr(value, 16), 0xFF));
  bufWriteU8(buf, offset + 5, band(shr(value, 24), 0xFF));
  bufWriteU8(buf, offset + 6, band(shr(value, 32), 0xFF));
  bufWriteU8(buf, offset + 7, band(shr(value, 40), 0xFF));
  bufWriteU8(buf, offset + 8, band(shr(value, 48), 0xFF));
  bufWriteU8(buf, offset + 9, band(shr(value, 56), 0xFF));
  return offset + 10;
}

// mov r64, r64 -- register to register move (64-bit)
routine emit_mov_r64_r64(buf: any, offset: int, dst: int, src: int) -> int {
  let rex: int = 0x48;
  if src >= 8 {
    rex = bor(rex, 0x04);
  }
  if dst >= 8 {
    rex = bor(rex, 0x01);
  }
  bufWriteU8(buf, offset, rex);
  bufWriteU8(buf, offset + 1, 0x89);
  let srcField: int = band(src, 7);
  let dstField: int = band(dst, 7);
  bufWriteU8(buf, offset + 2, bor(0xC0, bor(shl(srcField, 3), dstField)));
  return offset + 3;
}

// -------------------------------------------------------------------------
//  Arithmetic
// -------------------------------------------------------------------------

// add r64, r64
routine emit_add_r64_r64(buf: any, offset: int, dst: int, src: int) -> int {
  let rex: int = 0x48;
  if src >= 8 { rex = bor(rex, 0x04); }
  if dst >= 8 { rex = bor(rex, 0x01); }
  bufWriteU8(buf, offset, rex);
  bufWriteU8(buf, offset + 1, 0x01);
  bufWriteU8(buf, offset + 2, bor(0xC0, bor(shl(band(src,7), 3), band(dst,7))));
  return offset + 3;
}

// sub r64, r64
routine emit_sub_r64_r64(buf: any, offset: int, dst: int, src: int) -> int {
  let rex: int = 0x48;
  if src >= 8 { rex = bor(rex, 0x04); }
  if dst >= 8 { rex = bor(rex, 0x01); }
  bufWriteU8(buf, offset, rex);
  bufWriteU8(buf, offset + 1, 0x29);
  bufWriteU8(buf, offset + 2, bor(0xC0, bor(shl(band(src,7), 3), band(dst,7))));
  return offset + 3;
}

// -------------------------------------------------------------------------
//  Stack operations
// -------------------------------------------------------------------------

// push r64
routine emit_push_r64(buf: any, offset: int, reg: int) -> int {
  if reg >= 8 {
    bufWriteU8(buf, offset, 0x41);
    bufWriteU8(buf, offset + 1, bor(0x50, reg - 8));
    return offset + 2;
  }
  bufWriteU8(buf, offset, bor(0x50, reg));
  return offset + 1;
}

// pop r64
routine emit_pop_r64(buf: any, offset: int, reg: int) -> int {
  if reg >= 8 {
    bufWriteU8(buf, offset, 0x41);
    bufWriteU8(buf, offset + 1, bor(0x58, reg - 8));
    return offset + 2;
  }
  bufWriteU8(buf, offset, bor(0x58, reg));
  return offset + 1;
}

// sub rsp, imm8
routine emit_sub_rsp_imm8(buf: any, offset: int, value: int) -> int {
  bufWriteU8(buf, offset, 0x48);
  bufWriteU8(buf, offset + 1, 0x83);
  bufWriteU8(buf, offset + 2, 0xEC);
  bufWriteU8(buf, offset + 3, band(value, 0xFF));
  return offset + 4;
}

// add rsp, imm8
routine emit_add_rsp_imm8(buf: any, offset: int, value: int) -> int {
  bufWriteU8(buf, offset, 0x48);
  bufWriteU8(buf, offset + 1, 0x83);
  bufWriteU8(buf, offset + 2, 0xC4);
  bufWriteU8(buf, offset + 3, band(value, 0xFF));
  return offset + 4;
}

// -------------------------------------------------------------------------
//  SUB RSP, imm32 (for large stack frames > 127 bytes)
//  REX.W + 81 /5 id  (48 81 EC imm32)
// -------------------------------------------------------------------------
routine emit_sub_rsp_imm32(buf: any, offset: int, value: int) -> int {
  bufWriteU8(buf, offset, 0x48);
  bufWriteU8(buf, offset + 1, 0x81);
  bufWriteU8(buf, offset + 2, 0xEC);
  bufWriteU32(buf, offset + 3, band(value, 0xFFFFFFFF));
  return offset + 7;
}

// -------------------------------------------------------------------------
//  ADD RSP, imm32 (for large stack frame teardown)
//  REX.W + 81 /0 id  (48 81 C4 imm32)
// -------------------------------------------------------------------------
routine emit_add_rsp_imm32(buf: any, offset: int, value: int) -> int {
  bufWriteU8(buf, offset, 0x48);
  bufWriteU8(buf, offset + 1, 0x81);
  bufWriteU8(buf, offset + 2, 0xC4);
  bufWriteU32(buf, offset + 3, band(value, 0xFFFFFFFF));
  return offset + 7;
}

// -------------------------------------------------------------------------
//  Control flow
// -------------------------------------------------------------------------

// ret
routine emit_ret(buf: any, offset: int) -> int {
  bufWriteU8(buf, offset, 0xC3);
  return offset + 1;
}

// -------------------------------------------------------------------------
//  LEA r64, [RIP+disp32]
//  Encoding: REX.W 8D /0 disp32   (7 bytes)
//  REX: 0x48 base, +0x04 if reg >= 8
//  ModRM: 0x05 | (reg_field << 3)  -- mod=00, rm=101 (RIP-relative)
//  disp32 is a placeholder (0) -- patched by image writer
//  Returns new offset (offset + 7)
// -------------------------------------------------------------------------
routine emit_lea_rip(buf: any, offset: int, reg: int, disp32: int) -> int {
  let rex: int = 0x48;
  let reg_field: any = reg;
  if reg >= 8 {
    rex = bor(rex, 0x04);
    reg_field = reg - 8;
  }
  bufWriteU8(buf, offset, rex);
  bufWriteU8(buf, offset + 1, 0x8D);
  bufWriteU8(buf, offset + 2, bor(0x05, shl(reg_field, 3)));
  bufWriteU32(buf, offset + 3, band(disp32, 0xFFFFFFFF));
  return offset + 7;
}

// -------------------------------------------------------------------------
//  XOR r32, r32 (zero a register)
//  Encoding: [REX] 31 ModRM  (2-3 bytes)
//  For regs 0-7: no REX needed, 2 bytes
//  For regs 8-15: REX prefix, 3 bytes
// -------------------------------------------------------------------------
routine emit_xor_r32_r32(buf: any, offset: int, dst: int, src: int) -> int {
  if dst >= 8 or src >= 8 {
    let rex: int = 0x40;
    if src >= 8 { rex = bor(rex, 0x04); }
    if dst >= 8 { rex = bor(rex, 0x01); }
    bufWriteU8(buf, offset, rex);
    bufWriteU8(buf, offset + 1, 0x31);
    bufWriteU8(buf, offset + 2, bor(0xC0, bor(shl(band(src,7), 3), band(dst,7))));
    return offset + 3;
  }
  bufWriteU8(buf, offset, 0x31);
  bufWriteU8(buf, offset + 1, bor(0xC0, bor(shl(src, 3), dst)));
  return offset + 2;
}

// -------------------------------------------------------------------------
//  CALL rel32 (direct call, 5 bytes)
//  E8 disp32
// -------------------------------------------------------------------------
routine emit_call_rel32(buf: any, offset: int, disp32: int) -> int {
  bufWriteU8(buf, offset, 0xE8);
  bufWriteU32(buf, offset + 1, band(disp32, 0xFFFFFFFF));
  return offset + 5;
}

// -------------------------------------------------------------------------
//  JMP rel32 (unconditional jump, 5 bytes)
//  E9 disp32
// -------------------------------------------------------------------------
routine emit_jmp_rel32(buf: any, offset: int, disp32: int) -> int {
  bufWriteU8(buf, offset, 0xE9);
  bufWriteU32(buf, offset + 1, band(disp32, 0xFFFFFFFF));
  return offset + 5;
}

// -------------------------------------------------------------------------
//  JMP rel8 (short jump, 2 bytes)
//  EB disp8
// -------------------------------------------------------------------------
routine emit_jmp_rel8(buf: any, offset: int, disp8: int) -> int {
  bufWriteU8(buf, offset, 0xEB);
  bufWriteU8(buf, offset + 1, band(disp8, 0xFF));
  return offset + 2;
}

// -------------------------------------------------------------------------
//  Jcc rel32 (conditional jump, 6 bytes)
//  0F 8x disp32
//  cc_opcode: 0x84=JE, 0x85=JNE, 0x8C=JL, 0x8D=JGE, 0x8E=JLE, 0x8F=JG
// -------------------------------------------------------------------------
routine emit_jcc_rel32(buf: any, offset: int, cc_opcode: int, disp32: int) -> int {
  bufWriteU8(buf, offset, 0x0F);
  bufWriteU8(buf, offset + 1, cc_opcode);
  bufWriteU32(buf, offset + 2, band(disp32, 0xFFFFFFFF));
  return offset + 6;
}

// -------------------------------------------------------------------------
//  CMP r64, r64 (compare registers, 3 bytes)
//  REX.W 39 ModRM
// -------------------------------------------------------------------------
routine emit_cmp_r64_r64(buf: any, offset: int, r1: int, r2: int) -> int {
  let rex: int = 0x48;
  if r2 >= 8 { rex = bor(rex, 0x04); }
  if r1 >= 8 { rex = bor(rex, 0x01); }
  bufWriteU8(buf, offset, rex);
  bufWriteU8(buf, offset + 1, 0x39);
  bufWriteU8(buf, offset + 2, bor(0xC0, bor(shl(band(r2, 7), 3), band(r1, 7))));
  return offset + 3;
}

// -------------------------------------------------------------------------
//  CMP RAX, imm32 (compare RAX with immediate, 6 bytes)
//  REX.W 3D imm32
// -------------------------------------------------------------------------
routine emit_cmp_rax_imm32(buf: any, offset: int, imm32: int) -> int {
  bufWriteU8(buf, offset, 0x48);
  bufWriteU8(buf, offset + 1, 0x3D);
  bufWriteU32(buf, offset + 2, band(imm32, 0xFFFFFFFF));
  return offset + 6;
}

// -------------------------------------------------------------------------
//  TEST r64, r64 (bitwise AND, set FLAGS, 3 bytes)
//  REX.W 85 ModRM
// -------------------------------------------------------------------------
routine emit_test_r64_r64(buf: any, offset: int, r1: int, r2: int) -> int {
  let rex: int = 0x48;
  if r2 >= 8 { rex = bor(rex, 0x04); }
  if r1 >= 8 { rex = bor(rex, 0x01); }
  bufWriteU8(buf, offset, rex);
  bufWriteU8(buf, offset + 1, 0x85);
  bufWriteU8(buf, offset + 2, bor(0xC0, bor(shl(band(r2, 7), 3), band(r1, 7))));
  return offset + 3;
}


// -------------------------------------------------------------------------
//  MOV r64, [RIP+disp32] (load from RIP-relative address, 7 bytes)
//  REX.W 8B ModRM disp32
//  ModRM: mod=00, rm=101 (RIP-relative), reg=target
// -------------------------------------------------------------------------
routine emit_mov_r64_rip(buf: any, offset: int, reg: int, disp32: int) -> int {
  let rex: int = 0x48;
  let reg_field: any = reg;
  if reg >= 8 {
    rex = bor(rex, 0x04);
    reg_field = reg - 8;
  }
  bufWriteU8(buf, offset, rex);
  bufWriteU8(buf, offset + 1, 0x8B);
  bufWriteU8(buf, offset + 2, bor(0x05, shl(reg_field, 3)));
  bufWriteU32(buf, offset + 3, band(disp32, 0xFFFFFFFF));
  return offset + 7;
}

// -------------------------------------------------------------------------
//  MOV [RIP+disp32], r64 (store to RIP-relative address, 7 bytes)
//  REX.W 89 ModRM disp32
//  ModRM: mod=00, rm=101 (RIP-relative), reg=source
// -------------------------------------------------------------------------
routine emit_mov_rip_r64(buf: any, offset: int, reg: int, disp32: int) -> int {
  let rex: int = 0x48;
  let reg_field: any = reg;
  if reg >= 8 {
    rex = bor(rex, 0x04);
    reg_field = reg - 8;
  }
  bufWriteU8(buf, offset, rex);
  bufWriteU8(buf, offset + 1, 0x89);
  bufWriteU8(buf, offset + 2, bor(0x05, shl(reg_field, 3)));
  bufWriteU32(buf, offset + 3, band(disp32, 0xFFFFFFFF));
  return offset + 7;
}

// -------------------------------------------------------------------------
//  MOV r64, [r64+disp32] (load from base+displacement, 7 bytes)
//  REX.W 8B ModRM disp32
//  ModRM: mod=10 (disp32), rm=base, reg=dest
//  Special: base=RSP(4) needs SIB byte 0x24
//           base=R12(12) needs SIB byte 0x24 + REX.B
// -------------------------------------------------------------------------
routine emit_mov_r64_base_disp(buf: any, offset: int, dst: int, base: int, disp32: int) -> int {
  let rex: int = 0x48;
  if dst >= 8 { rex = bor(rex, 0x04); }
  if base >= 8 { rex = bor(rex, 0x01); }
  bufWriteU8(buf, offset, rex);
  bufWriteU8(buf, offset + 1, 0x8B);
  let base_field: int = band(base, 7);
  let dst_field: int = band(dst, 7);
  bufWriteU8(buf, offset + 2, bor(0x80, bor(shl(dst_field, 3), base_field)));
  // RSP/R12 as base needs SIB
  if base_field == 4 {
    bufWriteU8(buf, offset + 3, 0x24);
    bufWriteU32(buf, offset + 4, band(disp32, 0xFFFFFFFF));
    return offset + 8;
  }
  bufWriteU32(buf, offset + 3, band(disp32, 0xFFFFFFFF));
  return offset + 7;
}

// -------------------------------------------------------------------------
//  MOV [r64+disp32], r64 (store to base+displacement, 7 bytes)
//  REX.W 89 ModRM disp32
//  Same SIB rules as load
// -------------------------------------------------------------------------
routine emit_mov_base_disp_r64(buf: any, offset: int, base: int, disp32: int, src: int) -> int {
  let rex: int = 0x48;
  if src >= 8 { rex = bor(rex, 0x04); }
  if base >= 8 { rex = bor(rex, 0x01); }
  bufWriteU8(buf, offset, rex);
  bufWriteU8(buf, offset + 1, 0x89);
  let base_field: int = band(base, 7);
  let src_field: int = band(src, 7);
  bufWriteU8(buf, offset + 2, bor(0x80, bor(shl(src_field, 3), base_field)));
  if base_field == 4 {
    bufWriteU8(buf, offset + 3, 0x24);
    bufWriteU32(buf, offset + 4, band(disp32, 0xFFFFFFFF));
    return offset + 8;
  }
  bufWriteU32(buf, offset + 3, band(disp32, 0xFFFFFFFF));
  return offset + 7;
}

// -------------------------------------------------------------------------
//  CALL [RIP+disp32] (indirect call through memory, 6 bytes)
//  FF 15 disp32
//  ModRM: mod=00, reg=2 (CALL), rm=101 (RIP+disp32)
//  Used for IAT/GOT import calls
// -------------------------------------------------------------------------
routine emit_call_indirect_rip(buf: any, offset: int, disp32: int) -> int {
  bufWriteU8(buf, offset, 0xFF);
  bufWriteU8(buf, offset + 1, bor(0x05, shl(2, 3)));
  bufWriteU32(buf, offset + 2, band(disp32, 0xFFFFFFFF));
  return offset + 6;
}


// -------------------------------------------------------------------------
//  IMUL r64, r64 (signed multiply, 4 bytes)
//  REX.W 0F AF ModRM
//  ModRM: mod=11, reg=dst, rm=src
// -------------------------------------------------------------------------
routine emit_imul_r64_r64(buf: any, offset: int, dst: int, src: int) -> int {
  let rex: int = 0x48;
  if dst >= 8 { rex = bor(rex, 0x04); }
  if src >= 8 { rex = bor(rex, 0x01); }
  bufWriteU8(buf, offset, rex);
  bufWriteU8(buf, offset + 1, 0x0F);
  bufWriteU8(buf, offset + 2, 0xAF);
  bufWriteU8(buf, offset + 3, bor(0xC0, bor(shl(band(dst, 7), 3), band(src, 7))));
  return offset + 4;
}

// -------------------------------------------------------------------------
//  CQO (sign-extend RAX into RDX:RAX, 2 bytes)
//  REX.W 99
// -------------------------------------------------------------------------
routine emit_cqo(buf: any, offset: int) -> int {
  bufWriteU8(buf, offset, 0x48);
  bufWriteU8(buf, offset + 1, 0x99);
  return offset + 2;
}

// -------------------------------------------------------------------------
//  IDIV r64 (signed divide RDX:RAX by reg, 3 bytes)
//  REX.W F7 ModRM
//  ModRM: mod=11, reg=7 (IDIV), rm=src
// -------------------------------------------------------------------------
routine emit_idiv_r64(buf: any, offset: int, src: int) -> int {
  let rex: int = 0x48;
  if src >= 8 { rex = bor(rex, 0x01); }
  bufWriteU8(buf, offset, rex);
  bufWriteU8(buf, offset + 1, 0xF7);
  bufWriteU8(buf, offset + 2, bor(0xC0, bor(shl(7, 3), band(src, 7))));
  return offset + 3;
}

// -------------------------------------------------------------------------
//  NEG r64 (two's complement negate, 3 bytes)
//  REX.W F7 ModRM
//  ModRM: mod=11, reg=3 (NEG), rm=src
// -------------------------------------------------------------------------
routine emit_neg_r64(buf: any, offset: int, reg: int) -> int {
  let rex: int = 0x48;
  if reg >= 8 { rex = bor(rex, 0x01); }
  bufWriteU8(buf, offset, rex);
  bufWriteU8(buf, offset + 1, 0xF7);
  bufWriteU8(buf, offset + 2, bor(0xC0, bor(shl(3, 3), band(reg, 7))));
  return offset + 3;
}

// -------------------------------------------------------------------------
//  NOT r64 (bitwise complement, 3 bytes)
//  REX.W F7 ModRM
//  ModRM: mod=11, reg=2 (NOT), rm=src
// -------------------------------------------------------------------------
routine emit_not_r64(buf: any, offset: int, reg: int) -> int {
  let rex: int = 0x48;
  if reg >= 8 { rex = bor(rex, 0x01); }
  bufWriteU8(buf, offset, rex);
  bufWriteU8(buf, offset + 1, 0xF7);
  bufWriteU8(buf, offset + 2, bor(0xC0, bor(shl(2, 3), band(reg, 7))));
  return offset + 3;
}

// -------------------------------------------------------------------------
//  SHL r64, CL (shift left by CL, 3 bytes)
//  REX.W D3 ModRM
//  ModRM: mod=11, reg=4 (SHL), rm=src
// -------------------------------------------------------------------------
routine emit_shl_r64_cl(buf: any, offset: int, reg: int) -> int {
  let rex: int = 0x48;
  if reg >= 8 { rex = bor(rex, 0x01); }
  bufWriteU8(buf, offset, rex);
  bufWriteU8(buf, offset + 1, 0xD3);
  bufWriteU8(buf, offset + 2, bor(0xC0, bor(shl(4, 3), band(reg, 7))));
  return offset + 3;
}

// -------------------------------------------------------------------------
//  SHR r64, CL (logical shift right by CL, 3 bytes)
//  REX.W D3 ModRM
//  ModRM: mod=11, reg=5 (SHR), rm=src
// -------------------------------------------------------------------------
routine emit_shr_r64_cl(buf: any, offset: int, reg: int) -> int {
  let rex: int = 0x48;
  if reg >= 8 { rex = bor(rex, 0x01); }
  bufWriteU8(buf, offset, rex);
  bufWriteU8(buf, offset + 1, 0xD3);
  bufWriteU8(buf, offset + 2, bor(0xC0, bor(shl(5, 3), band(reg, 7))));
  return offset + 3;
}

// -------------------------------------------------------------------------
//  SAR r64, CL (arithmetic shift right by CL, 3 bytes)
//  REX.W D3 ModRM
//  ModRM: mod=11, reg=7 (SAR), rm=src
// -------------------------------------------------------------------------
routine emit_sar_r64_cl(buf: any, offset: int, reg: int) -> int {
  let rex: int = 0x48;
  if reg >= 8 { rex = bor(rex, 0x01); }
  bufWriteU8(buf, offset, rex);
  bufWriteU8(buf, offset + 1, 0xD3);
  bufWriteU8(buf, offset + 2, bor(0xC0, bor(shl(7, 3), band(reg, 7))));
  return offset + 3;
}

// -------------------------------------------------------------------------
//  MOVZX r32, r8 (zero-extend byte to 32-bit, clears upper 32, 3-4 bytes)
//  [REX] 0F B6 ModRM
//  No REX.W needed -- 32-bit dest zero-extends to 64
// -------------------------------------------------------------------------
routine emit_movzx_r32_r8(buf: any, offset: int, dst: int, src: int) -> int {
  let need_rex: bool = false;
  if dst >= 8 { need_rex = true; }
  if src >= 4 { need_rex = true; }
  if need_rex {
    let rex: int = 0x40;
    if dst >= 8 { rex = bor(rex, 0x04); }
    if src >= 8 { rex = bor(rex, 0x01); }
    bufWriteU8(buf, offset, rex);
    bufWriteU8(buf, offset + 1, 0x0F);
    bufWriteU8(buf, offset + 2, 0xB6);
    bufWriteU8(buf, offset + 3, bor(0xC0, bor(shl(band(dst, 7), 3), band(src, 7))));
    return offset + 4;
  }
  bufWriteU8(buf, offset, 0x0F);
  bufWriteU8(buf, offset + 1, 0xB6);
  bufWriteU8(buf, offset + 2, bor(0xC0, bor(shl(band(dst, 7), 3), band(src, 7))));
  return offset + 3;
}

// -------------------------------------------------------------------------
//  MOVSXD r64, r32 (sign-extend 32-bit to 64-bit, 3 bytes)
//  REX.W 63 ModRM
// -------------------------------------------------------------------------
routine emit_movsxd_r64_r32(buf: any, offset: int, dst: int, src: int) -> int {
  let rex: int = 0x48;
  if dst >= 8 { rex = bor(rex, 0x04); }
  if src >= 8 { rex = bor(rex, 0x01); }
  bufWriteU8(buf, offset, rex);
  bufWriteU8(buf, offset + 1, 0x63);
  bufWriteU8(buf, offset + 2, bor(0xC0, bor(shl(band(dst, 7), 3), band(src, 7))));
  return offset + 3;
}

// -------------------------------------------------------------------------
//  NOP (single-byte no-op, 1 byte)
//  0x90
// -------------------------------------------------------------------------
routine emit_nop(buf: any, offset: int) -> int {
  bufWriteU8(buf, offset, 0x90);
  return offset + 1;
}


// -------------------------------------------------------------------------
//  MOVSD xmm, [base+disp32] (load float64 from memory, 8 bytes)
//  F2 REX.W 0F 10 ModRM disp32
// -------------------------------------------------------------------------
routine emit_movsd_xmm_mem(buf: any, offset: int, xmm: int, base: int, disp32: int) -> int {
  bufWriteU8(buf, offset, 0xF2);
  let rex: int = 0x48;
  if xmm >= 8 { rex = bor(rex, 0x04); }
  if base >= 8 { rex = bor(rex, 0x01); }
  bufWriteU8(buf, offset + 1, rex);
  bufWriteU8(buf, offset + 2, 0x0F);
  bufWriteU8(buf, offset + 3, 0x10);
  bufWriteU8(buf, offset + 4, bor(0x80, bor(shl(band(xmm, 7), 3), band(base, 7))));
  bufWriteU32(buf, offset + 5, band(disp32, 0xFFFFFFFF));
  return offset + 9;
}

// -------------------------------------------------------------------------
//  MOVSD [base+disp32], xmm (store float64 to memory, 8 bytes)
//  F2 REX.W 0F 11 ModRM disp32
// -------------------------------------------------------------------------
routine emit_movsd_mem_xmm(buf: any, offset: int, base: int, disp32: int, xmm: int) -> int {
  bufWriteU8(buf, offset, 0xF2);
  let rex: int = 0x48;
  if xmm >= 8 { rex = bor(rex, 0x04); }
  if base >= 8 { rex = bor(rex, 0x01); }
  bufWriteU8(buf, offset + 1, rex);
  bufWriteU8(buf, offset + 2, 0x0F);
  bufWriteU8(buf, offset + 3, 0x11);
  bufWriteU8(buf, offset + 4, bor(0x80, bor(shl(band(xmm, 7), 3), band(base, 7))));
  bufWriteU32(buf, offset + 5, band(disp32, 0xFFFFFFFF));
  return offset + 9;
}

// -------------------------------------------------------------------------
//  MOVQ xmm, r64 (move GP register to XMM, 5 bytes)
//  66 REX.W 0F 6E ModRM
// -------------------------------------------------------------------------
routine emit_movq_xmm_r64(buf: any, offset: int, xmm: int, reg: int) -> int {
  bufWriteU8(buf, offset, 0x66);
  let rex: int = 0x48;
  if xmm >= 8 { rex = bor(rex, 0x04); }
  if reg >= 8 { rex = bor(rex, 0x01); }
  bufWriteU8(buf, offset + 1, rex);
  bufWriteU8(buf, offset + 2, 0x0F);
  bufWriteU8(buf, offset + 3, 0x6E);
  bufWriteU8(buf, offset + 4, bor(0xC0, bor(shl(band(xmm, 7), 3), band(reg, 7))));
  return offset + 5;
}

// -------------------------------------------------------------------------
//  MOVQ r64, xmm (move XMM to GP register, 5 bytes)
//  66 REX.W 0F 7E ModRM
// -------------------------------------------------------------------------
routine emit_movq_r64_xmm(buf: any, offset: int, reg: int, xmm: int) -> int {
  bufWriteU8(buf, offset, 0x66);
  let rex: int = 0x48;
  if xmm >= 8 { rex = bor(rex, 0x04); }
  if reg >= 8 { rex = bor(rex, 0x01); }
  bufWriteU8(buf, offset + 1, rex);
  bufWriteU8(buf, offset + 2, 0x0F);
  bufWriteU8(buf, offset + 3, 0x7E);
  bufWriteU8(buf, offset + 4, bor(0xC0, bor(shl(band(xmm, 7), 3), band(reg, 7))));
  return offset + 5;
}

// -------------------------------------------------------------------------
//  ADDSD xmm, xmm (float64 add, 4 bytes)
//  F2 0F 58 ModRM
// -------------------------------------------------------------------------
routine emit_addsd_xmm_xmm(buf: any, offset: int, dst: int, src: int) -> int {
  bufWriteU8(buf, offset, 0xF2);
  let off: int = offset + 1;
  if dst >= 8 or src >= 8 {
    let rex: int = 0x40;
    if dst >= 8 { rex = bor(rex, 0x04); }
    if src >= 8 { rex = bor(rex, 0x01); }
    bufWriteU8(buf, off, rex);
    off = off + 1;
  }
  bufWriteU8(buf, off, 0x0F);
  bufWriteU8(buf, off + 1, 0x58);
  bufWriteU8(buf, off + 2, bor(0xC0, bor(shl(band(dst, 7), 3), band(src, 7))));
  return off + 3;
}

// -------------------------------------------------------------------------
//  SUBSD xmm, xmm (float64 subtract, 4 bytes)
//  F2 0F 5C ModRM
// -------------------------------------------------------------------------
routine emit_subsd_xmm_xmm(buf: any, offset: int, dst: int, src: int) -> int {
  bufWriteU8(buf, offset, 0xF2);
  let off: int = offset + 1;
  if dst >= 8 or src >= 8 {
    let rex: int = 0x40;
    if dst >= 8 { rex = bor(rex, 0x04); }
    if src >= 8 { rex = bor(rex, 0x01); }
    bufWriteU8(buf, off, rex);
    off = off + 1;
  }
  bufWriteU8(buf, off, 0x0F);
  bufWriteU8(buf, off + 1, 0x5C);
  bufWriteU8(buf, off + 2, bor(0xC0, bor(shl(band(dst, 7), 3), band(src, 7))));
  return off + 3;
}

// -------------------------------------------------------------------------
//  MULSD xmm, xmm (float64 multiply, 4 bytes)
//  F2 0F 59 ModRM
// -------------------------------------------------------------------------
routine emit_mulsd_xmm_xmm(buf: any, offset: int, dst: int, src: int) -> int {
  bufWriteU8(buf, offset, 0xF2);
  let off: int = offset + 1;
  if dst >= 8 or src >= 8 {
    let rex: int = 0x40;
    if dst >= 8 { rex = bor(rex, 0x04); }
    if src >= 8 { rex = bor(rex, 0x01); }
    bufWriteU8(buf, off, rex);
    off = off + 1;
  }
  bufWriteU8(buf, off, 0x0F);
  bufWriteU8(buf, off + 1, 0x59);
  bufWriteU8(buf, off + 2, bor(0xC0, bor(shl(band(dst, 7), 3), band(src, 7))));
  return off + 3;
}

// -------------------------------------------------------------------------
//  DIVSD xmm, xmm (float64 divide, 4 bytes)
//  F2 0F 5E ModRM
// -------------------------------------------------------------------------
routine emit_divsd_xmm_xmm(buf: any, offset: int, dst: int, src: int) -> int {
  bufWriteU8(buf, offset, 0xF2);
  let off: int = offset + 1;
  if dst >= 8 or src >= 8 {
    let rex: int = 0x40;
    if dst >= 8 { rex = bor(rex, 0x04); }
    if src >= 8 { rex = bor(rex, 0x01); }
    bufWriteU8(buf, off, rex);
    off = off + 1;
  }
  bufWriteU8(buf, off, 0x0F);
  bufWriteU8(buf, off + 1, 0x5E);
  bufWriteU8(buf, off + 2, bor(0xC0, bor(shl(band(dst, 7), 3), band(src, 7))));
  return off + 3;
}

// -------------------------------------------------------------------------
//  CVTSI2SD xmm, r64 (int64 to float64, 5 bytes)
//  F2 REX.W 0F 2A ModRM
// -------------------------------------------------------------------------
routine emit_cvtsi2sd_xmm_r64(buf: any, offset: int, xmm: int, reg: int) -> int {
  bufWriteU8(buf, offset, 0xF2);
  let rex: int = 0x48;
  if xmm >= 8 { rex = bor(rex, 0x04); }
  if reg >= 8 { rex = bor(rex, 0x01); }
  bufWriteU8(buf, offset + 1, rex);
  bufWriteU8(buf, offset + 2, 0x0F);
  bufWriteU8(buf, offset + 3, 0x2A);
  bufWriteU8(buf, offset + 4, bor(0xC0, bor(shl(band(xmm, 7), 3), band(reg, 7))));
  return offset + 5;
}

// -------------------------------------------------------------------------
//  CVTTSD2SI r64, xmm (float64 to int64 with truncation, 5 bytes)
//  F2 REX.W 0F 2C ModRM
// -------------------------------------------------------------------------
routine emit_cvttsd2si_r64_xmm(buf: any, offset: int, reg: int, xmm: int) -> int {
  bufWriteU8(buf, offset, 0xF2);
  let rex: int = 0x48;
  if reg >= 8 { rex = bor(rex, 0x04); }
  if xmm >= 8 { rex = bor(rex, 0x01); }
  bufWriteU8(buf, offset + 1, rex);
  bufWriteU8(buf, offset + 2, 0x0F);
  bufWriteU8(buf, offset + 3, 0x2C);
  bufWriteU8(buf, offset + 4, bor(0xC0, bor(shl(band(reg, 7), 3), band(xmm, 7))));
  return offset + 5;
}

// -------------------------------------------------------------------------
//  UCOMISD xmm, xmm (unordered compare float64, sets ZF/PF/CF, 4 bytes)
//  66 0F 2E ModRM
// -------------------------------------------------------------------------
routine emit_ucomisd_xmm_xmm(buf: any, offset: int, dst: int, src: int) -> int {
  bufWriteU8(buf, offset, 0x66);
  let off: int = offset + 1;
  if dst >= 8 or src >= 8 {
    let rex: int = 0x40;
    if dst >= 8 { rex = bor(rex, 0x04); }
    if src >= 8 { rex = bor(rex, 0x01); }
    bufWriteU8(buf, off, rex);
    off = off + 1;
  }
  bufWriteU8(buf, off, 0x0F);
  bufWriteU8(buf, off + 1, 0x2E);
  bufWriteU8(buf, off + 2, bor(0xC0, bor(shl(band(dst, 7), 3), band(src, 7))));
  return off + 3;
}

// -------------------------------------------------------------------------
//  MOV r32, imm32 (32-bit immediate, zero-extends to 64-bit)
//  Opcode: B8+rd id (no REX.W = 32-bit operand size)
//  Used for: mov eax, N to set AL for SysV variadic float count
// -------------------------------------------------------------------------
routine emit_mov_r32_imm32(buf: any, offset: int, reg: int, value: int) -> int {
  let off: any = offset;
  if reg >= 8 {
    bufWriteU8(buf, off, 0x41);
    off = off + 1;
  }
  bufWriteU8(buf, off, bor(0xB8, band(reg, 7)));
  bufWriteU32(buf, off + 1, band(value, 0xFFFFFFFF));
  return off + 5;
}

// -------------------------------------------------------------------------
//  MOVSD xmm, [RSP+disp32] (load float64 from stack)
//  F2 [REX] 0F 10 ModRM(10,xmm,100) SIB(00,100,100) disp32
//  RSP as base requires SIB byte
// -------------------------------------------------------------------------
routine emit_movsd_xmm_rsp_disp(buf: any, offset: int, xmm: int, disp32: int) -> int {
  let off: any = offset;
  bufWriteU8(buf, off, 0xF2); off = off + 1;
  if xmm >= 8 {
    bufWriteU8(buf, off, 0x44); off = off + 1;
  }
  bufWriteU8(buf, off, 0x0F); off = off + 1;
  bufWriteU8(buf, off, 0x10); off = off + 1;
  bufWriteU8(buf, off, bor(0x84, shl(band(xmm, 7), 3))); off = off + 1;
  bufWriteU8(buf, off, 0x24); off = off + 1;
  bufWriteU32(buf, off, band(disp32, 0xFFFFFFFF)); off = off + 4;
  return off;
}

// -------------------------------------------------------------------------
//  MOVSD [RSP+disp32], xmm (store float64 to stack)
//  F2 [REX] 0F 11 ModRM(10,xmm,100) SIB(00,100,100) disp32
// -------------------------------------------------------------------------
routine emit_movsd_rsp_disp_xmm(buf: any, offset: int, disp32: int, xmm: int) -> int {
  let off: any = offset;
  bufWriteU8(buf, off, 0xF2); off = off + 1;
  if xmm >= 8 {
    bufWriteU8(buf, off, 0x44); off = off + 1;
  }
  bufWriteU8(buf, off, 0x0F); off = off + 1;
  bufWriteU8(buf, off, 0x11); off = off + 1;
  bufWriteU8(buf, off, bor(0x84, shl(band(xmm, 7), 3))); off = off + 1;
  bufWriteU8(buf, off, 0x24); off = off + 1;
  bufWriteU32(buf, off, band(disp32, 0xFFFFFFFF)); off = off + 4;
  return off;
}

// -------------------------------------------------------------------------
//  CVTSD2SS xmm, xmm (convert double -> single precision, 4 bytes)
//  F2 0F 5A ModRM(11,dst,src)
// -------------------------------------------------------------------------
routine emit_cvtsd2ss_xmm_xmm(buf: any, offset: int, dst: int, src: int) -> int {
  bufWriteU8(buf, offset, 0xF2);
  let off: int = offset + 1;
  if dst >= 8 or src >= 8 {
    let rex: int = 0x40;
    if dst >= 8 { rex = bor(rex, 0x04); }
    if src >= 8 { rex = bor(rex, 0x01); }
    bufWriteU8(buf, off, rex);
    off = off + 1;
  }
  bufWriteU8(buf, off, 0x0F);
  bufWriteU8(buf, off + 1, 0x5A);
  bufWriteU8(buf, off + 2, bor(0xC0, bor(shl(band(dst, 7), 3), band(src, 7))));
  return off + 3;
}

// -------------------------------------------------------------------------
//  CVTSS2SD xmm, xmm (convert single -> double precision, 4 bytes)
//  F3 0F 5A ModRM(11,dst,src)
// -------------------------------------------------------------------------
routine emit_cvtss2sd_xmm_xmm(buf: any, offset: int, dst: int, src: int) -> int {
  bufWriteU8(buf, offset, 0xF3);
  let off: int = offset + 1;
  if dst >= 8 or src >= 8 {
    let rex: int = 0x40;
    if dst >= 8 { rex = bor(rex, 0x04); }
    if src >= 8 { rex = bor(rex, 0x01); }
    bufWriteU8(buf, off, rex);
    off = off + 1;
  }
  bufWriteU8(buf, off, 0x0F);
  bufWriteU8(buf, off + 1, 0x5A);
  bufWriteU8(buf, off + 2, bor(0xC0, bor(shl(band(dst, 7), 3), band(src, 7))));
  return off + 3;
}

// -------------------------------------------------------------------------
//  MOV [RSP+disp32], r64 (store GP register to stack, needs SIB)
//  REX.W 89 ModRM(10,reg,100) SIB(00,100,100) disp32
// -------------------------------------------------------------------------
routine emit_mov_rsp_disp_r64(buf: any, offset: int, disp32: int, reg: int) -> int {
  let rex: int = 0x48;
  if reg >= 8 { rex = bor(rex, 0x04); }
  bufWriteU8(buf, offset, rex);
  bufWriteU8(buf, offset + 1, 0x89);
  bufWriteU8(buf, offset + 2, bor(0x84, shl(band(reg, 7), 3)));
  bufWriteU8(buf, offset + 3, 0x24);
  bufWriteU32(buf, offset + 4, band(disp32, 0xFFFFFFFF));
  return offset + 8;
}
