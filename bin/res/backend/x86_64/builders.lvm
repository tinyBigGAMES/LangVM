 builders.lvm -- Data Builders for LVM backend

 Provides structured accumulation of code, data, and imports.
 Produces the exact structures pe_build_exe / elf_build_exe consume.
*******************************************************************************/

routine db_create() -> map {
  return {"buf": buffer(4096), "pos": 0, "entries": []};
}

// Add a UTF-8 null-terminated string, return entry handle (index)
routine db_add_string(db: any, s: any) -> int {
  let offset: any = db.pos;
  let byte_count: any = bufWriteString(db.buf, db.pos, s);
  db.pos = db.pos + byte_count;
  // Null terminator
  bufWriteU8(db.buf, db.pos, 0);
  db.pos = db.pos + 1;
  let size: int = byte_count + 1;
  db.entries = db.entries + [{"offset": offset, "size": size}];
  return len(db.entries) - 1;
}

// Add raw bytes from a source buffer, return entry handle
routine db_add_bytes(db: any, src: any, size: int) -> int {
  let offset: any = db.pos;
  bufCopyBytes(db.buf, db.pos, src, 0, size);
  db.pos = db.pos + size;
  db.entries = db.entries + [{"offset": offset, "size": size}];
  return len(db.entries) - 1;
}

// Add a signed 8-bit integer, return entry handle
routine db_add_i8(db: any, val: int) -> int {
  let offset: any = db.pos;
  bufWriteU8(db.buf, db.pos, band(val, 0xFF));
  db.pos = db.pos + 1;
  db.entries = db.entries + [{"offset": offset, "size": 1}];
  return len(db.entries) - 1;
}

// Add a 16-bit integer, return entry handle
routine db_add_i16(db: any, val: int) -> int {
  let offset: any = db.pos;
  bufWriteU16(db.buf, db.pos, band(val, 0xFFFF));
  db.pos = db.pos + 2;
  db.entries = db.entries + [{"offset": offset, "size": 2}];
  return len(db.entries) - 1;
}

// Add a 32-bit integer, return entry handle
routine db_add_i32(db: any, val: int) -> int {
  let offset: any = db.pos;
  bufWriteU32(db.buf, db.pos, band(val, 0xFFFFFFFF));
  db.pos = db.pos + 4;
  db.entries = db.entries + [{"offset": offset, "size": 4}];
  return len(db.entries) - 1;
}

// Add a 64-bit integer, return entry handle
routine db_add_i64(db: any, val: int) -> int {
  let offset: any = db.pos;
  bufWriteU64(db.buf, db.pos, val);
  db.pos = db.pos + 8;
  db.entries = db.entries + [{"offset": offset, "size": 8}];
  return len(db.entries) - 1;
}

// Add a 64-bit float, return entry handle
routine db_add_f64(db: any, val: float) -> int {
  let offset: any = db.pos;
  bufWriteF64(db.buf, db.pos, val);
  db.pos = db.pos + 8;
  db.entries = db.entries + [{"offset": offset, "size": 8}];
  return len(db.entries) - 1;
}

// Reserve uninitialized space with alignment, return entry handle
routine db_reserve(db: any, size: int, align: int) -> int {
  db_align(db, align);
  let offset: any = db.pos;
  let i: int = 0;
  while i < size {
    bufWriteU8(db.buf, db.pos, 0);
    db.pos = db.pos + 1;
    i = i + 1;
  }
  db.entries = db.entries + [{"offset": offset, "size": size}];
  return len(db.entries) - 1;
}

// Pad with zero bytes until pos is aligned to the given boundary
routine db_align(db: any, alignment: int) {
  let rem: int = db.pos % alignment;
  if rem != 0 {
    let pad: int = alignment - rem;
    let i: int = 0;
    while i < pad {
      bufWriteU8(db.buf, db.pos, 0);
      db.pos = db.pos + 1;
      i = i + 1;
    }
  }
}

// Get the byte offset of an entry by its handle
routine db_get_offset(db: any, handle: int) -> int {
  return db.entries[handle].offset;
}

// Get total bytes written
routine db_get_size(db: any) -> int {
  return db.pos;
}

// Get the raw buffer
routine db_get_buf(db: any) -> any {
  return db.buf;
}

// =========================================================================
//  ImportBuilder
//
//  Accumulates DLL/SO imports. Produces the list-of-lists format that
//  pe_build_exe / elf_build_exe expect:
//    [["kernel32.dll", ["ExitProcess", "WriteFile"]], ...]
//
//  Each ib_add returns a flat index matching the IAT/GOT slot order.
// =========================================================================

routine ib_create() -> map {
  return {"dlls": {}, "flat": [], "order": []};
}

// Add an import, return flat index (used in fixup lists)
routine ib_add(ib: any, dll: any, func: any) -> int {
  // If this DLL hasn't been seen yet, create its entry
  if not mapHas(ib.dlls, dll) {
    ib.dlls[dll] = [];
    ib.order = ib.order + [dll];
  }
  // Append the function to this DLL's list
  ib.dlls[dll] = ib.dlls[dll] + [func];
  // Record in flat list for index tracking
  ib.flat = ib.flat + [{"dll": dll, "func": func}];
  return len(ib.flat) - 1;
}

// Find the flat index of an existing import (-1 if not found)
routine ib_find(ib: any, dll: any, func: any) -> int {
  let i: int = 0;
  while i < len(ib.flat) {
    if ib.flat[i].dll == dll and ib.flat[i].func == func {
      return i;
    }
    i = i + 1;
  }
  return -1;
}

// Produce the list-of-lists format pe/elf writers expect
routine ib_to_imports(ib: any) -> any {
  let result: list = [];
  let i: int = 0;
  while i < len(ib.order) {
    let dll_name: any = ib.order[i];
    result = result + [[dll_name, ib.dlls[dll_name]]];
    i = i + 1;
  }
  return result;
}

// Get total import count
routine ib_count(ib: any) -> int {
  return len(ib.flat);
}

// Get count of unique DLLs
routine ib_dll_count(ib: any) -> int {
  return len(ib.order);
}

// =========================================================================
//  CodeBuilder (lightweight)
//
//  Code buffer + position tracking + labels + fixup lists.
//  Wraps encode.lvm emit_* routines. NOT the full SSA IR builder.
// =========================================================================

routine cb_create(size: int) -> map {
  return {
    "buf": buffer(size),
    "pos": 0,
    "labels": {},
    "fixups_iat": [],
    "fixups_data": [],
    "fixups_global": [],
    "fixups_rel32": []
  };
}

// --- Raw byte emission ---

routine cb_emit_u8(cb: any, val: int) {
  bufWriteU8(cb.buf, cb.pos, val);
  cb.pos = cb.pos + 1;
}

routine cb_emit_u16(cb: any, val: int) {
  bufWriteU16(cb.buf, cb.pos, val);
  cb.pos = cb.pos + 2;
}

routine cb_emit_u32(cb: any, val: int) {
  bufWriteU32(cb.buf, cb.pos, val);
  cb.pos = cb.pos + 4;
}

routine cb_emit_u64(cb: any, val: int) {
  bufWriteU64(cb.buf, cb.pos, val);
  cb.pos = cb.pos + 8;
}

// --- Encoded instruction wrappers (delegate to encode.lvm) ---

routine cb_emit_sub_rsp_imm8(cb: any, val: int) {
  cb.pos = emit_sub_rsp_imm8(cb.buf, cb.pos, val);
}

routine cb_emit_add_rsp_imm8(cb: any, val: int) {
  cb.pos = emit_add_rsp_imm8(cb.buf, cb.pos, val);
}

routine cb_emit_push(cb: any, reg: int) {
  cb.pos = emit_push_r64(cb.buf, cb.pos, reg);
}

routine cb_emit_pop(cb: any, reg: int) {
  cb.pos = emit_pop_r64(cb.buf, cb.pos, reg);
}

routine cb_emit_ret(cb: any) {
  cb.pos = emit_ret(cb.buf, cb.pos);
}

routine cb_emit_mov_r64_imm64(cb: any, reg: int, val: int) {
  cb.pos = emit_mov_r64_imm64(cb.buf, cb.pos, reg, val);
}

routine cb_emit_mov_r64_r64(cb: any, dst: int, src: int) {
  cb.pos = emit_mov_r64_r64(cb.buf, cb.pos, dst, src);
}

routine cb_emit_movq_xmm_r64(cb: any, xmm: int, reg: int) {
  cb.pos = emit_movq_xmm_r64(cb.buf, cb.pos, xmm, reg);
}

// Emit CALL [RIP+disp32] (6 bytes: FF 15 disp32)
// Returns the offset of the instruction (for fixup tracking)
routine cb_emit_call_rip_disp32(cb: any) -> int {
  let instr_off: any = cb.pos;
  bufWriteU8(cb.buf, cb.pos, 0xFF);
  bufWriteU8(cb.buf, cb.pos + 1, 0x15);
  bufWriteU32(cb.buf, cb.pos + 2, 0);
  cb.pos = cb.pos + 6;
  return instr_off;
}

// Emit LEA r64, [RIP+disp32] (7 bytes)
// Returns the offset of the instruction (for fixup tracking)
routine cb_emit_lea_rip_disp32(cb: any, reg: int) -> int {
  let instr_off: any = cb.pos;
  cb.pos = emit_lea_rip(cb.buf, cb.pos, reg, 0);
  return instr_off;
}

routine cb_emit_nop(cb: any, count: int) {
  let i: int = 0;
  while i < count {
    bufWriteU8(cb.buf, cb.pos, 0x90);
    cb.pos = cb.pos + 1;
    i = i + 1;
  }
}

// --- Labels ---

routine cb_define_label(cb: any, name: any) {
  cb.labels[name] = cb.pos;
}

routine cb_label_offset(cb: any, name: any) -> int {
  return cb.labels[name];
}

// --- Fixups ---

// IAT/GOT fixup: code_off is the instruction offset, import_idx is the
// flat index from ib_add
routine cb_add_fixup_iat(cb: any, code_off: int, import_idx: int) {
  cb.fixups_iat = cb.fixups_iat + [[code_off, import_idx]];
}

// Data (.rdata) fixup: code_off is the LEA instruction offset,
// data_entry_idx is the handle from db_add_*
routine cb_add_fixup_data(cb: any, code_off: int, data_entry_idx: int) {
  cb.fixups_data = cb.fixups_data + [[code_off, data_entry_idx]];
}

// Global (.data) fixup
routine cb_add_fixup_global(cb: any, code_off: int, global_entry_idx: int) {
  cb.fixups_global = cb.fixups_global + [[code_off, global_entry_idx]];
}

// Rel32 label fixup: the 4-byte displacement at patch_off will be resolved
// to (label_offset - (patch_off + 4)) when cb_resolve_labels is called
routine cb_add_fixup_rel32(cb: any, patch_off: int, label_name: any) {
  cb.fixups_rel32 = cb.fixups_rel32 + [[patch_off, label_name]];
}

// --- Resolution ---

// Resolve all rel32 label fixups: patch the 4-byte displacement
routine cb_resolve_labels(cb: any) {
  let i: int = 0;
  while i < len(cb.fixups_rel32) {
    let patch_off: any = cb.fixups_rel32[i][0];
    let label_name: any = cb.fixups_rel32[i][1];
    let target: any = cb.labels[label_name];
    let disp: int = target - (patch_off + 4);
    bufWriteU32(cb.buf, patch_off, band(disp, 0xFFFFFFFF));
    i = i + 1;
  }
}

// Get the fixup lists in the format pe/elf writers expect
routine cb_get_iat_fixups(cb: any) -> any {
  return cb.fixups_iat;
}

routine cb_get_data_fixups(cb: any) -> any {
  return cb.fixups_data;
}

routine cb_get_global_fixups(cb: any) -> any {
  return cb.fixups_global;
}

// --- Query ---

routine cb_get_pos(cb: any) -> int {
  return cb.pos;
}

routine cb_get_buf(cb: any) -> any {
  return cb.buf;
}

// =========================================================================
//  ExportBuilder
//
//  Collects exported symbols (functions and globals) for PE .edata and
//  ELF dynamic symbol tables. Each eb_add returns an index.
// =========================================================================

routine eb_create() -> map {
  return {"entries": []};
}

// Add an export: name is the exported symbol name, kind is "func" or "global",
// offset is the byte offset in .text (func) or .data (global)
routine eb_add(eb: any, name: any, kind: any, offset: int) -> int {
  eb.entries = eb.entries + [{"name": name, "kind": kind, "offset": offset}];
  return len(eb.entries) - 1;
}

// Sort exports alphabetically by name (PE spec requires this for binary search)
routine eb_sort(eb: any) {
  let n: int = len(eb.entries);
  let i: int = 1;
  while i < n {
    let key: any = eb.entries[i];
    let j: int = i - 1;
    while j >= 0 and eb.entries[j].name > key.name {
      eb.entries[j + 1] = eb.entries[j];
      j = j - 1;
    }
    eb.entries[j + 1] = key;
    i = i + 1;
  }
}

routine eb_count(eb: any) -> int {
  return len(eb.entries);
}

routine eb_get(eb: any, idx: int) -> any {
  return eb.entries[idx];
}

// =========================================================================
//  BSS support for DataBuilder
// =========================================================================

// Reserve uninitialized (BSS) space. Does NOT write to the buffer.
// Returns entry handle. db.pos advances but no bytes are written.
routine db_add_bss(db: any, size: int) -> int {
  let offset: any = db.pos;
  db.pos = db.pos + size;
  db.entries = db.entries + [{"offset": offset, "size": size, "bss": true}];
  return len(db.entries) - 1;
}

// Get the initialized (non-BSS) size of the data builder
routine db_get_initialized_size(db: any) -> int {
  let last_init: int = 0;
  let i: int = 0;
  while i < len(db.entries) {
    let e: any = db.entries[i];
    if not mapHas(e, "bss") or not e.bss {
      let end_pos: int = e.offset + e.size;
      if end_pos > last_init { last_init = end_pos; }
    }
    i = i + 1;
  }
  return last_init;
}
