 -----------------------------------------------------------------------------
 abi.lvm -- ABI & Calling Convention helpers for x86_64

 Provides high-level routines for function prologue/epilogue generation,
 argument register assignment, stack frame sizing, and parameter homing.
 Supports Win64 and SysV x86-64 ABIs.  
*******************************************************************************/

// Win64 integer argument registers (positional)
const {
  WIN64_ARG0 = 1;   // RCX
  WIN64_ARG1 = 2;   // RDX
  WIN64_ARG2 = 8;   // R8
  WIN64_ARG3 = 9;   // R9
  WIN64_SHADOW = 32; // 4 * 8 bytes shadow space
}

// SysV integer argument registers
const {
  SYSV_ARG0 = 7;    // RDI
  SYSV_ARG1 = 6;    // RSI
  SYSV_ARG2 = 2;    // RDX
  SYSV_ARG3 = 1;    // RCX
  SYSV_ARG4 = 8;    // R8
  SYSV_ARG5 = 9;    // R9
}

// -------------------------------------------------------------------------
//  Register assignment
// -------------------------------------------------------------------------

// Returns Win64 integer arg register for position 0-3, or -1 for stack
routine abi_win64_arg_reg(index: int) -> int {
  if index == 0 { return WIN64_ARG0; }
  if index == 1 { return WIN64_ARG1; }
  if index == 2 { return WIN64_ARG2; }
  if index == 3 { return WIN64_ARG3; }
  return -1;
}

// Returns SysV integer arg register for position 0-5, or -1 for stack
routine abi_sysv_arg_reg(index: int) -> int {
  if index == 0 { return SYSV_ARG0; }
  if index == 1 { return SYSV_ARG1; }
  if index == 2 { return SYSV_ARG2; }
  if index == 3 { return SYSV_ARG3; }
  if index == 4 { return SYSV_ARG4; }
  if index == 5 { return SYSV_ARG5; }
  return -1;
}

// -------------------------------------------------------------------------
//  Stack alignment
// -------------------------------------------------------------------------

// Round size up to 16-byte alignment
routine abi_stack_align(size: int) -> int {
  let r: int = size % 16;
  if r == 0 { return size; }
  return size + 16 - r;
}

// -------------------------------------------------------------------------
//  Frame size calculation
// -------------------------------------------------------------------------

// Calculate aligned stack frame size.
// local_bytes: total bytes needed for locals
// max_call_args: max number of args in any outgoing call
// is_win64: 1 for Win64, 0 for SysV
routine abi_frame_size(local_bytes: int, max_call_args: int, is_win64: int) -> int {
  let outgoing: int = 0;
  if is_win64 == 1 {
    // Win64: always reserve at least 32 bytes shadow space
    if max_call_args < 4 {
      outgoing = 32;
    } else {
      outgoing = max_call_args * 8;
    }
  } else {
    // SysV: no shadow space, but still need stack space for >6 args
    if max_call_args > 6 {
      outgoing = (max_call_args - 6) * 8;
    }
  }
  // 8 bytes for alignment (push rbp shifts RSP by 8, sub rsp realigns)
  let total: int = 8 + local_bytes + outgoing;
  return abi_stack_align(total);
}

// -------------------------------------------------------------------------
//  Prologue / Epilogue emission
// -------------------------------------------------------------------------

// Emit function prologue: push rbp; mov rbp, rsp; sub rsp, frame_size
routine abi_emit_prologue(buf: any, offset: int, frame_size: int) -> int {
  let off: any = offset;
  off = emit_push_r64(buf, off, REG_RBP);
  off = emit_mov_r64_r64(buf, off, REG_RBP, REG_RSP);
  if frame_size > 0 {
    if frame_size <= 127 {
      off = emit_sub_rsp_imm8(buf, off, frame_size);
    } else {
      off = emit_sub_rsp_imm32(buf, off, frame_size);
    }
  }
  return off;
}

// Emit function epilogue: mov rsp, rbp; pop rbp; ret
routine abi_emit_epilogue(buf: any, offset: int) -> int {
  let off: any = offset;
  off = emit_mov_r64_r64(buf, off, REG_RSP, REG_RBP);
  off = emit_pop_r64(buf, off, REG_RBP);
  off = emit_ret(buf, off);
  return off;
}

// -------------------------------------------------------------------------
//  Win64 parameter homing
// -------------------------------------------------------------------------

// Home incoming Win64 register params to stack slots.
// Param 0 (RCX) -> [RBP-40], Param 1 (RDX) -> [RBP-48], etc.
// Matches src_old2 GetParamOffset: -(40 + index * 8)
routine abi_emit_home_params_win64(buf: any, offset: int, num_params: int) -> int {
  let off: any = offset;
  if num_params > 0 {
    off = emit_mov_base_disp_r64(buf, off, REG_RBP, -40, REG_RCX);
  }
  if num_params > 1 {
    off = emit_mov_base_disp_r64(buf, off, REG_RBP, -48, REG_RDX);
  }
  if num_params > 2 {
    off = emit_mov_base_disp_r64(buf, off, REG_RBP, -56, REG_R8);
  }
  if num_params > 3 {
    off = emit_mov_base_disp_r64(buf, off, REG_RBP, -64, REG_R9);
  }
  return off;
}

// -------------------------------------------------------------------------
//  SysV parameter homing
// -------------------------------------------------------------------------

// Home incoming SysV register params to stack slots.
// Param 0 (RDI) -> [RBP-40], Param 1 (RSI) -> [RBP-48], etc.
// Uses same offset formula as Win64 for uniform GetParamOffset.
routine abi_emit_home_params_sysv(buf: any, offset: int, num_params: int) -> int {
  let off: any = offset;
  if num_params > 0 {
    off = emit_mov_base_disp_r64(buf, off, REG_RBP, -40, REG_RDI);
  }
  if num_params > 1 {
    off = emit_mov_base_disp_r64(buf, off, REG_RBP, -48, REG_RSI);
  }
  if num_params > 2 {
    off = emit_mov_base_disp_r64(buf, off, REG_RBP, -56, REG_RDX);
  }
  if num_params > 3 {
    off = emit_mov_base_disp_r64(buf, off, REG_RBP, -64, REG_RCX);
  }
  if num_params > 4 {
    off = emit_mov_base_disp_r64(buf, off, REG_RBP, -72, REG_R8);
  }
  if num_params > 5 {
    off = emit_mov_base_disp_r64(buf, off, REG_RBP, -80, REG_R9);
  }
  return off;
}

// -------------------------------------------------------------------------
//  Outgoing call argument setup
// -------------------------------------------------------------------------

// Move up to 4 immediate values into Win64 argument registers.
// args is a list of integer values.
routine abi_emit_call_args_win64(buf: any, offset: int, args: any) -> int {
  let off: any = offset;
  let n: int = len(args);
  if n > 0 {
    off = emit_mov_r64_imm64(buf, off, REG_RCX, args[0]);
  }
  if n > 1 {
    off = emit_mov_r64_imm64(buf, off, REG_RDX, args[1]);
  }
  if n > 2 {
    off = emit_mov_r64_imm64(buf, off, REG_R8, args[2]);
  }
  if n > 3 {
    off = emit_mov_r64_imm64(buf, off, REG_R9, args[3]);
  }
  return off;
}

// Move up to 6 immediate values into SysV argument registers.
routine abi_emit_call_args_sysv(buf: any, offset: int, args: any) -> int {
  let off: any = offset;
  let n: int = len(args);
  if n > 0 {
    off = emit_mov_r64_imm64(buf, off, REG_RDI, args[0]);
  }
  if n > 1 {
    off = emit_mov_r64_imm64(buf, off, REG_RSI, args[1]);
  }
  if n > 2 {
    off = emit_mov_r64_imm64(buf, off, REG_RDX, args[2]);
  }
  if n > 3 {
    off = emit_mov_r64_imm64(buf, off, REG_RCX, args[3]);
  }
  if n > 4 {
    off = emit_mov_r64_imm64(buf, off, REG_R8, args[4]);
  }
  if n > 5 {
    off = emit_mov_r64_imm64(buf, off, REG_R9, args[5]);
  }
  return off;
}

// -------------------------------------------------------------------------
//  Param offset helper (mirrors src_old2 GetParamOffset)
// -------------------------------------------------------------------------

// Returns the RBP displacement for parameter at given index.
// Param 0 -> -40, Param 1 -> -48, Param 2 -> -56, etc.
routine abi_param_offset(index: int) -> int {
  return -(40 + index * 8);
}

// =========================================================================
//  Float parameter homing
// =========================================================================

// Home incoming Win64 float register params to stack slots.
// Win64 is positional: slot N is either GPn or XMMn, not both.
// param_type_flags is a list where 1 = float, 0 = integer.
// Integer params are homed by abi_emit_home_params_win64; this homes floats.
routine abi_emit_home_float_params_win64(buf: any, offset: int, param_type_flags: any) -> int {
  let off: any = offset;
  let n: int = len(param_type_flags);
  if n > 0 and param_type_flags[0] == 1 {
    off = emit_movsd_mem_xmm(buf, off, REG_RBP, -40, REG_XMM0);
  }
  if n > 1 and param_type_flags[1] == 1 {
    off = emit_movsd_mem_xmm(buf, off, REG_RBP, -48, REG_XMM1);
  }
  if n > 2 and param_type_flags[2] == 1 {
    off = emit_movsd_mem_xmm(buf, off, REG_RBP, -56, REG_XMM2);
  }
  if n > 3 and param_type_flags[3] == 1 {
    off = emit_movsd_mem_xmm(buf, off, REG_RBP, -64, REG_XMM3);
  }
  return off;
}

// Home incoming SysV float register params to stack slots.
// SysV uses independent counters: float params fill XMM0-7 regardless of
// integer arg position. param_type_flags is a list where 1 = float, 0 = integer.
// float_offsets maps each float param index to its [RBP-disp] slot.
routine abi_emit_home_float_params_sysv(buf: any, offset: int, param_type_flags: any, float_offsets: any) -> int {
  let off: any = offset;
  let xmm_idx: int = 0;
  let i: int = 0;
  while i < len(param_type_flags) {
    if param_type_flags[i] == 1 and xmm_idx < 8 {
      off = emit_movsd_mem_xmm(buf, off, REG_RBP, float_offsets[xmm_idx], xmm_idx);
      xmm_idx = xmm_idx + 1;
    }
    i = i + 1;
  }
  return off;
}

// =========================================================================
//  Typed outgoing call args (Win64)
// =========================================================================

// Load outgoing Win64 call arguments with type awareness.
// args: list of integer values (raw bits -- float64 bits for floats)
// type_flags: list where 1 = float, 0 = integer (parallel to args)
// Slots 0-3 go to RCX/XMM0, RDX/XMM1, R8/XMM2, R9/XMM3 based on type.
// Slots 4+ go to [RSP+32+(N-4)*8].
routine abi_emit_call_args_win64_typed(buf: any, offset: int, args: any, type_flags: any) -> int {
  let off: any = offset;
  let n: int = len(args);

  // Stack args first (5+), so RAX is still free as scratch
  let k: int = 4;
  while k < n {
    if type_flags[k] == 1 {
      off = emit_mov_r64_imm64(buf, off, REG_RAX, args[k]);
      off = emit_movq_xmm_r64(buf, off, REG_XMM0, REG_RAX);
      off = emit_movsd_rsp_disp_xmm(buf, off, 32 + (k - 4) * 8, REG_XMM0);
    } else {
      off = emit_mov_r64_imm64(buf, off, REG_RAX, args[k]);
      off = emit_mov_rsp_disp_r64(buf, off, 32 + (k - 4) * 8, REG_RAX);
    }
    k = k + 1;
  }

  // Register args (slots 0-3)
  if n > 0 {
    if type_flags[0] == 1 {
      off = emit_mov_r64_imm64(buf, off, REG_RAX, args[0]);
      off = emit_movq_xmm_r64(buf, off, REG_XMM0, REG_RAX);
    } else {
      off = emit_mov_r64_imm64(buf, off, REG_RCX, args[0]);
    }
  }
  if n > 1 {
    if type_flags[1] == 1 {
      off = emit_mov_r64_imm64(buf, off, REG_RAX, args[1]);
      off = emit_movq_xmm_r64(buf, off, REG_XMM1, REG_RAX);
    } else {
      off = emit_mov_r64_imm64(buf, off, REG_RDX, args[1]);
    }
  }
  if n > 2 {
    if type_flags[2] == 1 {
      off = emit_mov_r64_imm64(buf, off, REG_RAX, args[2]);
      off = emit_movq_xmm_r64(buf, off, REG_XMM2, REG_RAX);
    } else {
      off = emit_mov_r64_imm64(buf, off, REG_R8, args[2]);
    }
  }
  if n > 3 {
    if type_flags[3] == 1 {
      off = emit_mov_r64_imm64(buf, off, REG_RAX, args[3]);
      off = emit_movq_xmm_r64(buf, off, REG_XMM3, REG_RAX);
    } else {
      off = emit_mov_r64_imm64(buf, off, REG_R9, args[3]);
    }
  }
  return off;
}

// =========================================================================
//  Typed outgoing call args (SysV)
// =========================================================================

// Load outgoing SysV call arguments with type awareness.
// Independent counters: int args fill RDI/RSI/RDX/RCX/R8/R9 (6 regs),
// float args fill XMM0-XMM7 (8 regs). Overflow spills to stack.
// Sets AL = number of XMM registers used (mandatory for variadic).
routine abi_emit_call_args_sysv_typed(buf: any, offset: int, args: any, type_flags: any) -> int {
  let off: any = offset;
  let n: int = len(args);
  let int_regs: list = [REG_RDI, REG_RSI, REG_RDX, REG_RCX, REG_R8, REG_R9];

  // Pass 1: stack spills (RAX not yet holding AL)
  let int_idx: int = 0;
  let float_idx: int = 0;
  let stack_slot: int = 0;
  let k: int = 0;
  while k < n {
    if type_flags[k] == 1 {
      if float_idx < 8 {
        float_idx = float_idx + 1;
      } else {
        off = emit_mov_r64_imm64(buf, off, REG_RAX, args[k]);
        off = emit_movq_xmm_r64(buf, off, REG_XMM0, REG_RAX);
        off = emit_movsd_rsp_disp_xmm(buf, off, stack_slot * 8, REG_XMM0);
        stack_slot = stack_slot + 1;
      }
    } else {
      if int_idx < 6 {
        int_idx = int_idx + 1;
      } else {
        off = emit_mov_r64_imm64(buf, off, REG_RAX, args[k]);
        off = emit_mov_rsp_disp_r64(buf, off, stack_slot * 8, REG_RAX);
        stack_slot = stack_slot + 1;
      }
    }
    k = k + 1;
  }

  // Pass 2: register args
  int_idx = 0;
  float_idx = 0;
  k = 0;
  while k < n {
    if type_flags[k] == 1 {
      if float_idx < 8 {
        off = emit_mov_r64_imm64(buf, off, REG_RAX, args[k]);
        off = emit_movq_xmm_r64(buf, off, float_idx, REG_RAX);
        float_idx = float_idx + 1;
      }
    } else {
      if int_idx < 6 {
        off = emit_mov_r64_imm64(buf, off, int_regs[int_idx], args[k]);
        int_idx = int_idx + 1;
      }
    }
    k = k + 1;
  }

  // AL = number of XMM registers used (emitted LAST since RAX was scratch)
  off = emit_mov_r32_imm32(buf, off, REG_RAX, float_idx);

  return off;
}

// =========================================================================
//  Callee-saved register preservation
// =========================================================================

// Win64 callee-saved: RBX, RBP, RDI, RSI, R12, R13, R14, R15
// SysV callee-saved:  RBX, RBP, R12, R13, R14, R15

// Push a list of callee-saved registers. Call AFTER push rbp but BEFORE
// sub rsp (the pushes shift RSP, and the frame size calculation must
// account for them). Returns new offset.
routine abi_emit_save_callee_regs(buf: any, offset: int, regs: any) -> int {
  let off: any = offset;
  let i: int = 0;
  while i < len(regs) {
    off = emit_push_r64(buf, off, regs[i]);
    i = i + 1;
  }
  return off;
}

// Pop callee-saved registers in REVERSE order. Call AFTER add rsp / mov rsp,rbp
// but BEFORE pop rbp and ret.
routine abi_emit_restore_callee_regs(buf: any, offset: int, regs: any) -> int {
  let off: any = offset;
  let i: int = len(regs) - 1;
  while i >= 0 {
    off = emit_pop_r64(buf, off, regs[i]);
    i = i - 1;
  }
  return off;
}

// =========================================================================
//  Struct return (hidden pointer parameter)
// =========================================================================

// Win64: large struct return (>8 bytes) uses a hidden first parameter.
// Caller allocates buffer, passes address in RCX. All other params shift
// right by one slot: RDX=param0, R8=param1, R9=param2, stack=param3+.

// Home the hidden return pointer from RCX to [RBP-32].
routine abi_emit_home_sret_win64(buf: any, offset: int) -> int {
  return emit_mov_base_disp_r64(buf, offset, REG_RBP, -32, REG_RCX);
}

// Home shifted params for Win64 struct return.
// RDX=param0, R8=param1, R9=param2. Params 3+ come from caller stack.
routine abi_emit_home_sret_params_win64(buf: any, offset: int, num_params: int) -> int {
  let off: any = offset;
  if num_params > 0 {
    off = emit_mov_base_disp_r64(buf, off, REG_RBP, -40, REG_RDX);
  }
  if num_params > 1 {
    off = emit_mov_base_disp_r64(buf, off, REG_RBP, -48, REG_R8);
  }
  if num_params > 2 {
    off = emit_mov_base_disp_r64(buf, off, REG_RBP, -56, REG_R9);
  }
  // Params 3+ arrive on caller stack at [RBP+48+(p-3)*8]
  let p: int = 3;
  while p < num_params {
    off = emit_mov_r64_base_disp(buf, off, REG_RAX, REG_RBP, 48 + (p - 3) * 8);
    off = emit_mov_base_disp_r64(buf, off, REG_RBP, abi_param_offset(p), REG_RAX);
    p = p + 1;
  }
  return off;
}

// SysV: large struct return uses a hidden first parameter in RDI.
// All other int params shift: RSI=param0, RDX=param1, RCX=param2,
// R8=param3, R9=param4. Float params still use independent XMM counter.
routine abi_emit_home_sret_sysv(buf: any, offset: int) -> int {
  return emit_mov_base_disp_r64(buf, offset, REG_RBP, -32, REG_RDI);
}

routine abi_emit_home_sret_params_sysv(buf: any, offset: int, num_params: int) -> int {
  let off: any = offset;
  if num_params > 0 {
    off = emit_mov_base_disp_r64(buf, off, REG_RBP, -40, REG_RSI);
  }
  if num_params > 1 {
    off = emit_mov_base_disp_r64(buf, off, REG_RBP, -48, REG_RDX);
  }
  if num_params > 2 {
    off = emit_mov_base_disp_r64(buf, off, REG_RBP, -56, REG_RCX);
  }
  if num_params > 3 {
    off = emit_mov_base_disp_r64(buf, off, REG_RBP, -64, REG_R8);
  }
  if num_params > 4 {
    off = emit_mov_base_disp_r64(buf, off, REG_RBP, -72, REG_R9);
  }
  // Params 5+ arrive on stack at [RBP+16+(p-5)*8]
  let p: int = 5;
  while p < num_params {
    off = emit_mov_r64_base_disp(buf, off, REG_RAX, REG_RBP, 16 + (p - 5) * 8);
    off = emit_mov_base_disp_r64(buf, off, REG_RBP, abi_param_offset(p), REG_RAX);
    p = p + 1;
  }
  return off;
}

// =========================================================================
//  Float return helpers
// =========================================================================

// Store XMM0 (float return value) to a stack slot at [RBP+disp]
routine abi_emit_store_float_return(buf: any, offset: int, rbp_disp: int) -> int {
  return emit_movsd_mem_xmm(buf, offset, REG_RBP, rbp_disp, REG_XMM0);
}

// Load a stack slot at [RBP+disp] into XMM0 for float return
routine abi_emit_load_float_return(buf: any, offset: int, rbp_disp: int) -> int {
  return emit_movsd_xmm_mem(buf, offset, REG_XMM0, REG_RBP, rbp_disp);
}
