// win_runtime.lvm -- Win64 platform runtime
//
// Win64-specific runtime: kernel32/msvcrt imports, process entry/exit,
// heap allocation, console I/O, command line access, SEH exception
// handling, DLL entry point.

import "runtime.lvm";

// ---------------------------------------------------------------------------
// Platform imports
// ---------------------------------------------------------------------------

routine RT_EmitImports() {
  // Process lifecycle
  mirImport("ExitProcess");
  mirProto("p_ExitProcess", ["void"], ["i32:uExitCode"]);

  // Console I/O
  mirImport("printf");
  mirProto("p_printf", ["void"], ["p:fmt"]);
}

// ---------------------------------------------------------------------------
// RT_Halt -- terminate process with exit code
// ---------------------------------------------------------------------------

routine RT_Halt(exitcode: int) {
  mirInsn("call", "p_ExitProcess", "ExitProcess", "_", exitcode);
}

// ---------------------------------------------------------------------------
// Compile-time helpers for print/println
// Called from emitters to emit printf calls with correct arguments
// ---------------------------------------------------------------------------

routine rt_write(str_name: string) {
  mirInsn("call", "p_printf", "printf", "_", str_name);
}

routine rt_writeln(str_name: string) {
  mirInsn("call", "p_printf", "printf", "_", str_name);
}

// ---------------------------------------------------------------------------
// DLL-to-import mapping for mir{} on-handlers
// ---------------------------------------------------------------------------

routine RT_GetDll(func_name: string) -> string {
  if func_name == "printf" { return "msvcrt.dll"; }
  return "kernel32.dll";
}
