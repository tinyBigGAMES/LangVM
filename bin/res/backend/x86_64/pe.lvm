 ------------------------------------------------------------------------------
 myrissa_pe.lvm -- PE64 image writer

 Writes valid Win64 PE executables from machine code buffers.
 Reference: src_old2/Myrissa.Backend.Image.Win64.pas
*******************************************************************************/

// -------------------------------------------------------------------------
//  PE constants (from PE/COFF spec, verified against src_old2 reference)
// -------------------------------------------------------------------------
const {
  // Signatures
  IMAGE_DOS_SIGNATURE = 0x5A4D;
  IMAGE_NT_SIGNATURE  = 0x00004550;

  // File characteristics
  IMAGE_FILE_EXECUTABLE_IMAGE  = 0x0002;
  IMAGE_FILE_LARGE_ADDRESS_AWARE = 0x0020;

  // Optional header magic
  PE32PLUS_MAGIC = 0x020B;

  // Subsystem
  IMAGE_SUBSYSTEM_WINDOWS_CUI = 3;
  IMAGE_SUBSYSTEM_WINDOWS_GUI = 2;

  // DLL characteristics
  IMAGE_DLLCHARACTERISTICS_NX_COMPAT = 0x0100;
  IMAGE_DLLCHARACTERISTICS_TERMINAL_SERVER_AWARE = 0x8000;

  // Section characteristics
  IMAGE_SCN_CNT_CODE             = 0x00000020;
  IMAGE_SCN_CNT_INITIALIZED_DATA = 0x00000040;
  IMAGE_SCN_MEM_EXECUTE          = 0x20000000;
  IMAGE_SCN_MEM_READ             = 0x40000000;
  IMAGE_SCN_MEM_WRITE            = 0x80000000;

  // File characteristics (additional)
  IMAGE_FILE_DLL = 0x2000;

  // DLL characteristics (additional)
  IMAGE_DLLCHARACTERISTICS_HIGH_ENTROPY_VA = 0x0020;
  IMAGE_DLLCHARACTERISTICS_DYNAMIC_BASE    = 0x0040;

  // Data directory indices
  IMAGE_DIRECTORY_ENTRY_EXPORT    = 0;
  IMAGE_DIRECTORY_ENTRY_IMPORT    = 1;
  IMAGE_DIRECTORY_ENTRY_EXCEPTION = 3;
  IMAGE_DIRECTORY_ENTRY_BASERELOC = 5;
  IMAGE_DIRECTORY_ENTRY_IAT       = 12;

  // Alignment defaults
  PE_FILE_ALIGNMENT    = 512;
  PE_SECTION_ALIGNMENT = 4096;
  PE_IMAGE_BASE        = 0x00400000;

  // Structure sizes
  DOS_HEADER_SIZE      = 64;
  DOS_STUB_SIZE        = 64;
  PE_SIGNATURE_SIZE    = 4;
  COFF_HEADER_SIZE     = 20;
  OPTIONAL_HEADER_SIZE = 240;
  SECTION_HEADER_SIZE  = 40;
  IMPORT_DESC_SIZE     = 20;
  DATA_DIR_ENTRIES     = 16;
}

// -------------------------------------------------------------------------
//  Helper: align value up to boundary
// -------------------------------------------------------------------------
routine pe_align_up(value: int, align: int) -> int {
  if align == 0 { return value; }
  let rem: int = value % align;
  if rem == 0 { return value; }
  return value + (align - rem);
}

// -------------------------------------------------------------------------
//  Helper: pad buffer to alignment boundary with zeros
// -------------------------------------------------------------------------
routine pe_pad_to(buf: any, align: int) {
  let size: int = bufSize(buf);
  let target: int = pe_align_up(size, align);
  let i: any = size;
  while i < target {
    bufWriteU8(buf, i, 0);
    i = i + 1;
  }
}

// -------------------------------------------------------------------------
//  Helper: write null-terminated ASCII string to buffer at offset
//  Returns new offset after the string + null byte
// -------------------------------------------------------------------------
routine pe_write_string(buf: any, offset: int, str: string) -> int {
  let i: int = 0;
  let slen: int = len(str);
  while i < slen {
    bufWriteU8(buf, offset + i, charOrd(charAt(str, i)));
    i = i + 1;
  }
  bufWriteU8(buf, offset + slen, 0);
  return offset + slen + 1;
}

// -------------------------------------------------------------------------
//  Helper: write section name (8 bytes, zero-padded)
// -------------------------------------------------------------------------
routine pe_write_section_name(buf: any, offset: int, name: string) {
  let i: int = 0;
  let slen: int = len(name);
  while i < 8 {
    if i < slen {
      bufWriteU8(buf, offset + i, charOrd(charAt(name, i)));
    } else {
      bufWriteU8(buf, offset + i, 0);
    }
    i = i + 1;
  }
}

// -------------------------------------------------------------------------
//  Build .edata section (PE export directory) from an ExportBuilder
//  Returns map: {"buf", "size", "dir_offset", "eat_offset", "npt_offset",
//                "ord_offset", "dll_name_offset", "names_offset"}
//  or nil if no exports.
// -------------------------------------------------------------------------
routine pe_build_edata(exports: any, dll_name: string) -> map {
  let num: int = eb_count(exports);
  if num == 0 { return nil; }

  eb_sort(exports);

  let buf: buffer = buffer(4096);
  let p: int = 0;

  // Export Directory Table (40 bytes)
  let dir_offset: any = p;
  bufWriteU32(buf, p + 0,  0);         // Characteristics
  bufWriteU32(buf, p + 4,  0);         // TimeDateStamp
  bufWriteU16(buf, p + 8,  0);         // MajorVersion
  bufWriteU16(buf, p + 10, 0);         // MinorVersion
  bufWriteU32(buf, p + 12, 0);         // Name RVA (placeholder)
  bufWriteU32(buf, p + 16, 1);         // Base ordinal
  bufWriteU32(buf, p + 20, num);       // NumberOfFunctions
  bufWriteU32(buf, p + 24, num);       // NumberOfNames
  bufWriteU32(buf, p + 28, 0);         // AddressOfFunctions (placeholder)
  bufWriteU32(buf, p + 32, 0);         // AddressOfNames (placeholder)
  bufWriteU32(buf, p + 36, 0);         // AddressOfNameOrdinals (placeholder)
  p = p + 40;

  // Export Address Table (EAT) -- placeholder RVAs
  let eat_offset: any = p;
  let i: int = 0;
  while i < num {
    bufWriteU32(buf, p, 0);
    p = p + 4;
    i = i + 1;
  }

  // Name Pointer Table -- placeholder RVAs
  let npt_offset: any = p;
  i = 0;
  while i < num {
    bufWriteU32(buf, p, 0);
    p = p + 4;
    i = i + 1;
  }

  // Ordinal Table
  let ord_offset: any = p;
  i = 0;
  while i < num {
    bufWriteU16(buf, p, i);
    p = p + 2;
    i = i + 1;
  }

  // DLL name string
  let dll_name_offset: any = p;
  p = pe_write_string(buf, p, dll_name);
  if p % 2 != 0 { bufWriteU8(buf, p, 0); p = p + 1; }

  // Export name strings
  let names_offset: any = p;
  i = 0;
  while i < num {
    let entry: any = eb_get(exports, i);
    p = pe_write_string(buf, p, entry.name);
    if p % 2 != 0 { bufWriteU8(buf, p, 0); p = p + 1; }
    i = i + 1;
  }

  // Pad to 16-byte alignment
  let aligned: int = pe_align_up(p, 16);
  while p < aligned {
    bufWriteU8(buf, p, 0);
    p = p + 1;
  }

  return {
    "buf": buf, "size": p,
    "dir_offset": dir_offset, "eat_offset": eat_offset,
    "npt_offset": npt_offset, "ord_offset": ord_offset,
    "dll_name_offset": dll_name_offset, "names_offset": names_offset
  };
}

// -------------------------------------------------------------------------
//  Fix .edata placeholders after section layout is determined
// -------------------------------------------------------------------------
routine pe_fixup_edata(edata: any, edata_rva: int, text_rva: int,
                       data_rva: int, exports: any) {
  let buf: any = edata.buf;
  let num: int = eb_count(exports);

  // Fix directory: Name RVA
  bufWriteU32(buf, edata.dir_offset + 12, edata_rva + edata.dll_name_offset);
  // Fix directory: AddressOfFunctions
  bufWriteU32(buf, edata.dir_offset + 28, edata_rva + edata.eat_offset);
  // Fix directory: AddressOfNames
  bufWriteU32(buf, edata.dir_offset + 32, edata_rva + edata.npt_offset);
  // Fix directory: AddressOfNameOrdinals
  bufWriteU32(buf, edata.dir_offset + 36, edata_rva + edata.ord_offset);

  // Fix EAT entries (function/global RVAs)
  let i: int = 0;
  while i < num {
    let entry: any = eb_get(exports, i);
    let rva: int = 0;
    if entry.kind == "func" {
      rva = text_rva + entry.offset;
    } else {
      rva = data_rva + entry.offset;
    }
    bufWriteU32(buf, edata.eat_offset + i * 4, rva);
    i = i + 1;
  }

  // Fix Name Pointer Table (name string RVAs)
  let name_rva: int = edata_rva + edata.names_offset;
  i = 0;
  while i < num {
    bufWriteU32(buf, edata.npt_offset + i * 4, name_rva);
    let entry: any = eb_get(exports, i);
    name_rva = name_rva + len(entry.name) + 1;
    if name_rva % 2 != 0 { name_rva = name_rva + 1; }
    i = i + 1;
  }
}

// -------------------------------------------------------------------------
//  Build minimal .reloc section (empty base relocation block)
//  Returns: {"buf": buffer, "size": int}
// -------------------------------------------------------------------------
routine pe_build_reloc() -> map {
  let buf: buffer = buffer(16);
  bufWriteU32(buf, 0, 0);  // VirtualAddress = 0
  bufWriteU32(buf, 4, 8);  // SizeOfBlock = 8 (header only, no entries)
  return {"buf": buf, "size": 8};
}

// -------------------------------------------------------------------------
//  Append minimal UNWIND_INFO to a CodeBuilder
//  Returns the offset where UNWIND_INFO was written
// -------------------------------------------------------------------------
routine pe_append_unwind_info(cb: any) -> int {
  // Align to 4 bytes
  while cb_get_pos(cb) % 4 != 0 {
    cb_emit_u8(cb, 0x90);
  }
  let unwind_off: int = cb_get_pos(cb);
  // UNWIND_INFO: Version=1, Flags=0 (UNW_FLAG_NHANDLER)
  cb_emit_u8(cb, 0x01);  // Version=1, Flags=0
  cb_emit_u8(cb, 0x00);  // SizeOfProlog = 0
  cb_emit_u8(cb, 0x00);  // CountOfCodes = 0
  cb_emit_u8(cb, 0x00);  // FrameRegister=0, FrameOffset=0
  return unwind_off;
}

// -------------------------------------------------------------------------
//  Build .pdata section for a single function spanning [0, code_size)
//  Returns: {"buf": buffer, "size": int}
// -------------------------------------------------------------------------
routine pe_build_pdata(code_size: int, unwind_off: int) -> map {
  let buf: buffer = buffer(12);
  bufWriteU32(buf, 0, 0);            // BeginAddress (fix to text_rva + 0)
  bufWriteU32(buf, 4, code_size);    // EndAddress (fix to text_rva + code_size)
  bufWriteU32(buf, 8, unwind_off);   // UnwindData (fix to text_rva + unwind_off)
  return {"buf": buf, "size": 12};
}

// -------------------------------------------------------------------------
//  Fix .pdata RVAs after section layout is determined
// -------------------------------------------------------------------------
routine pe_fixup_pdata(pdata: any, text_rva: int) {
  let buf: any = pdata.buf;
  let begin_val: int = bufReadU32(buf, 0);
  bufWriteU32(buf, 0, text_rva + begin_val);
  let end_val: int = bufReadU32(buf, 4);
  bufWriteU32(buf, 4, text_rva + end_val);
  let unwind_val: int = bufReadU32(buf, 8);
  bufWriteU32(buf, 8, text_rva + unwind_val);
}

// -------------------------------------------------------------------------
//  Unified PE64 image builder (exe/dll, GUI/CUI, exports, .pdata, .reloc)
//
//  cfg map fields:
//    code_buf, code_size, entry_off    -- .text machine code
//    iat_fixups, dll_imports           -- import fixups
//    rdata_buf, rdata_size, data_fixups -- .rdata
//    wdata_buf, wdata_size, global_fixups -- .data
//    subsystem    -- IMAGE_SUBSYSTEM_WINDOWS_CUI or _GUI
//    output_type  -- "exe" or "dll"
//    exports      -- ExportBuilder (or nil)
//    dll_name     -- filename for .edata DLL name string
//
//  Returns: buffer containing the complete PE image
// -------------------------------------------------------------------------
routine pe_build_image(cfg: any) -> map {

  let code_buf: any = cfg.code_buf;
  let code_size: any = cfg.code_size;
  let entry_off: any = cfg.entry_off;
  let iat_fixups: any = cfg.iat_fixups;
  let dll_imports: any = cfg.dll_imports;
  let rdata_buf: any = cfg.rdata_buf;
  let rdata_size: any = cfg.rdata_size;
  let data_fixups: any = cfg.data_fixups;
  let wdata_buf: any = cfg.wdata_buf;
  let wdata_size: any = cfg.wdata_size;
  let global_fixups: any = cfg.global_fixups;
  let subsystem: any = cfg.subsystem;
  let output_type: any = cfg.output_type;
  let exports: any = cfg.exports;
  let dll_name_str: any = cfg.dll_name;

  let has_rdata: bool = rdata_buf != nil and rdata_size > 0;
  let has_wdata: bool = wdata_buf != nil and wdata_size > 0;
  let is_dll: bool = output_type == "dll";
  let has_exports: bool = exports != nil and eb_count(exports) > 0;
  let has_reloc: bool = not is_dll;

  // --- Phase 1: Build .idata section ---
  let idata: buffer = buffer(4096);
  let num_dlls: int = len(dll_imports);
  let has_imports: bool = num_dlls > 0;

  let total_imports: int = 0;
  let di: int = 0;
  while di < num_dlls {
    total_imports = total_imports + len(dll_imports[di][1]);
    di = di + 1;
  }

  let desc_size: int = (num_dlls + 1) * IMPORT_DESC_SIZE;

  let off: int = 0;
  let dj: int = 0;
  while dj <= num_dlls {
    bufWriteU32(idata, off, 0);
    bufWriteU32(idata, off + 4, 0);
    bufWriteU32(idata, off + 8, 0);
    bufWriteU32(idata, off + 12, 0);
    bufWriteU32(idata, off + 16, 0);
    off = off + IMPORT_DESC_SIZE;
    dj = dj + 1;
  }

  let dll_names_offset: any = off;
  let dll_name_offsets: list = [];
  di = 0;
  while di < num_dlls {
    listAppend(dll_name_offsets, off);
    off = pe_write_string(idata, off, dll_imports[di][0]);
    di = di + 1;
  }

  let hint_names_offset: any = off;
  let hint_name_offsets: list = [];
  di = 0;
  while di < num_dlls {
    let funcs: any = dll_imports[di][1];
    let fi: int = 0;
    while fi < len(funcs) {
      listAppend(hint_name_offsets, off);
      bufWriteU16(idata, off, 0);
      off = off + 2;
      off = pe_write_string(idata, off, funcs[fi]);
      if off % 2 != 0 {
        bufWriteU8(idata, off, 0);
        off = off + 1;
      }
      fi = fi + 1;
    }
    di = di + 1;
  }

  let iat_offset: any = off;
  let iat_slot_offsets: list = [];
  di = 0;
  let hint_idx: int = 0;
  while di < num_dlls {
    let funcs: any = dll_imports[di][1];
    let fi: int = 0;
    while fi < len(funcs) {
      listAppend(iat_slot_offsets, off);
      bufWriteU64(idata, off, 0);
      off = off + 8;
      fi = fi + 1;
      hint_idx = hint_idx + 1;
    }
    bufWriteU64(idata, off, 0);
    off = off + 8;
    di = di + 1;
  }

  let int_offset: any = off;
  di = 0;
  while di < num_dlls {
    let funcs: any = dll_imports[di][1];
    let fi: int = 0;
    while fi < len(funcs) {
      bufWriteU64(idata, off, 0);
      off = off + 8;
      fi = fi + 1;
    }
    bufWriteU64(idata, off, 0);
    off = off + 8;
    di = di + 1;
  }

  let idata_size: any = off;

  // --- Phase 1b: Build .edata section (if exports) ---
  let edata: any = nil;
  let edata_size: int = 0;
  if has_exports {
    edata = pe_build_edata(exports, dll_name_str);
    edata_size = edata.size;
  }

  // --- Phase 1c: Build .reloc section (exe only) ---
  let reloc: any = nil;
  let reloc_size: int = 0;
  if has_reloc {
    reloc = pe_build_reloc();
    reloc_size = reloc.size;
  }

  // --- Phase 1d: Build .pdata section ---
  let pdata: map = pe_build_pdata(code_size, 0);
  let pdata_size: any = pdata.size;

  // --- Phase 2: Calculate section layout ---
  // Sections: .text (always), .rdata (opt), .data (opt), .pdata (always),
  //           .idata (opt), .edata (opt), .reloc (opt)
  let num_sections: int = 2;  // .text + .pdata
  if has_imports { num_sections = num_sections + 1; }
  if has_rdata { num_sections = num_sections + 1; }
  if has_wdata { num_sections = num_sections + 1; }
  if has_exports { num_sections = num_sections + 1; }
  if has_reloc { num_sections = num_sections + 1; }

  let headers_size: int = DOS_HEADER_SIZE + DOS_STUB_SIZE + PE_SIGNATURE_SIZE
                   + COFF_HEADER_SIZE + OPTIONAL_HEADER_SIZE
                   + (SECTION_HEADER_SIZE * num_sections);
  headers_size = pe_align_up(headers_size, PE_FILE_ALIGNMENT);

  // .text
  let text_rva: int = pe_align_up(headers_size, PE_SECTION_ALIGNMENT);
  let text_file_size: int = pe_align_up(code_size, PE_FILE_ALIGNMENT);

  // .rdata
  let rdata_rva: int = 0;
  let rdata_file_size: int = 0;
  if has_rdata {
    rdata_rva = text_rva + pe_align_up(code_size, PE_SECTION_ALIGNMENT);
    rdata_file_size = pe_align_up(rdata_size, PE_FILE_ALIGNMENT);
  }

  // .data
  let wdata_rva: int = 0;
  let wdata_file_size: int = 0;
  if has_wdata {
    if has_rdata {
      wdata_rva = rdata_rva + pe_align_up(rdata_size, PE_SECTION_ALIGNMENT);
    } else {
      wdata_rva = text_rva + pe_align_up(code_size, PE_SECTION_ALIGNMENT);
    }
    wdata_file_size = pe_align_up(wdata_size, PE_FILE_ALIGNMENT);
  }

  // .pdata -- follows last of .text/.rdata/.data
  let pdata_rva: int = text_rva + pe_align_up(code_size, PE_SECTION_ALIGNMENT);
  if has_rdata {
    pdata_rva = rdata_rva + pe_align_up(rdata_size, PE_SECTION_ALIGNMENT);
  }
  if has_wdata {
    pdata_rva = wdata_rva + pe_align_up(wdata_size, PE_SECTION_ALIGNMENT);
  }
  let pdata_file_size: int = pe_align_up(pdata_size, PE_FILE_ALIGNMENT);

  // .idata -- follows .pdata (if imports present)
  let idata_rva: int = 0;
  let idata_file_size: int = 0;
  let next_rva: int = pdata_rva + pe_align_up(pdata_size, PE_SECTION_ALIGNMENT);
  if has_imports {
    idata_rva = next_rva;
    idata_file_size = pe_align_up(idata_size, PE_FILE_ALIGNMENT);
    next_rva = idata_rva + pe_align_up(idata_size, PE_SECTION_ALIGNMENT);
  }

  // .edata -- follows .idata or .pdata (if exports present)
  let edata_rva: int = 0;
  let edata_file_size: int = 0;
  if has_exports {
    edata_rva = next_rva;
    edata_file_size = pe_align_up(edata_size, PE_FILE_ALIGNMENT);
    next_rva = edata_rva + pe_align_up(edata_size, PE_SECTION_ALIGNMENT);
  }

  // .reloc -- follows last optional section (if present)
  let reloc_rva: int = 0;
  let reloc_file_size: int = 0;
  if has_reloc {
    reloc_rva = next_rva;
    reloc_file_size = pe_align_up(reloc_size, PE_FILE_ALIGNMENT);
    next_rva = reloc_rva + pe_align_up(reloc_size, PE_SECTION_ALIGNMENT);
  }

  // SizeOfImage = end of last section (virtual)
  let size_of_image: any = next_rva;

  let entry_point_rva: int = text_rva + entry_off;

  // --- Phase 3: Fix import descriptors ---
  di = 0;
  let iat_cursor: any = iat_offset;
  let int_cursor: any = int_offset;
  while di < num_dlls {
    let desc_off2: int = di * IMPORT_DESC_SIZE;
    let num_funcs: int = len(dll_imports[di][1]);
    bufWriteU32(idata, desc_off2 + 0, idata_rva + int_cursor);
    bufWriteU32(idata, desc_off2 + 12, idata_rva + dll_name_offsets[di]);
    bufWriteU32(idata, desc_off2 + 16, idata_rva + iat_cursor);
    iat_cursor = iat_cursor + (num_funcs + 1) * 8;
    int_cursor = int_cursor + (num_funcs + 1) * 8;
    di = di + 1;
  }

  // Fix IAT entries
  let slot_idx: int = 0;
  while slot_idx < len(iat_slot_offsets) {
    bufWriteU64(idata, iat_slot_offsets[slot_idx],
                idata_rva + hint_name_offsets[slot_idx]);
    slot_idx = slot_idx + 1;
  }

  // Fix INT entries
  slot_idx = 0;
  di = 0;
  let int_write: any = int_offset;
  let hni: int = 0;
  while di < num_dlls {
    let funcs: any = dll_imports[di][1];
    let fi: int = 0;
    while fi < len(funcs) {
      bufWriteU64(idata, int_write, idata_rva + hint_name_offsets[hni]);
      int_write = int_write + 8;
      hni = hni + 1;
      fi = fi + 1;
    }
    int_write = int_write + 8;
    di = di + 1;
  }

  // --- Phase 4: Fix code relocations ---
  // IAT fixups
  let fxi: int = 0;
  while fxi < len(iat_fixups) {
    let code_off: any = iat_fixups[fxi][0];
    let iat_idx: any = iat_fixups[fxi][1];
    let iat_slot_rva: int = idata_rva + iat_slot_offsets[iat_idx];
    let instr_rva: int = text_rva + code_off;
    let disp: int = iat_slot_rva - (instr_rva + 6);
    bufWriteU32(code_buf, code_off + 2, band(disp, 0xFFFFFFFF));
    fxi = fxi + 1;
  }

  // Rdata fixups
  if has_rdata {
    let dfi: int = 0;
    while dfi < len(data_fixups) {
      let code_off: any = data_fixups[dfi][0];
      let rdata_off2: any = data_fixups[dfi][1];
      let target_rva: int = rdata_rva + rdata_off2;
      let instr_rva: int = text_rva + code_off;
      let rip_after: int = instr_rva + 7;
      let disp: int = target_rva - rip_after;
      bufWriteU32(code_buf, code_off + 3, band(disp, 0xFFFFFFFF));
      dfi = dfi + 1;
    }
  }

  // Global (.data) fixups
  if has_wdata {
    let gfi: int = 0;
    while gfi < len(global_fixups) {
      let code_off: any = global_fixups[gfi][0];
      let wdata_off: any = global_fixups[gfi][1];
      let target_rva: int = wdata_rva + wdata_off;
      let instr_rva: int = text_rva + code_off;
      let rip_after: int = instr_rva + 7;
      let disp: int = target_rva - rip_after;
      bufWriteU32(code_buf, code_off + 3, band(disp, 0xFFFFFFFF));
      gfi = gfi + 1;
    }
  }

  // --- Phase 4b: Fix .pdata RVAs ---
  pe_fixup_pdata(pdata, text_rva);

  // --- Phase 4c: Fix .edata RVAs ---
  if has_exports {
    pe_fixup_edata(edata, edata_rva, text_rva, wdata_rva, exports);
  }

  // --- Phase 5: Assemble PE image ---
  let image_size: int = headers_size + text_file_size + idata_file_size
                 + pdata_file_size;
  if has_rdata { image_size = image_size + rdata_file_size; }
  if has_wdata { image_size = image_size + wdata_file_size; }
  if has_exports { image_size = image_size + edata_file_size; }
  if has_reloc { image_size = image_size + reloc_file_size; }
  let image: buffer = buffer(image_size);

  // DOS Header
  let p: int = 0;
  bufWriteU16(image, p, IMAGE_DOS_SIGNATURE);
  bufWriteU16(image, p + 2, 0x0090);
  bufWriteU16(image, p + 4, 0x0003);
  bufWriteU16(image, p + 8, 0x0004);
  bufWriteU16(image, p + 12, 0xFFFF);
  bufWriteU16(image, p + 16, 0x00B8);
  bufWriteU16(image, p + 24, 0x0040);
  bufWriteU32(image, p + 60, 0x80);
  p = DOS_HEADER_SIZE;

  // DOS stub
  let stub: list = [0x0E, 0x1F, 0xBA, 0x0E, 0x00, 0xB4, 0x09, 0xCD,
              0x21, 0xB8, 0x01, 0x4C, 0xCD, 0x21, 0x54, 0x68,
              0x69, 0x73, 0x20, 0x70, 0x72, 0x6F, 0x67, 0x72,
              0x61, 0x6D, 0x20, 0x63, 0x61, 0x6E, 0x6E, 0x6F,
              0x74, 0x20, 0x62, 0x65, 0x20, 0x72, 0x75, 0x6E,
              0x20, 0x69, 0x6E, 0x20, 0x44, 0x4F, 0x53, 0x20,
              0x6D, 0x6F, 0x64, 0x65, 0x2E, 0x0D, 0x0D, 0x0A,
              0x24, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00];
  let si: int = 0;
  while si < 64 {
    bufWriteU8(image, p + si, stub[si]);
    si = si + 1;
  }
  p = p + DOS_STUB_SIZE;

  // PE Signature
  bufWriteU32(image, p, IMAGE_NT_SIGNATURE);
  p = p + PE_SIGNATURE_SIZE;

  // COFF File Header
  bufWriteU16(image, p + 0, IMAGE_FILE_MACHINE_AMD64);
  bufWriteU16(image, p + 2, num_sections);
  bufWriteU32(image, p + 4, 0);
  bufWriteU32(image, p + 8, 0);
  bufWriteU32(image, p + 12, 0);
  bufWriteU16(image, p + 16, OPTIONAL_HEADER_SIZE);
  let file_chars: int = bor(IMAGE_FILE_EXECUTABLE_IMAGE, IMAGE_FILE_LARGE_ADDRESS_AWARE);
  if is_dll { file_chars = bor(file_chars, IMAGE_FILE_DLL); }
  bufWriteU16(image, p + 18, file_chars);
  p = p + COFF_HEADER_SIZE;

  // Optional Header PE32+
  let opt_start: any = p;
  let init_data_size: int = idata_file_size + pdata_file_size;
  if has_rdata { init_data_size = init_data_size + rdata_file_size; }
  if has_wdata { init_data_size = init_data_size + wdata_file_size; }
  if has_exports { init_data_size = init_data_size + edata_file_size; }
  if has_reloc { init_data_size = init_data_size + reloc_file_size; }
  bufWriteU16(image, p + 0, PE32PLUS_MAGIC);
  bufWriteU8(image, p + 2, 1);
  bufWriteU8(image, p + 3, 0);
  bufWriteU32(image, p + 4, text_file_size);
  bufWriteU32(image, p + 8, init_data_size);
  bufWriteU32(image, p + 12, 0);
  bufWriteU32(image, p + 16, entry_point_rva);
  bufWriteU32(image, p + 20, text_rva);
  bufWriteU64(image, p + 24, PE_IMAGE_BASE);
  bufWriteU32(image, p + 32, PE_SECTION_ALIGNMENT);
  bufWriteU32(image, p + 36, PE_FILE_ALIGNMENT);
  bufWriteU16(image, p + 40, 6);
  bufWriteU16(image, p + 42, 0);
  bufWriteU16(image, p + 44, 6);
  bufWriteU16(image, p + 46, 0);
  bufWriteU16(image, p + 48, 6);
  bufWriteU16(image, p + 50, 0);
  bufWriteU32(image, p + 56, size_of_image);
  bufWriteU32(image, p + 60, headers_size);
  bufWriteU16(image, p + 68, subsystem);

  // DllCharacteristics
  let dll_chars: int = bor(IMAGE_DLLCHARACTERISTICS_NX_COMPAT,
                      IMAGE_DLLCHARACTERISTICS_TERMINAL_SERVER_AWARE);
  if has_reloc {
    dll_chars = bor(dll_chars, bor(IMAGE_DLLCHARACTERISTICS_DYNAMIC_BASE,
                                    IMAGE_DLLCHARACTERISTICS_HIGH_ENTROPY_VA));
  }
  bufWriteU16(image, p + 70, dll_chars);

  bufWriteU64(image, p + 72, 0x100000);
  bufWriteU64(image, p + 80, 0x1000);
  bufWriteU64(image, p + 88, 0x100000);
  bufWriteU64(image, p + 96, 0x1000);
  bufWriteU32(image, p + 108, DATA_DIR_ENTRIES);

  // Data directories
  let dd_base: int = p + 112;

  // Export directory
  if has_exports {
    bufWriteU32(image, dd_base + IMAGE_DIRECTORY_ENTRY_EXPORT * 8, edata_rva);
    bufWriteU32(image, dd_base + IMAGE_DIRECTORY_ENTRY_EXPORT * 8 + 4, edata_size);
  }

  // Import directory
  if has_imports {
    bufWriteU32(image, dd_base + IMAGE_DIRECTORY_ENTRY_IMPORT * 8, idata_rva);
    bufWriteU32(image, dd_base + IMAGE_DIRECTORY_ENTRY_IMPORT * 8 + 4,
                (num_dlls + 1) * IMPORT_DESC_SIZE);
  }

  // Exception directory (.pdata)
  bufWriteU32(image, dd_base + IMAGE_DIRECTORY_ENTRY_EXCEPTION * 8, pdata_rva);
  bufWriteU32(image, dd_base + IMAGE_DIRECTORY_ENTRY_EXCEPTION * 8 + 4, pdata_size);

  // Base relocation directory
  if has_reloc {
    bufWriteU32(image, dd_base + IMAGE_DIRECTORY_ENTRY_BASERELOC * 8, reloc_rva);
    bufWriteU32(image, dd_base + IMAGE_DIRECTORY_ENTRY_BASERELOC * 8 + 4, reloc_size);
  }

  // IAT directory
  if has_imports {
    bufWriteU32(image, dd_base + IMAGE_DIRECTORY_ENTRY_IAT * 8,
                idata_rva + iat_offset);
    bufWriteU32(image, dd_base + IMAGE_DIRECTORY_ENTRY_IAT * 8 + 4,
                int_offset - iat_offset);
  }

  p = opt_start + OPTIONAL_HEADER_SIZE;

  // --- Section Headers ---
  let file_pos: any = headers_size;

  // .text
  pe_write_section_name(image, p, ".text");
  bufWriteU32(image, p + 8, code_size);
  bufWriteU32(image, p + 12, text_rva);
  bufWriteU32(image, p + 16, text_file_size);
  bufWriteU32(image, p + 20, file_pos);
  bufWriteU32(image, p + 36, bor(bor(IMAGE_SCN_CNT_CODE, IMAGE_SCN_MEM_EXECUTE),
                                  IMAGE_SCN_MEM_READ));
  p = p + SECTION_HEADER_SIZE;
  file_pos = file_pos + text_file_size;

  // .rdata
  if has_rdata {
    pe_write_section_name(image, p, ".rdata");
    bufWriteU32(image, p + 8, rdata_size);
    bufWriteU32(image, p + 12, rdata_rva);
    bufWriteU32(image, p + 16, rdata_file_size);
    bufWriteU32(image, p + 20, file_pos);
    bufWriteU32(image, p + 36, bor(IMAGE_SCN_CNT_INITIALIZED_DATA, IMAGE_SCN_MEM_READ));
    p = p + SECTION_HEADER_SIZE;
    file_pos = file_pos + rdata_file_size;
  }

  // .data
  if has_wdata {
    pe_write_section_name(image, p, ".data");
    bufWriteU32(image, p + 8, wdata_size);
    bufWriteU32(image, p + 12, wdata_rva);
    bufWriteU32(image, p + 16, wdata_file_size);
    bufWriteU32(image, p + 20, file_pos);
    bufWriteU32(image, p + 36, bor(bor(IMAGE_SCN_CNT_INITIALIZED_DATA, IMAGE_SCN_MEM_READ),
                                    IMAGE_SCN_MEM_WRITE));
    p = p + SECTION_HEADER_SIZE;
    file_pos = file_pos + wdata_file_size;
  }

  // .pdata
  pe_write_section_name(image, p, ".pdata");
  bufWriteU32(image, p + 8, pdata_size);
  bufWriteU32(image, p + 12, pdata_rva);
  bufWriteU32(image, p + 16, pdata_file_size);
  bufWriteU32(image, p + 20, file_pos);
  bufWriteU32(image, p + 36, bor(IMAGE_SCN_CNT_INITIALIZED_DATA, IMAGE_SCN_MEM_READ));
  p = p + SECTION_HEADER_SIZE;
  file_pos = file_pos + pdata_file_size;

  // .idata
  if has_imports {
    pe_write_section_name(image, p, ".idata");
    bufWriteU32(image, p + 8, idata_size);
    bufWriteU32(image, p + 12, idata_rva);
    bufWriteU32(image, p + 16, idata_file_size);
    bufWriteU32(image, p + 20, file_pos);
    bufWriteU32(image, p + 36, bor(bor(IMAGE_SCN_CNT_INITIALIZED_DATA, IMAGE_SCN_MEM_READ),
                                    IMAGE_SCN_MEM_WRITE));
    p = p + SECTION_HEADER_SIZE;
    file_pos = file_pos + idata_file_size;
  }

  // .edata
  if has_exports {
    pe_write_section_name(image, p, ".edata");
    bufWriteU32(image, p + 8, edata_size);
    bufWriteU32(image, p + 12, edata_rva);
    bufWriteU32(image, p + 16, edata_file_size);
    bufWriteU32(image, p + 20, file_pos);
    bufWriteU32(image, p + 36, bor(IMAGE_SCN_CNT_INITIALIZED_DATA, IMAGE_SCN_MEM_READ));
    p = p + SECTION_HEADER_SIZE;
    file_pos = file_pos + edata_file_size;
  }

  // .reloc
  if has_reloc {
    pe_write_section_name(image, p, ".reloc");
    bufWriteU32(image, p + 8, reloc_size);
    bufWriteU32(image, p + 12, reloc_rva);
    bufWriteU32(image, p + 16, reloc_file_size);
    bufWriteU32(image, p + 20, file_pos);
    bufWriteU32(image, p + 36, bor(bor(IMAGE_SCN_CNT_INITIALIZED_DATA, IMAGE_SCN_MEM_READ),
                                    0x02000000));  // IMAGE_SCN_MEM_DISCARDABLE
    p = p + SECTION_HEADER_SIZE;
    file_pos = file_pos + reloc_file_size;
  }

  // --- Write section data ---
  let write_pos: any = headers_size;

  // .text
  bufCopyBytes(code_buf, 0, image, write_pos, code_size);
  write_pos = write_pos + text_file_size;

  // .rdata
  if has_rdata {
    bufCopyBytes(rdata_buf, 0, image, write_pos, rdata_size);
    write_pos = write_pos + rdata_file_size;
  }

  // .data
  if has_wdata {
    bufCopyBytes(wdata_buf, 0, image, write_pos, wdata_size);
    write_pos = write_pos + wdata_file_size;
  }

  // .pdata
  bufCopyBytes(pdata.buf, 0, image, write_pos, pdata_size);
  write_pos = write_pos + pdata_file_size;

  // .idata
  if has_imports {
    bufCopyBytes(idata, 0, image, write_pos, idata_size);
    write_pos = write_pos + idata_file_size;
  }

  // .edata
  if has_exports {
    bufCopyBytes(edata.buf, 0, image, write_pos, edata_size);
    write_pos = write_pos + edata_file_size;
  }

  // .reloc
  if has_reloc {
    bufCopyBytes(reloc.buf, 0, image, write_pos, reloc_size);
    write_pos = write_pos + reloc_file_size;
  }

  return image;
}


// -------------------------------------------------------------------------
//  Build a minimal PE64 console executable
//
//  code_buf:    buffer containing .text machine code
//  code_size:   bytes of actual code in code_buf
//  entry_off:   offset of entry point within code_buf
//  iat_fixups:  list of [code_offset, iat_index] pairs for CALL [RIP+disp] fixups
//  dll_imports: list of [dll_name, [func_name, ...]] pairs
//  rdata_buf:   buffer containing read-only data (or nil if none)
//  rdata_size:  byte count of rdata content (0 if none)
//  data_fixups: list of [code_offset, rdata_offset] pairs for LEA [RIP+disp32]
//  wdata_buf:   buffer containing writable data (mutable globals) (or nil if none)
//  wdata_size:  byte count of wdata content (0 if none)
//  global_fixups: list of [code_offset, wdata_offset] pairs for LEA [RIP+disp32]
//
//  Returns: buffer containing the complete PE image
// -------------------------------------------------------------------------
routine pe_build_exe(code_buf: any, code_size: int, entry_off: int,
                     iat_fixups: any, dll_imports: any,
                     rdata_buf: any, rdata_size: int, data_fixups: any,
                     wdata_buf: any, wdata_size: int, global_fixups: any) -> map {
  return pe_build_image({
    "code_buf": code_buf, "code_size": code_size, "entry_off": entry_off,
    "iat_fixups": iat_fixups, "dll_imports": dll_imports,
    "rdata_buf": rdata_buf, "rdata_size": rdata_size, "data_fixups": data_fixups,
    "wdata_buf": wdata_buf, "wdata_size": wdata_size, "global_fixups": global_fixups,
    "subsystem": IMAGE_SUBSYSTEM_WINDOWS_CUI,
    "output_type": "exe", "exports": nil, "dll_name": ""
  });
}
