 -----------------------------------------------------------------------------
 wasm_runtime.lvm -- WASI platform runtime for wasm64 backend

 WASI-specific runtime: fd_write/proc_exit imports, process exit,
 console I/O via fd_write, WASI module name mapping.
******************************************************************************/

import "wasm64.lvm";

// ---------------------------------------------------------------------------
// Platform imports
// ---------------------------------------------------------------------------

routine RT_EmitImports() {
  // WASI fd_write: (fd:i32, iovs:i64, iovs_len:i64, nwritten:i64) -> i32
  mirImport("fd_write");
  mirProto("p_fd_write", ["i32"], ["i32:fd", "i64:iovs", "i64:iovs_len", "i64:nwritten"]);

  // WASI proc_exit: (rval:i32) -> void
  mirImport("proc_exit");
  mirProto("p_proc_exit", ["void"], ["i32:rval"]);
}

// ---------------------------------------------------------------------------
// RT_Halt -- terminate process with exit code
// ---------------------------------------------------------------------------

routine RT_Halt(exitcode: int) {
  mirInsn("call", "p_proc_exit", "proc_exit", "_", exitcode);
}

// ---------------------------------------------------------------------------
// WASI module name for import section
// ---------------------------------------------------------------------------

routine RT_GetWasiModule() -> string {
  return "wasi_snapshot_preview1";
}
