 -----------------------------------------------------------------------------
 build.lvm -- wasm module assembler

 Assembles collected section data into a complete .wasm binary module.
 Uses memory64 (flag 0x04) for linear memory addressing.
 All temp buffers use the wb (write-buffer) pattern from encode.lvm.
******************************************************************************/

routine wasm_build_module(
  type_entries: list,
  import_entries: list,
  func_type_indices: list,
  mem_min_pages: int,
  export_entries: list,
  code_bodies: list,
  data_segments: list
) -> any {
  let out: any = wb_create(4096);

  // Magic: \0asm
  wasm_write_u8(out, 0x00);
  wasm_write_u8(out, 0x61);
  wasm_write_u8(out, 0x73);
  wasm_write_u8(out, 0x6D);
  // Version: 1
  wasm_write_u32_le(out, WASM_VERSION);

  // --- Type section ---
  if len(type_entries) > 0 {
    let tbuf: any = wb_create(256);
    wasm_encode_uleb128(tbuf, len(type_entries));
    let ti: int = 0;
    while ti < len(type_entries) {
      let te: map = type_entries[ti];
      wasm_write_u8(tbuf, TYPE_FUNC);
      let params: list = te["params"];
      wasm_encode_uleb128(tbuf, len(params));
      let pi: int = 0;
      while pi < len(params) {
        wasm_write_u8(tbuf, params[pi]);
        pi = pi + 1;
      }
      let results: list = te["results"];
      wasm_encode_uleb128(tbuf, len(results));
      let ri: int = 0;
      while ri < len(results) {
        wasm_write_u8(tbuf, results[ri]);
        ri = ri + 1;
      }
      ti = ti + 1;
    }
    wasm_write_section(out, SEC_TYPE, tbuf, wb_size(tbuf));
  }

  // --- Import section ---
  if len(import_entries) > 0 {
    let ibuf: any = wb_create(256);
    wasm_encode_uleb128(ibuf, len(import_entries));
    let ii: int = 0;
    while ii < len(import_entries) {
      let ie: map = import_entries[ii];
      wasm_encode_name(ibuf, ie["module"]);
      wasm_encode_name(ibuf, ie["name"]);
      wasm_write_u8(ibuf, IMPORT_FUNC);
      wasm_encode_uleb128(ibuf, ie["type_idx"]);
      ii = ii + 1;
    }
    wasm_write_section(out, SEC_IMPORT, ibuf, wb_size(ibuf));
  }

  // --- Function section ---
  if len(func_type_indices) > 0 {
    let fbuf: any = wb_create(64);
    wasm_encode_uleb128(fbuf, len(func_type_indices));
    let fi: int = 0;
    while fi < len(func_type_indices) {
      wasm_encode_uleb128(fbuf, func_type_indices[fi]);
      fi = fi + 1;
    }
    wasm_write_section(out, SEC_FUNCTION, fbuf, wb_size(fbuf));
  }

  // --- Memory section (memory64) ---
  let mbuf: any = wb_create(16);
  wasm_encode_uleb128(mbuf, 1);
  wasm_write_u8(mbuf, MEM_LIMITS_I64_NOMAX);
  wasm_encode_uleb128(mbuf, mem_min_pages);
  wasm_write_section(out, SEC_MEMORY, mbuf, wb_size(mbuf));

  // --- Export section ---
  if len(export_entries) > 0 {
    let ebuf: any = wb_create(128);
    wasm_encode_uleb128(ebuf, len(export_entries));
    let ei: int = 0;
    while ei < len(export_entries) {
      let ee: map = export_entries[ei];
      wasm_encode_name(ebuf, ee["name"]);
      wasm_write_u8(ebuf, ee["kind"]);
      wasm_encode_uleb128(ebuf, ee["idx"]);
      ei = ei + 1;
    }
    wasm_write_section(out, SEC_EXPORT, ebuf, wb_size(ebuf));
  }

  // --- Code section ---
  if len(code_bodies) > 0 {
    let cbuf: any = wb_create(1024);
    wasm_encode_uleb128(cbuf, len(code_bodies));
    let ci: int = 0;
    while ci < len(code_bodies) {
      let body: map = code_bodies[ci];
      let locals: list = body["locals"];
      let code_wb: any = body["code_wb"];
      let code_size: int = body["code_size"];

      // Build function body into temp buffer
      let fbody: any = wb_create(code_size + 64);
      wasm_encode_uleb128(fbody, len(locals));
      let li: int = 0;
      while li < len(locals) {
        let loc: map = locals[li];
        wasm_encode_uleb128(fbody, loc["count"]);
        wasm_write_u8(fbody, loc["type"]);
        li = li + 1;
      }
      bufCopyBytes(code_wb.buf, 0, fbody.buf, fbody.pos, code_size);
      fbody.pos = fbody.pos + code_size;

      // Write body size + body content
      wasm_encode_uleb128(cbuf, wb_size(fbody));
      bufCopyBytes(fbody.buf, 0, cbuf.buf, cbuf.pos, wb_size(fbody));
      cbuf.pos = cbuf.pos + wb_size(fbody);
      ci = ci + 1;
    }
    wasm_write_section(out, SEC_CODE, cbuf, wb_size(cbuf));
  }

  // --- Data section ---
  if len(data_segments) > 0 {
    let dbuf: any = wb_create(1024);
    wasm_encode_uleb128(dbuf, len(data_segments));
    let di: int = 0;
    while di < len(data_segments) {
      let seg: map = data_segments[di];
      // Active mode, memory 0
      wasm_write_u8(dbuf, 0x00);
      // Init expr: i64.const offset (memory64)
      wasm_emit_i64_const(dbuf, seg["offset"]);
      wasm_emit_end(dbuf);
      // Data bytes
      let seg_size: int = seg["data_size"];
      wasm_encode_uleb128(dbuf, seg_size);
      bufCopyBytes(seg["data_buf"], 0, dbuf.buf, dbuf.pos, seg_size);
      dbuf.pos = dbuf.pos + seg_size;
      di = di + 1;
    }
    wasm_write_section(out, SEC_DATA, dbuf, wb_size(dbuf));
  }

  return wb_to_buf(out);
}
