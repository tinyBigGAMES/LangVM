 runner.lvm -- HTML runner builder for wasm64 backend

 Builds a self-contained .html file that embeds the wasi64 shim and
 base64-encoded .wasm module. Opens in any browser with no server needed.
******************************************************************************/

routine wasm_build_html_runner(wasm_buf: any, mname: string) {
  let shim: string = loadTextFile("$P:res/backend/wasm64/runner/wasi64_shim.js");
  let tmpl: string = loadTextFile("$P:res/backend/wasm64/runner/index.html");
  let b64: string = bufToBase64(wasm_buf);
  let html: string = replace(tmpl, "__LANGVM_WASM_MODULE__", mname);
  html = replace(html, "__LANGVM_WASI64_SHIM__", shim);
  html = replace(html, "__LANGVM_WASM_BASE64__", b64);
  let html_path: string = getOutputPath() + "/" + mname + ".html";
  saveTextFile(html_path, html);
  status("Created ", resolvePath(html_path));
}
