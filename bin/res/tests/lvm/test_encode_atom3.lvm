/*
  Test: Atom 3 - Stack and basic mov instructions
*/

import "../../targets/x86_64-windows/common.lvm";
import "../../targets/x86_64-windows/encode.lvm";
import "../../targets/x86_64-windows/builders.lvm";

routine main() {
  let buf: any = buffer(256);
  let off: int = 0;

  // PUSH RBP -> 0x55
  off = emit_push_reg(buf, 0, REG_RBP);
  assert(bufReadU8(buf, 0) == 0x55, "PUSH RBP should be 0x55");
  assert(off == 1, "PUSH RBP is 1 byte");

  // PUSH R12 -> REX.B(0x41) + 0x54
  off = emit_push_reg(buf, off, REG_R12);
  assert(bufReadU8(buf, 1) == 0x41, "PUSH R12 REX prefix");
  assert(bufReadU8(buf, 2) == 0x54, "PUSH R12 opcode");

  // POP RBP -> 0x5D
  off = emit_pop_reg(buf, off, REG_RBP);
  assert(bufReadU8(buf, 3) == 0x5D, "POP RBP should be 0x5D");

  // MOV RBP, RSP -> REX.W(48) 89 E5 (src=RSP=4, dst=RBP=5)
  // ModRM: mod=11, reg=RSP(4), rm=RBP(5) -> 11 100 101 -> 0xE5
  off = emit_mov_reg_reg(buf, off, REG_RBP, REG_RSP);
  assert(bufReadU8(buf, 4) == 0x48, "MOV RBP,RSP REX");
  assert(bufReadU8(buf, 5) == 0x89, "MOV RBP,RSP opcode");
  assert(bufReadU8(buf, 6) == 0xE5, "MOV RBP,RSP ModRM");

  // RET -> 0xC3
  off = emit_ret(buf, off);
  assert(bufReadU8(buf, 7) == 0xC3, "RET should be 0xC3");

  // SUB RSP, 0x28 -> REX.W(48) 81 EC 28000000
  let sub_off: int = off;
  off = emit_sub_rsp_imm32(buf, off, 0x28);
  assert(bufReadU8(buf, sub_off) == 0x48, "SUB RSP REX");
  assert(bufReadU8(buf, sub_off + 1) == 0x81, "SUB RSP opcode");
  assert(bufReadU8(buf, sub_off + 2) == 0xEC, "SUB RSP ModRM");
  assert(bufReadU8(buf, sub_off + 3) == 0x28, "SUB RSP imm low");

  // MOV RAX, imm64 (0xDEADBEEFCAFEBABE)
  let mov64_off: int = off;
  off = emit_mov_reg_imm64(buf, off, REG_RAX, 0xDEADBEEFCAFEBABE);
  assert(bufReadU8(buf, mov64_off) == 0x48, "MOV RAX,imm64 REX");
  assert(bufReadU8(buf, mov64_off + 1) == 0xB8, "MOV RAX,imm64 opcode");
  assert(off - mov64_off == 10, "MOV reg,imm64 is 10 bytes");

  // MOV EAX, imm32 (0x42) -- no REX for reg < 8
  let mov32_off: int = off;
  off = emit_mov_reg_imm32(buf, off, REG_RAX, 0x42);
  assert(bufReadU8(buf, mov32_off) == 0xB8, "MOV EAX,imm32 opcode");
  assert(bufReadU8(buf, mov32_off + 1) == 0x42, "MOV EAX,imm32 imm low");
  assert(off - mov32_off == 5, "MOV reg32,imm32 is 5 bytes for reg<8");

  // NOP -> 0x90
  off = emit_nop(buf, off);
  assert(bufReadU8(buf, off - 1) == 0x90, "NOP should be 0x90");

  println("PASS: Atom 3 - all tests passed");
}
