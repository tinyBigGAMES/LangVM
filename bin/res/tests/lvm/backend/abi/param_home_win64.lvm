addImportPath("$P:res/backend/x86_64");
import "x86_64.lvm";

routine main() {
  let buf: buffer = buffer(128, true);
  let off: int = 0;
  off = abi_emit_home_params_win64(buf, off, 4);
  println("size:" + toString(off));
  // 4 MOV [RBP+disp32], reg instructions, each 7 bytes = 28
  println("ok");
  // First instruction: MOV [RBP-40], RCX
  // REX.W(0x48) 89 ModRM disp32
  let b0: int = bufReadU8(buf, 0);
  let b1: int = bufReadU8(buf, 1);
  println("home0:" + toString(b0) + "," + toString(b1));
  Result = {"size": off, "home0": toString(b0) + "," + toString(b1), "ok": true};
}
