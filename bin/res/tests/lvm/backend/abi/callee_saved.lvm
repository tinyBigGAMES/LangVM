addImportPath("$P:res/backend/x86_64");
import "x86_64.lvm";

routine main() {
  let buf: buffer = buffer(64, true);
  let off: int = 0;
  // Save RBX(3) and R12(12)
  let regs: list = [REG_RBX, REG_R12];
  off = abi_emit_save_callee_regs(buf, off, regs);
  let save_size: any = off;
  // PUSH RBX = 53 (1 byte), PUSH R12 = 41 54 (2 bytes) = 3 bytes
  println("save:" + toString(save_size));
  let b0: int = bufReadU8(buf, 0);
  let b1: int = bufReadU8(buf, 1);
  let b2: int = bufReadU8(buf, 2);
  println("push:" + toString(b0) + "," + toString(b1) + "," + toString(b2));

  // Restore (reverse order: POP R12, POP RBX)
  off = abi_emit_restore_callee_regs(buf, off, regs);
  let restore_size: int = off - save_size;
  println("restore:" + toString(restore_size));
  // POP R12 = 41 5C (2 bytes), POP RBX = 5B (1 byte) = 3 bytes
  let r0: int = bufReadU8(buf, save_size);
  let r1: int = bufReadU8(buf, save_size + 1);
  let r2: int = bufReadU8(buf, save_size + 2);
  println("pop:" + toString(r0) + "," + toString(r1) + "," + toString(r2));
  Result = {"save": save_size, "push": toString(b0) + "," + toString(b1) + "," + toString(b2), "restore": restore_size, "pop": toString(r0) + "," + toString(r1) + "," + toString(r2)};
}
