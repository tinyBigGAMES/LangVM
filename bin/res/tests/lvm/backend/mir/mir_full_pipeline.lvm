// =========================================================================
//  mir_full_pipeline.lvm -- Full frontend -> MIR -> backend pipeline proof
//
//  A tiny "say" language compiles to MIR using dynamic builtins,
//  then backend on-handlers lower MIR to x64 + PE.
//  Result: a PE exe that prints "hello\nworld\n" via printf.
// =========================================================================

language SayLang version "1.0";

addImportPath("$P:res/backend/x86_64");
import "x86_64.lvm";

tokens {
  casesensitive = true;
  token keyword.say = "say";
  token delimiter.semicolon = ";";
  token string.default = "\"";
  token comment.line = "//";
}

grammar {
  rule stmt.say {
    expect keyword.say;
    let text: string = currentText();
    advance();
    let nd: handle = getResultNode();
    setAttr(nd, "message", text);
    requireToken("delimiter.semicolon");
  }
}

semantics {
  on stmt.say {
    // no-op validation
  }
}

emitters {
  on stmt.say {
    let msg: string = getAttr(node, "message");
    // currentText() already strips quotes -- use directly
    let text: string = msg;
    // Add newline
    let text_nl: string = text + "\n";

    // Emit string data into MIR
    let str_name: string = "msg_" + toString(g_str_count);
    mirString(str_name, text_nl);
    g_str_count = g_str_count + 1;

    // Emit: call p_printf, printf, _, str_name
    mirInsn("call", "p_printf", "printf", "_", str_name);
  }
}

// --- MIR backend handlers (Win64 x86_64) ---
mir {
  on module {
    // Initialize import builder
    g_ib = ib_create();
    g_import_map = {};

    // Map imports to DLLs
    let dll_map: map = {
      "printf": "msvcrt.dll",
      "ExitProcess": "kernel32.dll"
    };

    let i: int = 0;
    while i < len(imports) {
      let fname: string = imports[i];
      let dll: string = dll_map[fname];
      let idx: int = ib_add(g_ib, dll, fname);
      g_import_map[fname] = idx;
      i = i + 1;
    }

    // Initialize code builder and data builder
    g_cb = cb_create(1024);
    g_db = db_create();
    g_str_map = {};
  }

  on string {
    // Store string in data builder, record name -> data entry index
    let h: int = db_add_string(g_db, value);
    g_str_map[name] = h;
  }

  on func {
    // Emit Win64 prologue: sub rsp, 0x28 (shadow space + alignment)
    cb_emit_sub_rsp_imm8(g_cb, 0x28);
  }

  on insn {
    if opcode == "call" {
      // operands: [proto, func, result, args...]
      let func_name: string = operands[1];

      // Win64 integer arg registers
      let int_regs: list = [REG_RCX, REG_RDX, REG_R8, REG_R9];
      let arg_idx: int = 0;
      let i: int = 3;
      while i < len(operands) {
        let val: any = operands[i];
        if isInt(val) {
          // Integer immediate -> mov reg, imm64
          cb_emit_mov_r64_imm64(g_cb, int_regs[arg_idx], val);
        } else if isString(val) {
          // String operand -- check if it's a data reference
          if val != "_" {
            // lea reg, [rip+disp32] for string data
            let data_idx: int = g_str_map[val];
            let data_off: int = db_get_offset(g_db, data_idx);
            let lea_off: int = cb_get_pos(g_cb);
            cb_emit_lea_rip_disp32(g_cb, int_regs[arg_idx]);
            cb_add_fixup_data(g_cb, lea_off, data_off);
          }
        }
        arg_idx = arg_idx + 1;
        i = i + 1;
      }

      // Emit call [rip+disp32] via IAT
      let func_idx: int = g_import_map[func_name];
      let call_off: int = cb_emit_call_rip_disp32(g_cb);
      cb_add_fixup_iat(g_cb, call_off, func_idx);
    }
  }

  on endfunc {
    // Emit epilogue: add rsp, 0x28; ret
    cb_emit_add_rsp_imm8(g_cb, 0x28);
    cb_emit_ret(g_cb);
  }

  on endmodule {
    // Build PE image with .rdata for strings
    let image: map = pe_build_exe(
      cb_get_buf(g_cb), cb_get_pos(g_cb), 0,
      cb_get_iat_fixups(g_cb), ib_to_imports(g_ib),
      db_get_buf(g_db), db_get_size(g_db), cb_get_data_fixups(g_cb),
      nil, 0, []);

    createDirsInPath(exe_path);
    bufSave(image, exe_path);
    ExitCode = runPE(exe_path);
  }
}

routine main() {
  // Shared state for handlers
  let exe_path: string = "$P:output/mir_full_pipeline.exe";
  let g_ib: any = nil;
  let g_cb: any = nil;
  let g_db: any = nil;
  let g_import_map: map = {};
  let g_str_map: map = {};
  let g_str_count: int = 0;

  // Build MIR programmatically
  mirBeginModule("app");
  mirImport("printf");
  mirImport("ExitProcess");
  mirProto("p_printf", ["void"], ["p:fmt"]);
  mirProto("p_ExitProcess", ["void"], ["i32:code"]);
  mirBeginFunc("main", ["void"], []);

  // Compile user source -- emitters produce MIR instructions via mirInsn/mirString
  let source: string = 'say "hello"; say "world";';
  let toks: any = lexSource(source, "test.say");
  let ast: any = parseProgram(toks, "test.say");
  runEmitters(ast);

  // Emit exit call and close function/module
  mirInsn("call", "p_ExitProcess", "ExitProcess", "_", 0);
  mirEndFunc();
  mirEndModule();

  // Lower MIR to native via on-handlers
  runMir();
}
