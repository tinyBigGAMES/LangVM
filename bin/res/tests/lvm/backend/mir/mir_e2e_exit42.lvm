// =========================================================================
//  mir_e2e_exit42.lvm -- End-to-end MIR pipeline proof
//
//  MIR program built via mirXXX builtins. Backend on-handlers lower MIR
//  events to x64 machine code using existing encode/PE infrastructure.
//  Result: a PE exe that calls ExitProcess(42).
// =========================================================================

language MirE2EExit42 version "1.0";

addImportPath("$P:res/backend/x86_64");
import "x86_64.lvm";

mir {
  // --- Backend: Win64 x86_64 lowering ---

  on module {
    // Initialize import builder from imports list
    g_ib = ib_create();
    g_import_map = {};
    let i: int = 0;
    while i < len(imports) {
      let idx: int = ib_add(g_ib, "kernel32.dll", imports[i]);
      g_import_map[imports[i]] = idx;
      i = i + 1;
    }

    // Initialize code builder
    g_cb = cb_create(256);
  }

  on func {
    // Emit Win64 prologue: sub rsp, 0x28 (shadow space + alignment)
    cb_emit_sub_rsp_imm8(g_cb, 0x28);
  }

  on insn {
    if opcode == "call" {
      // operands: [proto, func, result, args...]
      let func_name: string = operands[1];

      // Load integer args into Win64 registers (RCX, RDX, R8, R9)
      let int_regs: list = [REG_RCX, REG_RDX, REG_R8, REG_R9];
      let arg_idx: int = 0;
      let i: int = 3;
      while i < len(operands) {
        let val: any = operands[i];
        if isInt(val) {
          cb_emit_mov_r64_imm64(g_cb, int_regs[arg_idx], val);
        }
        arg_idx = arg_idx + 1;
        i = i + 1;
      }

      // Emit call [rip+disp32] via IAT
      let func_idx: int = g_import_map[func_name];
      let call_off: int = cb_emit_call_rip_disp32(g_cb);
      cb_add_fixup_iat(g_cb, call_off, func_idx);
    }
  }

  on endfunc {
    // Emit epilogue: add rsp, 0x28; ret
    cb_emit_add_rsp_imm8(g_cb, 0x28);
    cb_emit_ret(g_cb);
  }

  on endmodule {
    // Build PE image
    let image: map = pe_build_exe(
      cb_get_buf(g_cb), cb_get_pos(g_cb), 0,
      cb_get_iat_fixups(g_cb), ib_to_imports(g_ib),
      nil, 0, [],
      nil, 0, []);

    createDirsInPath(exe_path);
    bufSave(image, exe_path);
    ExitCode = runPE(exe_path);
  }
}

routine main() {
  let g_ib: any = nil;
  let g_cb: any = nil;
  let g_import_map: map = {};

  // Build MIR program via builtins
  mirBeginModule("app");
  mirImport("ExitProcess");
  mirProto("p_ExitProcess", ["void"], ["i32:uExitCode"]);
  mirBeginFunc("main", ["void"], []);
  mirInsn("call", "p_ExitProcess", "ExitProcess", "_", 42);
  mirEndFunc();
  mirEndModule();

  runMir();
}