routine main() {
  // 0xDEADBEEF -- high bit of 32-bit range set
  let val: int = 0xDEADBEEF;
  let hi16: int = band(shr(val, 16), 0xFFFF);
  let lo16: int = band(val, 0xFFFF);
  println("hi:" + toString(hi16));
  println("lo:" + toString(lo16));

  // Extract bytes from a value with bit 31 set
  let b3: int = band(shr(val, 24), 0xFF);
  let b2: int = band(shr(val, 16), 0xFF);
  let b1: int = band(shr(val, 8), 0xFF);
  let b0: int = band(val, 0xFF);
  println("bytes:" + toString(b3) + "," + toString(b2) + "," + toString(b1) + "," + toString(b0));

  // Write to buffer and read back to verify round-trip
  let buf: buffer = buffer(8);
  bufWriteU32(buf, 0, val);
  let readback: int = bufReadU32(buf, 0);
  println("rt:" + toString(readback));
  Result = {"hi": hi16, "lo": lo16, "bytes": toString(b3) + "," + toString(b2) + "," + toString(b1) + "," + toString(b0), "rt": readback};
}
