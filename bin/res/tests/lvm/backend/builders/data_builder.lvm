addImportPath("$P:res/backend/x86_64");
import "x86_64.lvm";

routine main() {
  let db: any = db_create();

  // Add a string
  let h0: int = db_add_string(db, "hello");
  println("h0=" + toString(h0));
  let _off0: int = db_get_offset(db, h0);
  println("off0=" + toString(_off0));

  // "hello" = 5 bytes + 1 null = 6 bytes, so size should be 6
  let _sz1: int = db_get_size(db);
  println("sz1=" + toString(_sz1));

  // Add an i32
  let h1: int = db_add_i32(db, 42);
  println("h1=" + toString(h1));
  let _off1: int = db_get_offset(db, h1);
  println("off1=" + toString(_off1));

  // Size should be 6 + 4 = 10
  let _sz2: int = db_get_size(db);
  println("sz2=" + toString(_sz2));

  // Add with alignment
  db_align(db, 8);
  // 10 -> pad to 16
  let _sz3: int = db_get_size(db);
  println("sz3=" + toString(_sz3));

  let h2: int = db_add_i64(db, 99);
  println("h2=" + toString(h2));
  let _off2: int = db_get_offset(db, h2);
  println("off2=" + toString(_off2));
  // 16 + 8 = 24
  let _sz4: int = db_get_size(db);
  println("sz4=" + toString(_sz4));
  Result = {"h0": h0, "off0": _off0, "sz1": _sz1, "h1": h1, "off1": _off1, "sz2": _sz2, "sz3": _sz3, "h2": h2, "off2": _off2, "sz4": _sz4};
}
