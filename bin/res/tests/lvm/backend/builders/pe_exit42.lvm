addImportPath("$P:res/backend/x86_64");
import "x86_64.lvm";

routine main() {
  let ib: any = ib_create();
  let idx_ep: int = ib_add(ib, "kernel32.dll", "ExitProcess");

  let cb: any = cb_create(64);

  // sub rsp, 0x28
  cb_emit_sub_rsp_imm8(cb, 0x28);

  // mov ecx, 42
  cb_emit_u8(cb, 0xB9);
  cb_emit_u32(cb, 42);

  // call [rip+disp32] -- ExitProcess
  let call_off: int = cb_get_pos(cb);
  cb_emit_call_rip_disp32(cb);
  cb_add_fixup_iat(cb, call_off, idx_ep);

  // int3
  cb_emit_u8(cb, 0xCC);

  // Build PE
  let image: map = pe_build_exe(
    cb_get_buf(cb), cb_get_pos(cb), 0,
    cb_get_iat_fixups(cb), ib_to_imports(ib),
    nil, 0, [],
    nil, 0, []);

  createDirsInPath(exe_path);
  bufSave(image, exe_path);
  ExitCode = runPE(exe_path);

}
