addImportPath("$P:res/backend/x86_64");
import "x86_64.lvm";

routine main() {
  let cb: any = cb_create(256);

  // Emit sub rsp, 0x28 (4 bytes)
  cb_emit_sub_rsp_imm8(cb, 0x28);
  let _p1: int = cb_get_pos(cb);
  println("p1=" + toString(_p1));

  // Emit ret (1 byte)
  cb_emit_ret(cb);
  let _p2: int = cb_get_pos(cb);
  println("p2=" + toString(_p2));

  // Test IAT fixup tracking
  cb_add_fixup_iat(cb, 10, 0);
  cb_add_fixup_iat(cb, 20, 1);
  let fixups: any = cb_get_iat_fixups(cb);
  println("nfix=" + toString(len(fixups)));
  println("fx0=" + toString(fixups[0][0]) + "," + toString(fixups[0][1]));
  println("fx1=" + toString(fixups[1][0]) + "," + toString(fixups[1][1]));

  // Test data fixup tracking
  cb_add_fixup_data(cb, 30, 2);
  let dfix: any = cb_get_data_fixups(cb);
  println("ndfix=" + toString(len(dfix)));
  Result = {"p1": _p1, "p2": _p2, "nfix": len(fixups), "fx0": toString(fixups[0][0]) + "," + toString(fixups[0][1]), "fx1": toString(fixups[1][0]) + "," + toString(fixups[1][1]), "ndfix": len(dfix)};
}
