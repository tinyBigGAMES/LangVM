addImportPath("$P:res/backend/x86_64");
import "x86_64.lvm";

routine main() {
  let code: buffer = buffer(64);
  let off: int = 0;

  // mov eax, 42 (B8 2A000000)
  bufWriteU8(code, off, 0xB8);
  bufWriteU32(code, off + 1, 42);
  off = off + 5;

  // ret (C3)
  bufWriteU8(code, off, 0xC3);
  off = off + 1;

  // Build ELF -- no imports, entry at offset 0
  let image: map = elf_build_exe(code, off, 0, [], [], nil, 0, [],
                            nil, 0, 0, []);

  // Save to disk and run
  createDirsInPath(elf_path + ".tmp");
  bufSave(image, elf_path);
  ExitCode = runELF(elf_path, pathDir(elf_path));

}
