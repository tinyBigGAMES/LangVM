addImportPath("$P:res/backend/x86_64");
import "x86_64.lvm";

routine main() {
  let code: buffer = buffer(64);
  let off: int = 0;

  // sub rsp, 0x28
  off = emit_sub_rsp_imm8(code, off, 0x28);

  // mov ecx, 42 (B9 2A000000)
  bufWriteU8(code, off, 0xB9);
  bufWriteU32(code, off + 1, 42);
  off = off + 5;

  // call [rip+disp32] -- placeholder, fixup by pe_build_exe
  let call_off: any = off;
  bufWriteU8(code, off, 0xFF);
  bufWriteU8(code, off + 1, 0x15);
  bufWriteU32(code, off + 2, 0);
  off = off + 6;

  // int3 (safety)
  bufWriteU8(code, off, 0xCC);
  off = off + 1;

  // Build PE
  let fixups: list = [[call_off, 0]];
  let imports: list = [["kernel32.dll", ["ExitProcess"]]];
  let image: map = pe_build_exe(code, off, 0, fixups, imports, nil, 0, [],
                           nil, 0, []);

  // Save to disk
  createDirsInPath(exe_path);
  bufSave(image, exe_path);
  ExitCode = runPE(exe_path);

}
