addImportPath("$P:res/backend/x86_64");
import "x86_64.lvm";

routine main() {
  let buf: buffer = buffer(64, true);
  let off: int = 0;
  off = emit_mov_r64_imm64(buf, off, REG_RAX, 77);
  off = emit_ret(buf, off);
  bufFlush(buf);
  let load_result: int = bufCall(buf, 0);
  println(toString(load_result));
  Result = load_result;
}
