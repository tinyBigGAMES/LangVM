language MirDispatchTest version "1.0";

mir {
  on module {
    print("MODULE: " + name);
  }

  on func {
    print("FUNC: " + name);
  }

  on insn {
    print("INSN: " + opcode);
  }

  on label {
    print("LABEL: " + name);
  }

  on proto {
    print("PROTO: " + name);
  }

  on endfunc {
    print("ENDFUNC: " + name);
  }

  on endmodule {
    print("ENDMODULE: " + name);
  }
}

routine main() {
  // Build MIR program via builtins
  mirBeginModule("test_mod");
  mirImport("ExitProcess");
  mirProto("p_exit", ["void"], ["i32:code"]);
  mirBeginFunc("main", ["void"], ["i32:argc"]);
  mirLocal("tmp", "i64");
  mirLabel("L0");
  mirInsn("mov", "tmp", "argc");
  mirInsn("call", "p_exit", "ExitProcess", "_", "argc");
  mirEndFunc();
  mirEndModule();

  runMir();
}
