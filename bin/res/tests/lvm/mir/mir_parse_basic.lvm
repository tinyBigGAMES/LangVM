language MirTest version "1.0";

mir {
}

routine main() {
  // Build MIR program via builtins
  mirBeginModule("m0");
  mirImport("printf");
  mirExport("main");
  mirProto("p_printf", ["void"], ["p:fmt"]);
  mirString("msg", "Hello MIR!\n");
  mirData("count", "i32", [0, 1, 2, 3]);
  mirBeginFunc("main", ["i64"], []);
  mirLocal("n", "i64");
  mirInsn("mov", "n", 0);
  mirInsn("add", "n", "n", 1);
  mirInsn("ret", "n");
  mirEndFunc();
  mirEndModule();

  runMir();
}
