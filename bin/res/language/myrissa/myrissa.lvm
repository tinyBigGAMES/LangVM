 myrissa.lvm -- Root language definition for Myrissa native backend

 Modular split:
   myrissa_tokens.lvm     Token declarations and type system
   myrissa_helpers.lvm    Shared routines (target, type resolution, etc.)
   myrissa_grammar.lvm    All grammar rules (prefix, infix, statement)
   myrissa_semantics.lvm  Semantic analysis handlers
   myrissa_emitters.lvm   Code generation using MIR builtins
   runtime.lvm            Language-specific runtime support
*******************************************************************************/

// Language declaration
language Myrissa version "1.0";

// Language options
const {
  ENABLE_OVERLOADS = true;
  ENABLE_FORWARD_REFS = true;
}

// Defines
setDefine("MYRISSA");

// Source file extension
setModuleExtension("myr");

// Standard library module path
addModulePath("$P:res/libs/std");
addModulePath("$P:res/libs/std/c");

// Backend import paths
addImportPath("$P:res/backend/cpp23");

// Language implementation
import "helpers.lvm";
import "tokens.lvm";
import "grammar.lvm";
import "semantics.lvm";
import "cpp23.lvm";

// Register module paths with cpp23 backend for import resolution
cpp_add_module_path("$P:res/libs/std");
cpp_add_module_path("$P:res/libs/std/c");

// Entry point
routine main() {
  if SourceFilename == "" {
    println("Myrissa Programming Language");
    return;
  }

  // Full compilation pipeline -- all MIR built by emitters, not here
  SourceFilename = pathChangeExt(SourceFilename, getModuleExtension());
  let srcFile: string = pathChangeExt(pathFile(SourceFilename), getModuleExtension());

  status("Tokenizing ", srcFile, "...");
  let source: string = loadTextFile(SourceFilename);
  let toks: any = lexSource(source, SourceFilename);
  if hasErrors() { return; }

  status("Parsing ", srcFile, "...");
  let ast: any = parseProgram(toks, SourceFilename);
  if hasErrors() { return; }

  status("Analyzing ", srcFile, "...");
  runSemantics(ast);
  if hasErrors() { return; }

  // Enable debug line directives for debug builds
  let optLvl: string = "";
  if hasShared("cpp_optimize") {
    optLvl = getShared("cpp_optimize");
  }
  if optLvl == "" or optLvl == "debug" {
    cpp_set_line_directives(true);
  }

  status("Emitting ", srcFile, "...");
  runEmitters(ast);
  if hasErrors() { return; }

  // Write generated C++ to output folder
  let outDir: string = cpp_get_output_path() + "/generated";
  createDirsInPath(outDir);
  let hFile: string = outDir + "/" + pathChangeExt(pathFile(SourceFilename), ".h");
  let cppFile: string = outDir + "/" + pathChangeExt(pathFile(SourceFilename), ".cpp");
  status("Writing ", resolvePath(cppFile), "...");
  saveTextFile(hFile, cpp_get_header(), false);
  saveTextFile(cppFile, cpp_get_source(), false);

  // Compile with zig c++
  // Apply CLI overrides (well-known vars override @directives from source)
  if Target != "" {
    cpp_set_target(Target);
  }
  if OutputPath != "" {
    cpp_set_output_path(OutputPath);
  }
  if Subsystem != "" {
    setShared("cpp_subsystem", Subsystem);
  }
  if OptimizeLevel != "" {
    setShared("cpp_optimize", OptimizeLevel);
  }
  // Unit modules only generate sources -- no build step
  let moduleKind: string = getShared("module_kind");
  if moduleKind == "unit" {
    status("Done (unit module -- sources generated, no build).");
    return;
  }

  // Build step for exe/dll/lib
  let projName: string = pathBaseName(SourceFilename);
  zbClear();
  zbSetOutputPath(resolvePath(cpp_get_output_path()));
  zbSetProjectName(projName);
  zbSetBuildMode(moduleKind);

  // Add imported module source files (stored during semantic pass)
  if hasShared("cpp_import_sources") {
    let impSrc: string = getShared("cpp_import_sources");
    if impSrc != "" {
      let impList: any = split(impSrc, "|");
      let ii: int = 0;
      while ii < len(impList) {
        zbAddSourceFile(impList[ii]);
        ii = ii + 1;
      }
    }
  }

  // Map Myrissa target to zig target triple
  let tgt: string = cpp_get_target();
  match tgt {
    "x86_64_windows" | "x86_64-windows" => {
      zbSetTarget("x86_64-windows-gnu");
    }
    "x86_64_linux" | "x86_64-linux" => {
      zbSetTarget("x86_64-linux-gnu");
    }
  }
  // Apply subsystem and optimize level
  if hasShared("cpp_subsystem") {
    zbSetSubsystem(getShared("cpp_subsystem"));
  }
  if hasShared("cpp_optimize") {
    zbSetOptimizeLevel(getShared("cpp_optimize"));
  }
  zbAddSourceFile(resolvePath(cppFile));
  zbAddSourceFile(resolvePath("$P:res/backend/cpp23/runtime/runtime.cpp"));
  zbAddIncludePath(resolvePath("$P:res/backend/cpp23/runtime"));
  zbAddIncludePath(resolvePath(outDir));
  status("Compiling ", srcFile, "...");
  let ok: bool = zbProcess(AutoRun);
  if ok == false {
    error "zig build failed with exit code " + toString(zbGetLastExitCode());
    return;
  }
  status("Done.");
}
