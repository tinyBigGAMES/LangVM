 -----------------------------------------------------------------------------
 myrissa_emitters.lvm -- Code generation and backend for Myrissa

 Emitters:
   stmt.module       Build MIR module from AST (imports, function, exit call)
   stmt.module_body  Build main function, emit body, add exit call

 Backend (mir{} on-handlers):
   on module          Initialize code/import builders
   on func            Emit function prologue
   on insn            Emit instructions (call)
   on endfunc         Emit function epilogue
   on endmodule       Build PE or ELF binary, save, run

 Source of truth: bin/res/language/myrissa/bnf.md
*******************************************************************************/

// Backend shared state -- declared here, accessible to mir{} handlers
// because runMir() is called from main() which runs in the same scope
// after these are initialized.
let g_ib: any = nil;
let g_cb: any = nil;
let g_db: any = nil;
let g_import_map: map = {};
let g_import_names: list = [];
let g_str_map: map = {};
let g_str_count: int = 0;

// ---------------------------------------------------------------------------
// Emitters -- walk AST, build MIR via mirXXX builtins
// ---------------------------------------------------------------------------

emitters {

  on stmt.module {
    let kind: string = getAttr(node, "module.kind");
    let mname: string = getAttr(node, "module.name");
    // Pre-scan for @target directive
    let ci: int = 0;
    let cn: int = childCount(node);
    while ci < cn {
      let ch: any = getChild(node, ci);
      if nodeKind(ch) == "stmt.directive_target" {
        applyTarget(ch);
      }
      ci = ci + 1;
    }

    // Import platform runtime based on target
    match getTarget() {
      Win64 => {
        import "win_runtime.lvm";
      }
      Linux64 => {
        import "linux_runtime.lvm";
      }
    }

    // Begin MIR module
    mirBeginModule(mname);

    // Emit platform imports via runtime
    RT_EmitImports();

    // Dispatch to child handlers (stmt.module_body, etc.)
    visit children;

    mirEndModule();
  }

  on stmt.module_body {
    let kind: string = getAttr(node, "module.kind");
    if kind == "exe" {
      mirBeginFunc("main", ["void"], []);
      visit children;
      RT_Halt(0);
      mirEndFunc();
    }
  }

  on stmt.println {
    let wi: int = 0;
    let wn: int = childCount(node);
    while wi < wn {
      let argNode: any = getChild(node, wi);
      let argKind: string = nodeKind(argNode);
      if argKind == "expr.cstring" {
        let text: string = getAttr(argNode, "value");
        let str_name: string = "__str_" + intToStr(g_str_count);
        mirString(str_name, text);
        g_str_count = g_str_count + 1;
        rt_write(str_name);
      }
      wi = wi + 1;
    }
    // Emit newline
    let nl_name: string = "__str_" + intToStr(g_str_count);
    mirString(nl_name, "\n");
    g_str_count = g_str_count + 1;
    rt_write(nl_name);
  }

  on stmt.print {
    let wi: int = 0;
    let wn: int = childCount(node);
    while wi < wn {
      let argNode: any = getChild(node, wi);
      let argKind: string = nodeKind(argNode);
      if argKind == "expr.cstring" {
        let text: string = getAttr(argNode, "value");
        let str_name: string = "__str_" + intToStr(g_str_count);
        mirString(str_name, text);
        g_str_count = g_str_count + 1;
        rt_write(str_name);
      }
      wi = wi + 1;
    }
  }
}

// ---------------------------------------------------------------------------
// Backend -- mir{} on-handlers lower MIR events to native machine code
// ---------------------------------------------------------------------------

mir {

  on module {
    match getTarget() {
      Win64 => {
        // Win64: use import builder for PE IAT
        g_ib = ib_create();
        g_import_map = {};
        let i: int = 0;
        while i < len(imports) {
          let dll: string = RT_GetDll(imports[i]);
          let idx: int = ib_add(g_ib, dll, imports[i]);
          g_import_map[imports[i]] = idx;
          i = i + 1;
        }
      }
      Linux64 => {
        // Linux64: build flat import map for GOT indices
        g_import_map = {};
        let i: int = 0;
        while i < len(imports) {
          g_import_map[imports[i]] = i;
          i = i + 1;
        }
      }
    }
    g_cb = cb_create(256);
    g_db = db_create();
    g_import_names = imports;
  }

  on string {
    let h: int = db_add_string(g_db, value);
    g_str_map[name] = h;
  }

  on func {
    match getTarget() {
      Win64 => {
        // Win64 prologue: sub rsp, 0x28 (shadow space + alignment)
        cb_emit_sub_rsp_imm8(g_cb, 0x28);
      }
      Linux64 => {
        // SysV prologue: sub rsp, 0x08 (alignment)
        cb_emit_sub_rsp_imm8(g_cb, 0x08);
      }
    }
  }

  on insn {
    if opcode == "call" {
      // operands: [proto, func_name, result, args...]
      let func_name: string = operands[1];

      // Select ABI register order
      let int_regs: list = [];
      match getTarget() {
        Win64 => {
          int_regs = [REG_RCX, REG_RDX, REG_R8, REG_R9];
        }
        Linux64 => {
          int_regs = [REG_RDI, REG_RSI, REG_RDX, REG_RCX, REG_R8, REG_R9];
        }
      }

      // Load arguments into registers
      let arg_idx: int = 0;
      let ai: int = 3;
      while ai < len(operands) {
        let val: any = operands[ai];
        if isInt(val) {
          cb_emit_mov_r64_imm64(g_cb, int_regs[arg_idx], val);
        } else if isString(val) {
          if val != "_" {
            // String ref -- LEA reg, [rip+disp32] for rdata
            let data_idx: int = g_str_map[val];
            let data_off: int = db_get_offset(g_db, data_idx);
            let lea_off: int = cb_get_pos(g_cb);
            cb_emit_lea_rip_disp32(g_cb, int_regs[arg_idx]);
            cb_add_fixup_data(g_cb, lea_off, data_off);
          }
        }
        arg_idx = arg_idx + 1;
        ai = ai + 1;
      }

      // Emit call [rip+disp32] via IAT/GOT
      let func_idx: int = g_import_map[func_name];
      let call_off: int = cb_emit_call_rip_disp32(g_cb);
      cb_add_fixup_iat(g_cb, call_off, func_idx);
    }
  }

  on endfunc {
    match getTarget() {
      Win64 => {
        cb_emit_add_rsp_imm8(g_cb, 0x28);
      }
      Linux64 => {
        cb_emit_add_rsp_imm8(g_cb, 0x08);
      }
    }
    cb_emit_ret(g_cb);
  }

  on endmodule {
    let mname: string = name;

    match getTarget() {
      Win64 => {
        let exe_path: string = "$P:output/" + mname + ".exe";
        let image: map = pe_build_exe(
          cb_get_buf(g_cb), cb_get_pos(g_cb), 0,
          cb_get_iat_fixups(g_cb), ib_to_imports(g_ib),
          db_get_buf(g_db), db_get_size(g_db), cb_get_data_fixups(g_cb),
          nil, 0, []);
        createDirsInPath(exe_path);
        bufSave(image, exe_path);
        status("Created ", resolvePath(exe_path));
        if AutoRun {
          ExitCode = runPE(exe_path);
        }
      }
      Linux64 => {
        let elf_path: string = "$P:output/" + mname;
        let elf_imports: list = [["libc.so.6", g_import_names]];
        let image: map = elf_build_exe(
          cb_get_buf(g_cb), cb_get_pos(g_cb), 0,
          cb_get_iat_fixups(g_cb), elf_imports,
          db_get_buf(g_db), db_get_size(g_db), cb_get_data_fixups(g_cb),
          nil, 0, 0, []);
        createDirsInPath(elf_path);
        bufSave(image, elf_path);
        status("Created ", resolvePath(elf_path));
        if AutoRun {
          ExitCode = runELF(elf_path);
        }
      }
    }
  }
}
