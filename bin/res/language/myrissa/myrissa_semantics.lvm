 myrissa_semantics.lvm -- Semantic analysis for Myrissa

 Handlers:
   program.root      Global scope wrapper
   stmt.module       Set build mode, open module scope
   stmt.module_body  Visit children

 Source of truth: bin/res/language/myrissa/bnf.md
*******************************************************************************/

semantics {

  on program.root {
    scope "global" {
      visit children;
    }
  }

  on stmt.module {
    let mname: string = getAttr(node, "module.name");
    setAttr(node, "mname", mname);
    scope @mname {
      visit children;
    }
  }

  on stmt.module_body { visit children; }
  on stmt.println     { visit children; }
  on stmt.print       { visit children; }
}
