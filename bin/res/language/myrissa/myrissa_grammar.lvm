 -----------------------------------------------------------------------------
 myrissa_grammar.lvm -- Grammar rules for Myrissa

 Rules:
   stmt.module   Module header, optional directives, body, terminator
   stmt.println  println(expr, ...)
   stmt.print    print(expr, ...)
   stmt.directive_target  @target <triple>;
   stmt.directive_outputpath  @outputpath "path";
   expr.cstring  C-string literal prefix rule

 Source of truth: bin/res/language/myrissa/bnf.md
*******************************************************************************/

grammar {

  // Module = "module" ModuleKind ident ";" [Directives]
  //          "begin" StatementSeq "end" "."
  rule stmt.module {
    expect keyword.module;
    let nd: handle = getResultNode();

    // Module kind: exe, dll, lib, unit
    setAttr(nd, "module.kind", currentText());
    advance();

    // Module name
    setAttr(nd, "module.name", currentText());
    advance();
    requireToken("delimiter.semicolon");

    // Optional directives
    while startsWith(currentKind(), "directive.") {
      addChild(nd, parseStmt());
    }

    // Module body: begin StatementSeq end .
    if matchToken("keyword.begin") {
      let body: handle = createNode("stmt.module_body");
      setAttr(body, "module.kind", getAttr(nd, "module.kind"));
      while not checkToken("keyword.end") and not checkToken("eof") {
        let s: any = parseStmt();
        if s != nil { addChild(body, s); }
      }
      addChild(nd, body);
    }

    requireToken("keyword.end");
    requireToken("delimiter.dot");
  }

  // -----------------------------------------------------------------------
  // PREFIX EXPRESSION RULES
  // -----------------------------------------------------------------------

  // C-string literal: "..."
  rule expr.cstring {
    let text: string = currentText();
    expect string.cstring;
    let nd: handle = getResultNode();
    setAttr(nd, "value", text);
  }

  // Integer literal: 42, 0xFF, etc.
  rule expr.integer {
    let text: string = currentText();
    expect literal.integer;
    let nd: handle = getResultNode();
    setAttr(nd, "value", text);
  }

  // Float literal: 3.14, 1.0, etc.
  rule expr.float {
    let text: string = currentText();
    expect literal.float;
    let nd: handle = getResultNode();
    setAttr(nd, "value", text);
  }

  // -----------------------------------------------------------------------
  // STATEMENT RULES
  // -----------------------------------------------------------------------

  // println(expr, ...)
  rule stmt.println {
    expect keyword.println;
    let nd: handle = getResultNode();
    requireToken("delimiter.lparen");
    if not checkToken("delimiter.rparen") {
      addChild(nd, parseExpr(0));
      while matchToken("delimiter.comma") {
        addChild(nd, parseExpr(0));
      }
    }
    requireToken("delimiter.rparen");
    matchToken("delimiter.semicolon");
  }

  // print(expr, ...)
  rule stmt.print {
    expect keyword.print;
    let nd: handle = getResultNode();
    requireToken("delimiter.lparen");
    if not checkToken("delimiter.rparen") {
      addChild(nd, parseExpr(0));
      while matchToken("delimiter.comma") {
        addChild(nd, parseExpr(0));
      }
    }
    requireToken("delimiter.rparen");
    matchToken("delimiter.semicolon");
  }

  // @target <triple>;
  rule stmt.directive_target {
    expect directive.target;
    let nd: handle = getResultNode();
    setAttr(nd, "triple", currentText());
    advance();
    requireToken("delimiter.semicolon");
  }

  // @outputpath "path";
  rule stmt.directive_outputpath {
    expect directive.outputpath;
    let nd: handle = getResultNode();
    setAttr(nd, "value", currentText());
    advance();
    requireToken("delimiter.semicolon");
  }
}
