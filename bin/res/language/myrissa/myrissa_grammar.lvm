/*******************************************************************************
 LangVM - Language Virtual Machine

 Copyright (c) 2026-present tinyBigGAMES LLC
 All Rights Reserved.

 https://langvm.org

 See LICENSE for license information
 -----------------------------------------------------------------------------
 myrissa_grammar.lvm -- All grammar rules for Myrissa

 Prefix expression rules (BNF Section 12):
   expr.integer, expr.float, expr.cstring, expr.wstring, expr.nil,
   expr.bool, expr.ident, expr.self, expr.parent, expr.varargs,
   expr.not, expr.negate, expr.unary_plus, expr.address_of,
   expr.grouped, expr.set_literal, intrinsics as expr.call,
   expr.cstr, expr.wstr, expr.pointer_cast

 Infix expression rules (BNF Sections 12, 16):
   expr.assign, expr.binary (arithmetic, comparison, logical),
   expr.shl, expr.shr, expr.in, expr.is, expr.call, expr.array_index,
   expr.field_access, expr.deref

 Statement rules (BNF Sections 6-11):
   Directives, module (with initialize/finalize), var/const/type blocks,
   public, routines, methods, begin block, if, while, for, repeat,
   match, return, break, continue, guard, exceptions, memory management,
   I/O, testing

 Source of truth: bin/res/language/myrissa/bnf.md
*******************************************************************************/

grammar {

  // -----------------------------------------------------------------------
  // PREFIX EXPRESSION RULES (BNF Section 12: Primary, Factor)
  // -----------------------------------------------------------------------

  // Integer literal (decimal, or hex 0x/0X prefix)
  rule expr.integer {
    consume literal.integer -> @value;
    let nd: any = getResultNode();
    // Check for hex: if value is "0" and next token is identifier starting with x/X
    if getAttr(nd, "value") == "0" and checkToken("identifier") {
      let rest: any = currentText();
      if startsWith(rest, "x") or startsWith(rest, "X") {
        advance();
        setAttr(nd, "value", "0" + rest);
      }
    }
  }

  // Float literal -- optional 'f' suffix for float32
  rule expr.float {
    consume literal.float -> @value;
    let nd: any = getResultNode();
    if checkToken("identifier") and currentText() == "f" {
      advance();
      setAttr(nd, "literal.type", "float32");
    }
  }

  // C-string literal: "..."
  rule expr.cstring {
    consume string.cstring -> @value;
  }

  // Wide-string literal: w"..."
  rule expr.wstring {
    consume string.wstring -> @value;
  }

  // Nil literal
  rule expr.nil {
    expect keyword.nil;
  }

  // Boolean literals
  rule expr.bool {
    consume keyword.true -> @value;
  }
  rule expr.bool {
    consume keyword.false -> @value;
  }

  // Identifier (BNF: Designator starts with ident)
  rule expr.ident {
    consume identifier -> @name;
  }

  // Self / parent (BNF: Designator starts with "self" | "parent")
  rule expr.self {
    expect keyword.self;
  }
  rule expr.parent {
    expect keyword.parent;
  }

  // Pointer type cast: pointer(expr) or pointer to [const] TypeName(expr)
  rule expr.pointer_cast {
    expect keyword.pointer;
    let nd: any = getResultNode();
    if checkToken("delimiter.lparen") {
      // bare pointer cast: pointer(expr)
      advance();
      addChild(nd, parseExpr(0));
      requireToken("delimiter.rparen");
    } else {
      // typed pointer cast: pointer to [const] Type(expr)
      requireToken("keyword.to");
      if matchToken("keyword.const") {
        setAttr(nd, "const", "true");
      }
      setAttr(nd, "pointee_type", collectTypeText());
      requireToken("delimiter.lparen");
      addChild(nd, parseExpr(0));
      requireToken("delimiter.rparen");
    }
  }

  // Varargs access (BNF Section 14)
  rule expr.varargs {
    expect keyword.varargs;
    if matchToken("delimiter.dot") {
      let nd: any = getResultNode();
      let member: any = currentText();
      advance();
      if member == "count" {
        setAttr(nd, "varargs.access", "count");
      } else if member == "next" {
        setAttr(nd, "varargs.access", "next");
        requireToken("delimiter.lparen");
        setAttr(nd, "varargs.type", currentText());
        advance();
        requireToken("delimiter.rparen");
      } else if member == "get" {
        setAttr(nd, "varargs.access", "get");
        requireToken("delimiter.lparen");
        addChild(nd, parseExpr(0));
        requireToken("delimiter.comma");
        setAttr(nd, "varargs.type", currentText());
        advance();
        requireToken("delimiter.rparen");
      } else if member == "reset" {
        setAttr(nd, "varargs.access", "reset");
        requireToken("delimiter.lparen");
        requireToken("delimiter.rparen");
      } else if member == "copy" {
        setAttr(nd, "varargs.access", "copy");
        requireToken("delimiter.lparen");
        requireToken("delimiter.rparen");
      }
    }
  }

  // Unary operators (BNF: Factor = "not" Factor | "-" Factor | "+" Factor)
  // Binding power 35 (highest, BNF precedence level 1)
  rule expr.not {
    expect keyword.not;
    let nd: any = getResultNode();
    addChild(nd, parseExpr(35));
  }

  rule expr.negate {
    expect op.minus;
    let nd: any = getResultNode();
    addChild(nd, parseExpr(35));
  }

  rule expr.unary_plus {
    expect op.plus;
    let nd: any = getResultNode();
    addChild(nd, parseExpr(35));
  }

  // address of expr (BNF: "address" "of" Factor)
  rule expr.address_of {
    expect keyword.address;
    requireToken("keyword.of");
    let nd: any = getResultNode();
    addChild(nd, parseExpr(35));
  }

  // Grouped expression: (expr) (BNF: "(" Expression ")")
  rule expr.grouped {
    expect delimiter.lparen;
    parse expr -> @inner;
    expect delimiter.rparen;
  }

  // Set literal: [elem, elem..elem, ...] (BNF: SetLiteral)
  rule expr.set_literal {
    expect delimiter.lbracket;
    let nd: any = getResultNode();
    if not checkToken("delimiter.rbracket") {
      let elem: any = createNode("expr.set_element");
      addChild(elem, parseExpr(0));
      if matchToken("op.range") {
        addChild(elem, parseExpr(0));
      }
      addChild(nd, elem);
      while matchToken("delimiter.comma") {
        let elem2: any = createNode("expr.set_element");
        addChild(elem2, parseExpr(0));
        if matchToken("op.range") {
          addChild(elem2, parseExpr(0));
        }
        addChild(nd, elem2);
      }
    }
    requireToken("delimiter.rbracket");
  }

  // Intrinsics (BNF Section 13) -- all produce expr.call with call.name
  rule expr.call {
    expect keyword.len;
    let nd: any = getResultNode();
    setAttr(nd, "call.name", "myr_len");
    parseCallArgs(nd);
  }
  rule expr.call {
    expect keyword.size;
    let nd: any = getResultNode();
    setAttr(nd, "call.name", "sizeof");
    requireToken("delimiter.lparen");
    setAttr(nd, "call.sizeof_type", currentText());
    advance();
    requireToken("delimiter.rparen");
  }
  rule expr.call {
    expect keyword.utf8;
    let nd: any = getResultNode();
    setAttr(nd, "call.name", "myr_utf8");
    parseCallArgs(nd);
  }
  rule expr.call {
    expect keyword.paramcount;
    let nd: any = getResultNode();
    setAttr(nd, "call.name", "myr_paramcount");
    parseCallArgs(nd);
  }
  rule expr.call {
    expect keyword.paramstr;
    let nd: any = getResultNode();
    setAttr(nd, "call.name", "myr_paramstr");
    parseCallArgs(nd);
  }
  rule expr.call {
    expect keyword.getexceptioncode;
    let nd: any = getResultNode();
    setAttr(nd, "call.name", "myr_exc_code");
    parseCallArgs(nd);
  }
  rule expr.call {
    expect keyword.getexceptionmessage;
    let nd: any = getResultNode();
    setAttr(nd, "call.name", "myr_exc_msg");
    parseCallArgs(nd);
  }
  rule expr.call {
    expect keyword.getmem;
    let nd: any = getResultNode();
    setAttr(nd, "call.name", "myr_getmem");
    parseCallArgs(nd);
  }
  rule expr.call {
    expect keyword.resizemem;
    let nd: any = getResultNode();
    setAttr(nd, "call.name", "myr_resizemem");
    parseCallArgs(nd);
  }

  // cstr(expr) -- return borrowed raw UTF-8 char* (BNF Section 13)
  rule expr.cstr {
    expect keyword.cstr;
    let nd: any = getResultNode();
    requireToken("delimiter.lparen");
    addChild(nd, parseExpr(0));
    requireToken("delimiter.rparen");
  }

  // wstr(expr) -- return borrowed raw UTF-16 wchar* (BNF Section 13)
  rule expr.wstr {
    expect keyword.wstr;
    let nd: any = getResultNode();
    requireToken("delimiter.lparen");
    addChild(nd, parseExpr(0));
    requireToken("delimiter.rparen");
  }

  // -----------------------------------------------------------------------
  // INFIX EXPRESSION RULES (BNF Section 12, 16)
  // -----------------------------------------------------------------------

  // Assignment operators (right-associative, power 2)
  rule expr.assign precedence right 2 {
    consume [op.assign, op.plus_assign, op.minus_assign, op.mul_assign, op.div_assign] -> @operator;
    parse expr -> @right;
  }

  // BNF precedence level 3: AddOp = "+" | "-" | "or" | "xor"
  rule expr.binary precedence left 20 {
    consume [op.plus, op.minus] -> @operator;
    parse expr -> @right;
  }

  // BNF precedence level 2: MulOp = "*" | "/" | "div" | "mod" | "and" | "shl" | "shr"
  rule expr.binary precedence left 30 {
    consume [op.multiply, op.divide] -> @operator;
    parse expr -> @right;
  }
  rule expr.binary precedence left 30 {
    consume [keyword.div, keyword.mod] -> @operator;
    parse expr -> @right;
  }
  rule expr.binary precedence left 30 {
    consume keyword.and -> @operator;
    parse expr -> @right;
  }

  // BNF precedence level 4 (lowest): RelOp = "=" | "<>" | "<" | ">" | "<=" | ">=" | "in"
  rule expr.binary precedence left 10 {
    consume [op.eq, op.neq, op.lt, op.gt, op.lte, op.gte] -> @operator;
    parse expr -> @right;
  }

  // or / xor at level 3 (same as + -)
  rule expr.binary precedence left 20 {
    expect keyword.or;
    let nd: any = getResultNode();
    setAttr(nd, "operator", "or");
    addChild(nd, parseExpr(20));
  }
  rule expr.binary precedence left 20 {
    consume keyword.xor -> @operator;
    parse expr -> @right;
  }

  // shl / shr at level 2 (same as * /)
  rule expr.shl precedence left 30 {
    expect keyword.shl;
    parse expr -> @right;
  }
  rule expr.shr precedence left 30 {
    expect keyword.shr;
    parse expr -> @right;
  }

  // in at level 4 (same as comparison)
  rule expr.in precedence left 10 {
    expect keyword.in;
    parse expr -> @right;
  }

  // is at level 4 (type test operator)
  rule expr.is precedence left 10 {
    expect keyword.is;
    let nd: any = getResultNode();
    setAttr(nd, "is.type", collectTypeText());
  }

  // Function call or record literal: expr(args) or Type(field: val, ...)
  rule expr.call precedence left 40 {
    expect delimiter.lparen;
    let nd: any = getResultNode();
    let left: any = getChild(nd, 0);
    let leftKind: any = nodeKind(left);

    // Disambiguate: if current token is ident and next is ":", it's a record literal
    if checkToken("identifier") and peekKind() == "delimiter.colon" {
      setAttr(nd, "record_literal", "true");
      // Type name comes from the left expression (child 0)
      if leftKind == "expr.ident" {
        setAttr(nd, "record_type", getAttr(left, "name"));
      }
      // First field: ident ":" expr
      let fieldNode: any = createNode("expr.field_init");
      setAttr(fieldNode, "field.name", currentText());
      advance();
      requireToken("delimiter.colon");
      addChild(fieldNode, parseExpr(0));
      addChild(nd, fieldNode);
      // Remaining fields: { "," ident ":" expr }
      while matchToken("delimiter.comma") {
        let fn2: any = createNode("expr.field_init");
        setAttr(fn2, "field.name", currentText());
        advance();
        requireToken("delimiter.colon");
        addChild(fn2, parseExpr(0));
        addChild(nd, fn2);
      }
      requireToken("delimiter.rparen");
    } else {
      // Normal function call
      if leftKind == "expr.ident" {
        setAttr(nd, "call.name", getAttr(left, "name"));
      }
      if not checkToken("delimiter.rparen") {
        addChild(nd, parseExpr(0));
        while matchToken("delimiter.comma") {
          addChild(nd, parseExpr(0));
        }
      }
      requireToken("delimiter.rparen");
    }
  }

  // Array index: expr[expr] (BNF: Selector = "[" Expression "]")
  rule expr.array_index precedence left 45 {
    expect delimiter.lbracket;
    let nd: any = getResultNode();
    addChild(nd, parseExpr(0));
    requireToken("delimiter.rbracket");
  }

  // Field access: expr.ident (BNF: Selector = "." ident)
  rule expr.field_access precedence left 45 {
    expect delimiter.dot;
    let nd: any = getResultNode();
    setAttr(nd, "field.name", currentText());
    advance();
  }

  // Pointer dereference: expr^ (BNF: Selector = "^")
  rule expr.deref precedence left 50 {
    expect op.deref;
  }

  // -----------------------------------------------------------------------
  // STATEMENT RULES (BNF Sections 6-11)
  // -----------------------------------------------------------------------

  // --- Directives (BNF Section 7) ---

  rule stmt.directive_optimize {
    expect directive.optimize;
    consume identifier -> @value;
    requireToken("delimiter.semicolon");
  }
  rule stmt.directive_subsystem {
    expect directive.subsystem;
    consume identifier -> @value;
    requireToken("delimiter.semicolon");
  }
  rule stmt.directive_target {
    expect directive.target;
    let nd: any = getResultNode();
    if checkToken("string.cstring") and peekKind() == "delimiter.semicolon" {
      setAttr(nd, "triple", currentText());
      advance();
    } else if checkToken("identifier") and peekKind() == "delimiter.semicolon" {
      setAttr(nd, "triple", currentText());
      advance();
    } else {
      setAttr(nd, "arch", targetComponent());
      requireToken("delimiter.comma");
      setAttr(nd, "os", targetComponent());
      if matchToken("delimiter.comma") {
        setAttr(nd, "abi", targetComponent());
      }
    }
    requireToken("delimiter.semicolon");
  }
  rule stmt.directive_addverinfo {
    expect directive.addverinfo;
    consume identifier -> @value;
    requireToken("delimiter.semicolon");
  }
  rule stmt.directive_vimajor {
    expect directive.vimajor;
    consume literal.integer -> @value;
    requireToken("delimiter.semicolon");
  }
  rule stmt.directive_viminor {
    expect directive.viminor;
    consume literal.integer -> @value;
    requireToken("delimiter.semicolon");
  }
  rule stmt.directive_vipatch {
    expect directive.vipatch;
    consume literal.integer -> @value;
    requireToken("delimiter.semicolon");
  }
  rule stmt.directive_viproductname {
    expect directive.viproductname;
    consume string.cstring -> @value;
    requireToken("delimiter.semicolon");
  }
  rule stmt.directive_videscription {
    expect directive.videscription;
    consume string.cstring -> @value;
    requireToken("delimiter.semicolon");
  }
  rule stmt.directive_vifilename {
    expect directive.vifilename;
    consume string.cstring -> @value;
    requireToken("delimiter.semicolon");
  }
  rule stmt.directive_vicompanyname {
    expect directive.vicompanyname;
    consume string.cstring -> @value;
    requireToken("delimiter.semicolon");
  }
  rule stmt.directive_vicopyright {
    expect directive.vicopyright;
    consume string.cstring -> @value;
    requireToken("delimiter.semicolon");
  }
  rule stmt.directive_exeicon {
    expect directive.exeicon;
    consume string.cstring -> @value;
    requireToken("delimiter.semicolon");
  }
  rule stmt.directive_copydll {
    expect directive.copydll;
    consume string.cstring -> @value;
    requireToken("delimiter.semicolon");
  }
  rule stmt.directive_linklibrary {
    expect directive.linklibrary;
    consume string.cstring -> @value;
    requireToken("delimiter.semicolon");
  }
  rule stmt.directive_libpath {
    expect directive.libpath;
    consume string.cstring -> @value;
    requireToken("delimiter.semicolon");
  }
  rule stmt.directive_outputpath {
    expect directive.outputpath;
    consume string.cstring -> @value;
    requireToken("delimiter.semicolon");
  }
  rule stmt.directive_modulepath {
    expect directive.modulepath;
    consume string.cstring -> @value;
    requireToken("delimiter.semicolon");
  }
  rule stmt.directive_includepath {
    expect directive.includepath;
    consume string.cstring -> @value;
    requireToken("delimiter.semicolon");
  }
  rule stmt.directive_breakpoint {
    expect directive.breakpoint;
    requireToken("delimiter.semicolon");
  }
  rule stmt.directive_message {
    expect directive.message;
    consume identifier -> @severity;
    consume string.cstring -> @value;
    requireToken("delimiter.semicolon");
  }
  rule stmt.directive_unittestmode {
    expect directive.unittestmode;
    consume identifier -> @value;
    requireToken("delimiter.semicolon");
  }

  // --- Module (BNF Section 6) ---
  // Module = "module" ModuleKind ident ";" [Directives] [ImportClause]
  //          {Declaration}
  //          ["initialize" StatementSeq "end" ";"]
  //          ["finalize" StatementSeq "end" ";"]
  //          ["begin" StatementSeq] "end" "."
  //          {TestBlock}
  rule stmt.module {
    expect keyword.module;
    let nd: any = getResultNode();
    // Module kind: exe, dll, lib, unit
    setAttr(nd, "module.kind", currentText());
    advance();
    // Module name
    setAttr(nd, "module.name", currentText());
    advance();
    requireToken("delimiter.semicolon");

    // Optional directives
    while startsWith(currentKind(), "directive.") {
      addChild(nd, parseStmt());
    }

    // Optional import clause
    if matchToken("keyword.import") {
      let imp: any = createNode("stmt.import_clause");
      let item: any = createNode("stmt.import_item");
      setAttr(item, "import.name", currentText());
      advance();
      addChild(imp, item);
      while matchToken("delimiter.comma") {
        let item2: any = createNode("stmt.import_item");
        setAttr(item2, "import.name", currentText());
        advance();
        addChild(imp, item2);
      }
      requireToken("delimiter.semicolon");
      addChild(nd, imp);
    }

    // Declarations
    while checkToken("keyword.const") or checkToken("keyword.type") or
          checkToken("keyword.var") or checkToken("keyword.routine") or
          checkToken("keyword.public") or
          startsWith(currentKind(), "directive.") {
      addChild(nd, parseStmt());
    }

    // Optional initialize block (BNF: ["initialize" StatementSeq "end" ";"])
    if matchToken("keyword.initialize") {
      let initBlock: any = createNode("stmt.initialize");
      while not checkToken("keyword.end") and not checkToken("eof") {
        let s: any = parseStmt();
        if s != nil { addChild(initBlock, s); }
      }
      requireToken("keyword.end");
      matchToken("delimiter.semicolon");
      addChild(nd, initBlock);
    }

    // Optional finalize block (BNF: ["finalize" StatementSeq "end" ";"])
    if matchToken("keyword.finalize") {
      let finBlock: any = createNode("stmt.finalize");
      while not checkToken("keyword.end") and not checkToken("eof") {
        let s: any = parseStmt();
        if s != nil { addChild(finBlock, s); }
      }
      requireToken("keyword.end");
      matchToken("delimiter.semicolon");
      addChild(nd, finBlock);
    }

    // Catch unrecognized tokens at module level
    if not checkToken("keyword.begin") and not checkToken("keyword.end") and not checkToken("eof") {
      error("Unexpected '" + currentText() + "' at module level; expected var, const, type, routine, public, initialize, finalize, begin, or end.");
    }

    // Module body: begin StatementSeq end .
    // For exe modules, begin is mandatory.
    if matchToken("keyword.begin") {
      let body: any = createNode("stmt.module_body");
      setAttr(body, "module.kind", getAttr(nd, "module.kind"));
      while not checkToken("keyword.end") and not checkToken("eof") {
        let s: any = parseStmt();
        if s != nil { addChild(body, s); }
      }
      addChild(nd, body);
    } else if getAttr(nd, "module.kind") == "exe" {
      error("Executable module requires a 'begin' block before 'end.'");
    }

    requireToken("keyword.end");
    requireToken("delimiter.dot");

    // Optional test blocks after end. (BNF: {TestBlock})
    while checkToken("keyword.test") {
      addChild(nd, parseStmt());
    }
  }

  // --- Declaration rules (BNF Section 8) ---

  // Var block: var { VarDecl }
  rule stmt.var_block {
    expect keyword.var;
    let nd: any = getResultNode();
    while checkToken("identifier") {
      let nameTok: any = currentText();
      advance();
      let v: any = createNode("stmt.var_decl");
      setAttr(v, "var.name", nameTok);
      requireToken("delimiter.colon");
      let typeRaw: any = collectTypeText();
      setAttr(v, "var.type_text", typeRaw);
      if matchToken("op.eq") {
        addChild(v, parseExpr(0));
      }
      requireToken("delimiter.semicolon");
      if matchToken("keyword.external") {
        setAttr(v, "var.external", "true");
        if checkToken("string.cstring") or checkToken("identifier") {
          setAttr(v, "var.external_name", currentText());
          advance();
        }
        requireToken("delimiter.semicolon");
      }
      addChild(nd, v);
    }
  }

  // Const block: const { ConstDecl }
  rule stmt.const_block {
    expect keyword.const;
    let nd: any = getResultNode();
    while checkToken("identifier") {
      let nameTok: any = currentText();
      advance();
      let c: any = createNode("stmt.const_decl");
      setAttr(c, "const.name", nameTok);
      if matchToken("delimiter.colon") {
        setAttr(c, "const.type_text", collectTypeText());
      }
      requireToken("op.eq");
      addChild(c, parseExpr(0));
      requireToken("delimiter.semicolon");
      addChild(nd, c);
    }
  }

  // Type block: type { TypeDecl } (BNF Section 10)
  rule stmt.type_block {
    expect keyword.type;
    let nd: any = getResultNode();
    while checkToken("identifier") {
      let nameTok: any = currentText();
      advance();
      requireToken("op.eq");
      let decl: any = createNode("stmt.type_decl");
      setAttr(decl, "decl.name", nameTok);

      if checkToken("keyword.record") {
        advance();
        setAttr(decl, "type.kind", "record");
        if matchToken("keyword.packed") {
          setAttr(decl, "type.packed", "true");
        }
        if matchToken("keyword.align") {
          requireToken("delimiter.lparen");
          setAttr(decl, "type.align", currentText());
          advance();
          requireToken("delimiter.rparen");
        }
        if matchToken("delimiter.lparen") {
          setAttr(decl, "type.parent", currentText());
          advance();
          requireToken("delimiter.rparen");
        }
        while not checkToken("keyword.end") and not checkToken("eof") {
          if checkToken("keyword.overlay") {
            advance();
            let ao: any = createNode("stmt.anon_overlay");
            while not checkToken("keyword.end") and not checkToken("eof") {
              if checkToken("keyword.record") {
                advance();
                let ar: any = createNode("stmt.anon_record");
                if matchToken("keyword.packed") {
                  setAttr(ar, "type.packed", "true");
                }
                while not checkToken("keyword.end") and not checkToken("eof") {
                  let arf: any = createNode("stmt.field_decl");
                  setAttr(arf, "field.name", currentText());
                  advance();
                  requireToken("delimiter.colon");
                  setAttr(arf, "field.type_text", collectTypeText());
                  if matchToken("delimiter.colon") {
                    setAttr(arf, "field.bitwidth", currentText());
                    advance();
                  }
                  requireToken("delimiter.semicolon");
                  addChild(ar, arf);
                }
                requireToken("keyword.end");
                requireToken("delimiter.semicolon");
                addChild(ao, ar);
              } else {
                let aof: any = createNode("stmt.field_decl");
                setAttr(aof, "field.name", currentText());
                advance();
                requireToken("delimiter.colon");
                setAttr(aof, "field.type_text", collectTypeText());
                requireToken("delimiter.semicolon");
                addChild(ao, aof);
              }
            }
            requireToken("keyword.end");
            requireToken("delimiter.semicolon");
            addChild(decl, ao);
          } else {
            let fn: any = createNode("stmt.field_decl");
            setAttr(fn, "field.name", currentText());
            advance();
            requireToken("delimiter.colon");
            setAttr(fn, "field.type_text", collectTypeText());
            if matchToken("delimiter.colon") {
              setAttr(fn, "field.bitwidth", currentText());
              advance();
            }
            requireToken("delimiter.semicolon");
            addChild(decl, fn);
          }
        }
        requireToken("keyword.end");
      } else if checkToken("keyword.class") {
        advance();
        setAttr(decl, "type.kind", "class");
        if matchToken("delimiter.lparen") {
          setAttr(decl, "type.parent", currentText());
          advance();
          requireToken("delimiter.rparen");
        }
        while not checkToken("keyword.end") and not checkToken("eof") {
          if checkToken("keyword.method") {
            addChild(decl, parseStmt());
          } else {
            let fn2: any = createNode("stmt.field_decl");
            setAttr(fn2, "field.name", currentText());
            advance();
            requireToken("delimiter.colon");
            setAttr(fn2, "field.type_text", collectTypeText());
            if matchToken("delimiter.colon") {
              setAttr(fn2, "field.bitwidth", currentText());
              advance();
            }
            requireToken("delimiter.semicolon");
            addChild(decl, fn2);
          }
        }
        requireToken("keyword.end");
      } else if checkToken("keyword.overlay") {
        advance();
        setAttr(decl, "type.kind", "overlay");
        while not checkToken("keyword.end") and not checkToken("eof") {
          if checkToken("keyword.record") {
            advance();
            let ar: any = createNode("stmt.anon_record");
            if matchToken("keyword.packed") {
              setAttr(ar, "type.packed", "true");
            }
            while not checkToken("keyword.end") and not checkToken("eof") {
              if checkToken("keyword.overlay") {
                advance();
                let ao: any = createNode("stmt.anon_overlay");
                while not checkToken("keyword.end") and not checkToken("eof") {
                  let aof: any = createNode("stmt.field_decl");
                  setAttr(aof, "field.name", currentText());
                  advance();
                  requireToken("delimiter.colon");
                  setAttr(aof, "field.type_text", collectTypeText());
                  requireToken("delimiter.semicolon");
                  addChild(ao, aof);
                }
                requireToken("keyword.end");
                requireToken("delimiter.semicolon");
                addChild(ar, ao);
              } else {
                let arf: any = createNode("stmt.field_decl");
                setAttr(arf, "field.name", currentText());
                advance();
                requireToken("delimiter.colon");
                setAttr(arf, "field.type_text", collectTypeText());
                if matchToken("delimiter.colon") {
                  setAttr(arf, "field.bitwidth", currentText());
                  advance();
                }
                requireToken("delimiter.semicolon");
                addChild(ar, arf);
              }
            }
            requireToken("keyword.end");
            requireToken("delimiter.semicolon");
            addChild(decl, ar);
          } else {
            let fn3: any = createNode("stmt.field_decl");
            setAttr(fn3, "field.name", currentText());
            advance();
            requireToken("delimiter.colon");
            setAttr(fn3, "field.type_text", collectTypeText());
            requireToken("delimiter.semicolon");
            addChild(decl, fn3);
          }
        }
        requireToken("keyword.end");
      } else if checkToken("keyword.choices") {
        advance();
        setAttr(decl, "type.kind", "choices");
        requireToken("delimiter.lparen");
        let more: any = true;
        while more {
          let cv: any = createNode("stmt.choices_value");
          setAttr(cv, "choice.name", currentText());
          advance();
          if matchToken("op.eq") {
            addChild(cv, parseExpr(0));
          }
          addChild(decl, cv);
          if not matchToken("delimiter.comma") { more = false; }
        }
        requireToken("delimiter.rparen");
      } else if checkToken("keyword.array") {
        advance();
        setAttr(decl, "type.kind", "array");
        if matchToken("delimiter.lbracket") {
          if not checkToken("delimiter.rbracket") {
            setAttr(decl, "type.array_low", currentText());
            advance();
            requireToken("op.range");
            setAttr(decl, "type.array_high", currentText());
            advance();
          }
          requireToken("delimiter.rbracket");
        }
        requireToken("keyword.of");
        setAttr(decl, "type.elem_type", collectTypeText());
      } else if checkToken("keyword.pointer") {
        advance();
        setAttr(decl, "type.kind", "pointer");
        if matchToken("keyword.to") {
          if matchToken("keyword.const") {
            setAttr(decl, "type.pointer_const", "true");
          }
          setAttr(decl, "type.pointee", collectTypeText());
        }
      } else if checkToken("keyword.set") {
        advance();
        setAttr(decl, "type.kind", "set");
        if matchToken("keyword.of") {
          setAttr(decl, "type.elem_type", collectTypeText());
          if matchToken("op.range") {
            setAttr(decl, "type.set_range_low", getAttr(decl, "type.elem_type"));
            setAttr(decl, "type.set_range_high", currentText());
            advance();
          }
        }
      } else if checkToken("keyword.routine") {
        advance();
        setAttr(decl, "type.kind", "routine_type");
        setAttr(decl, "type.linkage", "clink");
        if checkToken("keyword.clink") {
          setAttr(decl, "type.linkage", "clink");
          advance();
        } else if checkToken("keyword.cpplink") {
          setAttr(decl, "type.linkage", "cpplink");
          advance();
        }
        requireToken("delimiter.lparen");
        if not checkToken("delimiter.rparen") {
          if checkToken("op.ellipsis") {
            setAttr(decl, "type.variadic", "true");
            advance();
          } else {
            let more: any = true;
            while more {
              let modifier: any = "";
              if matchToken("keyword.var") { modifier = "var"; }
              else if matchToken("keyword.const") { modifier = "const"; }
              let p: any = createNode("stmt.param_decl");
              setAttr(p, "param.modifier", modifier);
              setAttr(p, "param.name", currentText());
              advance();
              requireToken("delimiter.colon");
              setAttr(p, "param.type_text", collectTypeText());
              addChild(decl, p);
              if checkToken("op.ellipsis") {
                setAttr(decl, "type.variadic", "true");
                advance();
                more = false;
              } else if not matchToken("delimiter.semicolon") {
                more = false;
              }
            }
          }
        }
        requireToken("delimiter.rparen");
        if matchToken("delimiter.colon") {
          setAttr(decl, "type.return_type", collectTypeText());
        }
      } else {
        setAttr(decl, "type.kind", "alias");
        setAttr(decl, "type.alias_text", collectTypeText());
      }

      requireToken("delimiter.semicolon");
      addChild(nd, decl);
    }
  }

  // Public wrapper (BNF: Declaration = ["public"] (...))
  rule stmt.public {
    expect keyword.public;
    let nd: any = getResultNode();
    addChild(nd, parseStmt());
  }

  // --- Routine declaration (BNF Section 9) ---
  // Default linkage is clink (C convention). cpplink enables C++ mangling.
  rule stmt.routine_decl {
    expect keyword.routine;
    let nd: any = getResultNode();
    setAttr(nd, "decl.linkage", "clink");
    if checkToken("keyword.clink") {
      setAttr(nd, "decl.linkage", "clink");
      advance();
    } else if checkToken("keyword.cpplink") {
      setAttr(nd, "decl.linkage", "cpplink");
      advance();
    }
    setAttr(nd, "decl.name", currentText());
    advance();
    if matchToken("delimiter.lparen") {
      if not checkToken("delimiter.rparen") {
        if checkToken("op.ellipsis") {
          setAttr(nd, "decl.variadic", "true");
          advance();
        } else {
          let more: any = true;
          while more {
            let modifier: any = "";
            if matchToken("keyword.var") {
              modifier = "var";
            } else if matchToken("keyword.const") {
              modifier = "const";
            }
            let p: any = createNode("stmt.param_decl");
            setAttr(p, "param.modifier", modifier);
            setAttr(p, "param.name", currentText());
            advance();
            requireToken("delimiter.colon");
            setAttr(p, "param.type_text", collectTypeText());
            addChild(nd, p);
            if checkToken("op.ellipsis") {
              setAttr(nd, "decl.variadic", "true");
              advance();
              more = false;
            } else if matchToken("delimiter.semicolon") {
              if checkToken("op.ellipsis") {
                setAttr(nd, "decl.variadic", "true");
                advance();
                more = false;
              }
            } else {
              more = false;
            }
          }
        }
      }
      requireToken("delimiter.rparen");
    }
    if matchToken("delimiter.colon") {
      setAttr(nd, "decl.return_type", collectTypeText());
    }
    requireToken("delimiter.semicolon");
    if matchToken("keyword.external") {
      setAttr(nd, "decl.external", "true");
      if checkToken("string.cstring") or checkToken("identifier") {
        if checkToken("identifier") {
          setAttr(nd, "decl.external_is_ident", "true");
        }
        setAttr(nd, "decl.external_name", currentText());
        advance();
      }
      requireToken("delimiter.semicolon");
    } else {
      while checkToken("keyword.type") or checkToken("keyword.const") or checkToken("keyword.var") {
        addChild(nd, parseStmt());
      }
      addChild(nd, parseStmt());
      requireToken("delimiter.semicolon");
    }
  }

  // Method declaration (BNF: MethodDecl inside class types)
  rule stmt.method_decl {
    expect keyword.method;
    let nd: any = getResultNode();
    setAttr(nd, "decl.name", currentText());
    advance();
    if matchToken("delimiter.lparen") {
      if not checkToken("delimiter.rparen") {
        let more: any = true;
        while more {
          let modifier: any = "";
          if matchToken("keyword.var") { modifier = "var"; }
          else if matchToken("keyword.const") { modifier = "const"; }
          let p: any = createNode("stmt.param_decl");
          setAttr(p, "param.modifier", modifier);
          setAttr(p, "param.name", currentText());
          advance();
          requireToken("delimiter.colon");
          setAttr(p, "param.type_text", collectTypeText());
          addChild(nd, p);
          if not matchToken("delimiter.semicolon") { more = false; }
        }
      }
      requireToken("delimiter.rparen");
    }
    if matchToken("delimiter.colon") {
      setAttr(nd, "decl.return_type", collectTypeText());
    }
    requireToken("delimiter.semicolon");
    while checkToken("keyword.var") {
      addChild(nd, parseStmt());
    }
    addChild(nd, parseStmt());
    requireToken("delimiter.semicolon");
  }

  // --- Statement rules (BNF Section 11) ---

  // Begin block
  rule stmt.begin_block {
    expect keyword.begin;
    let nd: any = getResultNode();
    while not checkToken("keyword.end") and not checkToken("keyword.except") and
          not checkToken("keyword.finally") and not checkToken("eof") {
      let s: any = parseStmt();
      if s != nil { addChild(nd, s); }
    }
    requireToken("keyword.end");
  }

  // Expression-statement (identifier-led: assignment or call)
  rule stmt.expr {
    let nd: any = getResultNode();
    addChild(nd, parseExpr(0));
    matchToken("delimiter.semicolon");
  }

  // Self-led expression-statement
  rule stmt.self_expr {
    expect keyword.self;
    let nd: any = getResultNode();
    let selfNode: any = createNode("expr.self");
    addChild(nd, parseExprFrom(selfNode, 0));
    matchToken("delimiter.semicolon");
  }

  // Parent-led expression-statement
  rule stmt.parent_expr {
    expect keyword.parent;
    let nd: any = getResultNode();
    let parentNode: any = createNode("expr.parent");
    addChild(nd, parseExprFrom(parentNode, 0));
    matchToken("delimiter.semicolon");
  }

  // Varargs-led expression-statement (e.g. varargs.reset();)
  rule stmt.varargs_expr {
    expect keyword.varargs;
    let nd: any = getResultNode();
    let vaNode: any = createNode("expr.varargs");
    if matchToken("delimiter.dot") {
      let member: any = currentText();
      advance();
      if member == "count" {
        setAttr(vaNode, "varargs.access", "count");
      } else if member == "next" {
        setAttr(vaNode, "varargs.access", "next");
        requireToken("delimiter.lparen");
        setAttr(vaNode, "varargs.type", currentText());
        advance();
        requireToken("delimiter.rparen");
      } else if member == "get" {
        setAttr(vaNode, "varargs.access", "get");
        requireToken("delimiter.lparen");
        addChild(vaNode, parseExpr(0));
        requireToken("delimiter.comma");
        setAttr(vaNode, "varargs.type", currentText());
        advance();
        requireToken("delimiter.rparen");
      } else if member == "reset" {
        setAttr(vaNode, "varargs.access", "reset");
        requireToken("delimiter.lparen");
        requireToken("delimiter.rparen");
      } else if member == "copy" {
        setAttr(vaNode, "varargs.access", "copy");
        requireToken("delimiter.lparen");
        requireToken("delimiter.rparen");
      }
    }
    addChild(nd, vaNode);
    matchToken("delimiter.semicolon");
  }

  // If/then/else/end (BNF: IfStmt)
  rule stmt.if {
    expect keyword.if;
    let nd: any = getResultNode();
    addChild(nd, parseExpr(0));
    requireToken("keyword.then");
    let thenBranch: any = createNode("stmt.then_branch");
    while not checkToken("keyword.else") and not checkToken("keyword.end") and not checkToken("eof") {
      let s: any = parseStmt();
      if s != nil { addChild(thenBranch, s); }
    }
    addChild(nd, thenBranch);
    if matchToken("keyword.else") {
      let elseBranch: any = createNode("stmt.else_branch");
      while not checkToken("keyword.end") and not checkToken("eof") {
        let s: any = parseStmt();
        if s != nil { addChild(elseBranch, s); }
      }
      addChild(nd, elseBranch);
    }
    requireToken("keyword.end");
    matchToken("delimiter.semicolon");
  }

  // While/do/end (BNF: WhileStmt)
  rule stmt.while {
    expect keyword.while;
    let nd: any = getResultNode();
    addChild(nd, parseExpr(0));
    requireToken("keyword.do");
    while not checkToken("keyword.end") and not checkToken("eof") {
      let s: any = parseStmt();
      if s != nil { addChild(nd, s); }
    }
    requireToken("keyword.end");
    matchToken("delimiter.semicolon");
  }

  // For/to|downto/do/end (BNF: ForStmt)
  rule stmt.for {
    expect keyword.for;
    let nd: any = getResultNode();
    setAttr(nd, "for.var", currentText());
    advance();
    requireToken("op.assign");
    addChild(nd, parseExpr(0));
    if checkToken("keyword.to") {
      setAttr(nd, "for.dir", "to");
      advance();
    } else {
      requireToken("keyword.downto");
      setAttr(nd, "for.dir", "downto");
    }
    addChild(nd, parseExpr(0));
    requireToken("keyword.do");
    while not checkToken("keyword.end") and not checkToken("eof") {
      let s: any = parseStmt();
      if s != nil { addChild(nd, s); }
    }
    requireToken("keyword.end");
    matchToken("delimiter.semicolon");
  }

  // Repeat/until (BNF: RepeatStmt)
  rule stmt.repeat {
    expect keyword.repeat;
    let nd: any = getResultNode();
    while not checkToken("keyword.until") and not checkToken("eof") {
      let s: any = parseStmt();
      if s != nil { addChild(nd, s); }
    }
    requireToken("keyword.until");
    addChild(nd, parseExpr(0));
    matchToken("delimiter.semicolon");
  }

  // Match/of/end (BNF: MatchStmt)
  rule stmt.match {
    expect keyword.match;
    let nd: any = getResultNode();
    addChild(nd, parseExpr(0));
    requireToken("keyword.of");
    while not checkToken("keyword.else") and not checkToken("keyword.end") and not checkToken("eof") {
      let arm: any = createNode("stmt.match_arm");
      let lbl: any = createNode("stmt.match_label");
      addChild(lbl, parseExpr(0));
      if matchToken("op.range") {
        addChild(lbl, parseExpr(0));
      }
      addChild(arm, lbl);
      while matchToken("delimiter.comma") {
        let lbl2: any = createNode("stmt.match_label");
        addChild(lbl2, parseExpr(0));
        if matchToken("op.range") {
          addChild(lbl2, parseExpr(0));
        }
        addChild(arm, lbl2);
      }
      requireToken("delimiter.colon");
      while not checkToken("keyword.else") and not checkToken("keyword.end") and not checkToken("eof") {
        if peekKind() == "delimiter.colon" { break; }
        if peekKind() == "op.range" { break; }
        if peekKind() == "delimiter.comma" { break; }
        if currentKind() == "op.minus" {
          let pk2: any = peekKindAt(2);
          if pk2 == "op.range" or pk2 == "delimiter.colon" or pk2 == "delimiter.comma" { break; }
        }
        let s: any = parseStmt();
        if s != nil { addChild(arm, s); }
      }
      addChild(nd, arm);
    }
    if matchToken("keyword.else") {
      let elseBranch: any = createNode("stmt.match_else");
      while not checkToken("keyword.end") and not checkToken("eof") {
        let s: any = parseStmt();
        if s != nil { addChild(elseBranch, s); }
      }
      addChild(nd, elseBranch);
    }
    requireToken("keyword.end");
    matchToken("delimiter.semicolon");
  }

  // Return (BNF: ReturnStmt)
  rule stmt.return {
    expect keyword.return;
    let nd: any = getResultNode();
    if not checkToken("delimiter.semicolon") and not checkToken("keyword.end") and not checkToken("eof") {
      addChild(nd, parseExpr(0));
    }
    matchToken("delimiter.semicolon");
  }

  // Break (BNF: BreakStmt)
  rule stmt.break_ {
    expect keyword.break_;
    matchToken("delimiter.semicolon");
  }

  // Continue (BNF: ContinueStmt)
  rule stmt.continue_ {
    expect keyword.continue_;
    matchToken("delimiter.semicolon");
  }

  // Guard/except/finally/end (BNF: GuardStmt)
  rule stmt.guard {
    expect keyword.guard;
    let nd: any = getResultNode();
    let body: any = createNode("stmt.guard_body");
    while not checkToken("keyword.except") and not checkToken("keyword.finally") and not checkToken("eof") {
      let s: any = parseStmt();
      if s != nil { addChild(body, s); }
    }
    addChild(nd, body);
    if matchToken("keyword.except") {
      let exc: any = createNode("stmt.except_block");
      while not checkToken("keyword.finally") and not checkToken("keyword.end") and not checkToken("eof") {
        let s: any = parseStmt();
        if s != nil { addChild(exc, s); }
      }
      addChild(nd, exc);
      if matchToken("keyword.finally") {
        let fin: any = createNode("stmt.finally_block");
        while not checkToken("keyword.end") and not checkToken("eof") {
          let s: any = parseStmt();
          if s != nil { addChild(fin, s); }
        }
        addChild(nd, fin);
      }
    } else if matchToken("keyword.finally") {
      let fin2: any = createNode("stmt.finally_block");
      while not checkToken("keyword.end") and not checkToken("eof") {
        let s: any = parseStmt();
        if s != nil { addChild(fin2, s); }
      }
      addChild(nd, fin2);
    }
    requireToken("keyword.end");
    matchToken("delimiter.semicolon");
  }

  // Throw (BNF: RaiseStmt)
  rule stmt.throw_ {
    expect keyword.throw_;
    let nd: any = getResultNode();
    requireToken("delimiter.lparen");
    addChild(nd, parseExpr(0));
    requireToken("delimiter.rparen");
    matchToken("delimiter.semicolon");
  }
  rule stmt.throwcode {
    expect keyword.throwcode;
    let nd: any = getResultNode();
    requireToken("delimiter.lparen");
    addChild(nd, parseExpr(0));
    requireToken("delimiter.comma");
    addChild(nd, parseExpr(0));
    requireToken("delimiter.rparen");
    matchToken("delimiter.semicolon");
  }

  // Memory management (BNF Section 11)
  rule stmt.create {
    expect keyword.create;
    let nd: any = getResultNode();
    requireToken("delimiter.lparen");
    addChild(nd, parseExpr(0));
    requireToken("delimiter.rparen");
    matchToken("delimiter.semicolon");
  }
  rule stmt.destroy {
    expect keyword.destroy;
    let nd: any = getResultNode();
    requireToken("delimiter.lparen");
    addChild(nd, parseExpr(0));
    requireToken("delimiter.rparen");
    matchToken("delimiter.semicolon");
  }
  rule stmt.getmem {
    expect keyword.getmem;
    let nd: any = getResultNode();
    requireToken("delimiter.lparen");
    addChild(nd, parseExpr(0));
    requireToken("delimiter.rparen");
    matchToken("delimiter.semicolon");
  }
  rule stmt.freemem {
    expect keyword.freemem;
    let nd: any = getResultNode();
    requireToken("delimiter.lparen");
    addChild(nd, parseExpr(0));
    requireToken("delimiter.rparen");
    matchToken("delimiter.semicolon");
  }
  rule stmt.resizemem {
    expect keyword.resizemem;
    let nd: any = getResultNode();
    requireToken("delimiter.lparen");
    addChild(nd, parseExpr(0));
    requireToken("delimiter.comma");
    addChild(nd, parseExpr(0));
    requireToken("delimiter.rparen");
    matchToken("delimiter.semicolon");
  }
  rule stmt.setlength {
    expect keyword.setlength;
    let nd: any = getResultNode();
    requireToken("delimiter.lparen");
    addChild(nd, parseExpr(0));
    requireToken("delimiter.comma");
    addChild(nd, parseExpr(0));
    requireToken("delimiter.rparen");
    matchToken("delimiter.semicolon");
  }

  // println / print (BNF: PrintStmt)
  rule stmt.println {
    expect keyword.println;
    let nd: any = getResultNode();
    requireToken("delimiter.lparen");
    if not checkToken("delimiter.rparen") {
      addChild(nd, parseExpr(0));
      while matchToken("delimiter.comma") {
        addChild(nd, parseExpr(0));
      }
    }
    requireToken("delimiter.rparen");
    matchToken("delimiter.semicolon");
  }
  rule stmt.print {
    expect keyword.print;
    let nd: any = getResultNode();
    requireToken("delimiter.lparen");
    if not checkToken("delimiter.rparen") {
      addChild(nd, parseExpr(0));
      while matchToken("delimiter.comma") {
        addChild(nd, parseExpr(0));
      }
    }
    requireToken("delimiter.rparen");
    matchToken("delimiter.semicolon");
  }

  // --- Unit Testing (BNF Section 15) ---

  // Test block: test "name" [var ...] begin stmts end;
  rule stmt.test_block {
    expect keyword.test;
    let nd: any = getResultNode();
    consume string.cstring -> @testname;
    if checkToken("keyword.var") {
      addChild(nd, parseStmt());
    }
    requireToken("keyword.begin");
    while not checkToken("keyword.end") and not checkToken("eof") {
      let s: any = parseStmt();
      if s != nil { addChild(nd, s); }
    }
    requireToken("keyword.end");
    matchToken("delimiter.semicolon");
  }

  // Assert statements (BNF Section 11: AssertStmt)
  rule stmt.assert {
    expect keyword.assert;
    let nd: any = getResultNode();
    requireToken("delimiter.lparen");
    addChild(nd, parseExpr(0));
    requireToken("delimiter.rparen");
    matchToken("delimiter.semicolon");
  }
  rule stmt.asserttrue {
    expect keyword.asserttrue;
    let nd: any = getResultNode();
    requireToken("delimiter.lparen");
    addChild(nd, parseExpr(0));
    requireToken("delimiter.rparen");
    matchToken("delimiter.semicolon");
  }
  rule stmt.assertfalse {
    expect keyword.assertfalse;
    let nd: any = getResultNode();
    requireToken("delimiter.lparen");
    addChild(nd, parseExpr(0));
    requireToken("delimiter.rparen");
    matchToken("delimiter.semicolon");
  }
  rule stmt.assertnil {
    expect keyword.assertnil;
    let nd: any = getResultNode();
    requireToken("delimiter.lparen");
    addChild(nd, parseExpr(0));
    requireToken("delimiter.rparen");
    matchToken("delimiter.semicolon");
  }
  rule stmt.assertnotnil {
    expect keyword.assertnotnil;
    let nd: any = getResultNode();
    requireToken("delimiter.lparen");
    addChild(nd, parseExpr(0));
    requireToken("delimiter.rparen");
    matchToken("delimiter.semicolon");
  }
  rule stmt.assertfail {
    expect keyword.assertfail;
    let nd: any = getResultNode();
    requireToken("delimiter.lparen");
    addChild(nd, parseExpr(0));
    requireToken("delimiter.rparen");
    matchToken("delimiter.semicolon");
  }
  rule stmt.asserteq {
    expect keyword.asserteq;
    let nd: any = getResultNode();
    requireToken("delimiter.lparen");
    addChild(nd, parseExpr(0));
    requireToken("delimiter.comma");
    addChild(nd, parseExpr(0));
    requireToken("delimiter.rparen");
    matchToken("delimiter.semicolon");
  }
  rule stmt.asserteqf {
    expect keyword.asserteqf;
    let nd: any = getResultNode();
    requireToken("delimiter.lparen");
    addChild(nd, parseExpr(0));
    requireToken("delimiter.comma");
    addChild(nd, parseExpr(0));
    requireToken("delimiter.comma");
    addChild(nd, parseExpr(0));
    requireToken("delimiter.rparen");
    matchToken("delimiter.semicolon");
  }

} // end grammar
